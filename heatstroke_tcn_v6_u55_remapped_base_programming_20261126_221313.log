   157	
   158	void ethosu_dev_run_command_stream(struct ethosu_device *dev,
   159	                                   const uint8_t *cmd_stream_ptr,
   160	                                   uint32_t cms_length,
   161	                                   const uint64_t *base_addr,
   162	                                   int num_base_addr)
   163	{
   164	    assert(num_base_addr <= NPU_REG_BASEP_ARRLEN);
   165	
   166	    struct cmd_r cmd;
   167	    struct regioncfg_r rcfg = {0};
   168	    uint64_t qbase          = ethosu_address_remap((uintptr_t)cmd_stream_ptr, -1);
   169	    assert(qbase <= ADDRESS_MASK);
   170	    LOG_DEBUG("QBASE=0x%016llx, QSIZE=%" PRIu32 ", cmd_stream_ptr=%p", qbase, cms_length, cmd_stream_ptr);
   171	
   172	    dev->reg->QBASE.word[0] = qbase & 0xffffffff;
   173	#ifdef ETHOSU65
   174	    dev->reg->QBASE.word[1] = qbase >> 32;
   175	#endif
   176	    dev->reg->QSIZE.word   = cms_length;
   177	    dev->reg->QCONFIG.word = ethosu_config_select(qbase, -1);
   178	
   179	    for (int i = 0; i < num_base_addr; i++)
   180	    {
   181	        uint64_t addr = ethosu_address_remap(base_addr[i], i);
   182	        assert(addr <= ADDRESS_MASK);
   183	        LOG_DEBUG("BASEP%d=0x%016llx", i, addr);
   184	        dev->reg->BASEP[i].word[0] = addr & 0xffffffff;
   185	#ifdef ETHOSU65
   186	        dev->reg->BASEP[i].word[1] = addr >> 32;
   187	#endif
   188	        rcfg.word |= ethosu_config_select(addr, i) << (i * 2);
   189	    }
   190	
   191	    dev->reg->REGIONCFG.word = rcfg.word;
   192	
   193	    cmd.word                        = dev->reg->CMD.word & NPU_CMD_PWR_CLK_MASK;
   194	    cmd.transition_to_running_state = 1;
   195	
   196	    dev->reg->CMD.word = cmd.word;
   197	    LOG_DEBUG("CMD=0x%08" PRIx32, cmd.word);
   198	}
