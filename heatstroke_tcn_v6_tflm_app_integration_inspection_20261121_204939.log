    36	using namespace std;
    37	using namespace InferenceProcess;
    38	
    39	/****************************************************************************
    40	 * Defines
    41	 ****************************************************************************/
    42	
    43	/* Number of worker threads running the inferences. There should typically be
    44	 * one worker thread per NPU. */
    45	#ifndef NUM_INFERENCE_TASKS
    46	#define NUM_INFERENCE_TASKS 1
    47	#endif
    48	
    49	/* Number of sender tasks, that post inference requests to the worker threads. */
    50	#ifndef NUM_JOB_TASKS
    51	#define NUM_JOB_TASKS 2
    52	#endif
    53	
    54	/* Number of inferences per sender task. */
    55	#ifndef NUM_JOBS_PER_TASK
    56	#define NUM_JOBS_PER_TASK 2
    57	#endif
    58	
    59	/* Tensor arena size - use the model's tensorArenaSize variable */
    60	/* Note: tensorArenaSize is defined in the model header file */
    61	
    62	/****************************************************************************
    63	 * InferenceJob
    64	 ****************************************************************************/
    65	
    66	namespace
    67	{
    68	struct InferenceProcessParams {
    69		InferenceProcessParams() : tensorArena(nullptr), arenaSize(0)
    70		{
    71		}
    72	
    73		InferenceProcessParams(k_queue *_queue, uint8_t *_tensorArena, size_t _arenaSize)
    74			: queueHandle(_queue), tensorArena(_tensorArena), arenaSize(_arenaSize)
    75		{
    76		}
    77	
    78		k_queue *queueHandle;
    79		uint8_t *tensorArena;
    80		size_t arenaSize;
    81	};
    82	
    83	/* Wrapper around InferenceProcess::InferenceJob. Adds responseQueue and status
    84	 * for Zephyr multi-tasking purposes.& */
    85	struct xInferenceJob : public InferenceJob {
    86		xInferenceJob() : InferenceJob(), responseQueue(nullptr), status(false)
    87		{
    88		}
    89	
    90		xInferenceJob(const string &_name, const DataPtr &_networkModel,
    91			      const vector<DataPtr> &_input, const vector<DataPtr> &_output,
    92			      const vector<DataPtr> &_expectedOutput, k_queue *_queue)
    93			: InferenceJob(_name, _networkModel, _input, _output, _expectedOutput),
    94			  responseQueue(_queue), status(false)
    95		{
    96		}
    97	
    98		k_queue *responseQueue;
    99		bool status;
   100	};
   101	
   102	/* Number of total completed jobs, needed to exit application correctly if
   103	 * NUM_JOB_TASKS > 1 */
   104	volatile int totalCompletedJobs = 0;
   105	
   106	/* TensorArena allocation using TENSOR_ARENA_SIZE from model header
   107	 * Note: TENSOR_ARENA_SIZE macro is defined in model headers (e.g., model_u85_256.h)
   108	 * For keyword_spotting: U55 uses ~50KB, U85 uses ~50KB
   109	 *
   110	 * On APSS (Cortex-A32) the arena is placed into SRAM1 which is mapped
   111	 * non-cacheable by the MMU, ensuring coherency with the Ethos-U85 NPU.
   112	 * On RTSS (Cortex-M55) the arena goes into .bss.tflm_arena (DTCM/SRAM0).
   113	 */
   114	#if defined(CONFIG_APSS)
   115	__attribute__((section("SRAM1.tflm_arena"), aligned(16)))
   116	#else
   117	__attribute__((section(".bss.tflm_arena"), aligned(16)))
   118	#endif
   119	uint8_t inferenceProcessTensorArena[NUM_INFERENCE_TASKS][TENSOR_ARENA_SIZE];
   120	
   121	/* Allocate and initialize heap */
   122	void *allocateHeap(const size_t size)
   123	{
   124		k_heap *heap = static_cast<k_heap *>(k_malloc(sizeof(k_heap)));
   125		uint8_t *buf = static_cast<uint8_t *>(k_malloc(size));
   126	
   127		if ((buf == nullptr) || (heap == nullptr)) {
   128			printk("Heap allocation failed. heap=%p, buf=%p, size=%zu\n", heap, buf, size);
   129			exit(1);
   130		}
   131	
   132		k_heap_init(heap, buf, size);
   133	
   134		return static_cast<void *>(heap);
   135	}
   136	
   137	/* inferenceProcessTask - Run jobs from queue with available driver */
   138	void inferenceProcessTask(void *_name, void *heap, void *_params)
   139	{
   140		string *name = static_cast<string *>(_name);
   141		InferenceProcessParams *params = static_cast<InferenceProcessParams *>(_params);
   142	
   143		/* Assign the pre allocated heap - used in the k_queue_alloc_append */
   144		k_thread_heap_assign(k_current_get(), static_cast<k_heap *>(heap));
   145	
   146		class InferenceProcess inferenceProcess(params->tensorArena, params->arenaSize);
   147	
   148		for (;;) {
   149			/* Receive inference job */
   150			xInferenceJob *job =
   151				static_cast<xInferenceJob *>(k_queue_get(params->queueHandle, Z_FOREVER));
   152	
   153			printk("%s: Received inference job. job=%p\n", name->c_str(), job);
   154	
   155			/* Run inference */
   156			job->status = inferenceProcess.runJob(*job);
   157	
   158			printk("%s: Sending inference response. job=%p\n", name->c_str(), job);
   159	
   160			/* Return inference message */
   161			int ret = k_queue_alloc_append(job->responseQueue, job);
   162			if (0 != ret) {
   163				printk("%s: Failed to send message\n", name->c_str());
   164				exit(1);
   165			}
   166		}
   167	
   168		k_thread_abort(k_current_get());
   169	
   170		CODE_UNREACHABLE;
   171	}
   172	
   173	/* inferenceSenderTask - Creates NUM_INFERENCE_JOBS jobs, queues them, and then
   174	 * listens for completion status */
   175	void inferenceSenderTask(void *_name, void *heap, void *_queue)
   176	{
   177		string *name = static_cast<string *>(_name);
   178		k_queue *inferenceQueue = static_cast<k_queue *>(_queue);
   179		int ret = 0;
   180	
   181		/* Assign the pre allocated heap - used in the k_queue_alloc_append */
   182		k_thread_heap_assign(k_current_get(), static_cast<k_heap *>(heap));
   183	
   184		/* Create queue for response messages */
   185		k_queue senderQueue;
   186		k_queue_init(&senderQueue);
   187	
   188		/* Loop over all jobs and push them to inference queue */
   189		xInferenceJob jobs[NUM_JOBS_PER_TASK];
   190		for (int n = 0; n < NUM_JOBS_PER_TASK; n++) {
   191			auto &job = jobs[n];
   192			job = xInferenceJob(modelName, DataPtr((void*)networkModelData, sizeof(networkModelData)),
   193					    { DataPtr((void*)inputData, sizeof(inputData)) }, {},
   194					    { DataPtr((void*)expectedOutputData, sizeof(expectedOutputData)) },
   195					    &senderQueue);
   196	
   197			printk("%s: Sending inference. job=%p, name=%s\n", name->c_str(), &job,
   198			       job.name.c_str());
   199	
   200			/* Queue job */
   201			ret = k_queue_alloc_append(inferenceQueue, &job);
   202			if (0 != ret) {
   203				printk("%s: Failed to send message\n", name->c_str());
   204				exit(1);
   205			}
   206		}
   207	
   208		/* Listen for completion status */
   209		do {
   210			xInferenceJob *job =
   211				static_cast<xInferenceJob *>(k_queue_get(&senderQueue, Z_FOREVER));
   212	
   213			printk("%s: Received job response. job=%p, status=%u\n", name->c_str(), job,
   214			       job->status);
   215	
   216			totalCompletedJobs++;
   217	
   218			ret += job->status;
   219			if (job->status != 0) {
   220				break;
   221			}
   222		} while (totalCompletedJobs < NUM_JOBS_PER_TASK * NUM_JOB_TASKS);
   223	
   224		exit(ret);
   225	}
   226	
   227	} /* namespace */
   228	
   229	/* Zephyr application. NOTE: Additional tasks may require increased heap size. */
   230	int main()
   231	{
   232		struct {
   233			k_thread thread;
   234			k_tid_t id;
   235		} threads[NUM_JOB_TASKS + NUM_INFERENCE_TASKS];
   236		size_t nthreads = 0;
   237	
   238		/* Allocate one global heap for all threads */
   239		void *heapPtr = allocateHeap(256);
   240	
   241		k_queue inferenceQueue;
   242		k_queue_init(&inferenceQueue);
   243	
   244		/* inferenceSender tasks to create and queue the jobs */
   245		for (int n = 0; n < NUM_JOB_TASKS; n++) {
   246			const size_t stackSize = 2048;
   247			k_thread_stack_t *stack = static_cast<k_thread_stack_t *>(k_malloc(stackSize));
   248			if (stack == nullptr) {
   249				printk("Failed to allocate stack to 'inferenceSenderTask%i'\n", n);
   250				exit(1);
   251			}
   252	
   253			auto &thread = threads[nthreads];
   254			string *name = new string("sender " + to_string(n));
   255	
   256			thread.id = k_thread_create(&thread.thread, stack, stackSize, inferenceSenderTask,
   257						    name, heapPtr, &inferenceQueue, 3, 0, K_FOREVER);
   258			if (thread.id == 0) {
   259				printk("Failed to create 'inferenceSenderTask%i'\n", n);
   260				exit(1);
   261			}
   262	
   263			nthreads++;
   264		}
   265	
   266		/* Create inferenceProcess tasks to process the queued jobs */
   267		InferenceProcessParams taskParams[NUM_INFERENCE_TASKS];
   268		for (int n = 0; n < NUM_INFERENCE_TASKS; n++) {
   269			const size_t stackSize = 8192;
   270			k_thread_stack_t *stack = static_cast<k_thread_stack_t *>(k_malloc(stackSize));
   271			if (stack == nullptr) {
   272				printk("Failed to allocate stack to 'inferenceSenderTask%i'\n", n);
   273				exit(1);
   274			}
   275	
   276			auto &thread = threads[nthreads];
   277			auto &taskParam = taskParams[n];
   278			taskParam = InferenceProcessParams(&inferenceQueue, inferenceProcessTensorArena[n],
   279							   tensorArenaSize);
   280			string *name = new string("runner " + to_string(n));
   281	
   282			thread.id = k_thread_create(&thread.thread, stack, stackSize, inferenceProcessTask,
   283						    name, heapPtr, &taskParam, 2, 0, K_FOREVER);
   284			if (thread.id == 0) {
   285				printk("Failed to create 'inferenceProcessTask%i'\n", n);
   286				exit(1);
   287			}
   288	
   289			nthreads++;
   290		}
   291	
   292		/* start Scheduler */
   293		for (size_t n = 0; n < nthreads; n++) {
   294			k_thread_start(threads[n].id);
   295		}
   296	
   297		/* put the task in the lowest priority */
   298		k_thread_priority_set(k_current_get(), 4);
   299	
   300		/* Safety belt */
   301		k_thread_suspend(k_current_get());
   302	
   303		printk("Zephyr application failed to initialise \n");
   304	
   305		return 1;
   306	}

