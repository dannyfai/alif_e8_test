    11	/*
    12	 * Ethos-U55 NPU Enable Overlay
    13	 * 
    14	 * This overlay enables the Ethos-U55 NPU (ethosu0) for all boards.
    15	 * 
    16	 * Applicable to ALL Boards:
    17	 *   - B1 (alif_b1_dk)      - U55 only
    18	 *   - E1C (alif_e1c_dk)    - U55 only
    19	 *   - E7 (alif_e7_dk)      - U55 only
    20	 *   - E8 (alif_e8_dk)      - U55 + U85
    21	 *
    22	 * Note: All boards have ethosu0 (U55). E8 additionally has ethosu1 (U85).
    23	 * 
    24	 * Usage:
    25	 *   west build -b <board> <app_path> -- \
    26	 *     -DEXTRA_DTC_OVERLAY_FILE="boards/enable_ethosu55.overlay"
    27	 * 
    28	 * Build-time Safety Check:
    29	 *   If this overlay is applied to a board without U55 support,
    30	 *   the build will fail with an error message indicating that ethosu0 node
    31	 *   does not exist on this board.
    32	 */
    33	
    34	/ {
    35		/* Compile-time assertion: ethosu0 must exist */
    36		ethosu_u55_check {
    37			compatible = "vnd,ethosu-u55-check";
    38			ethosu-node = <&ethosu0>;
    39		};
    40	};
    41	
    42	&ethosu0 {
    43		status = "okay";
    44	};

