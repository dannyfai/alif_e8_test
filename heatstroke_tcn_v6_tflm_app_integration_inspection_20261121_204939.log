   401	static unsigned int SmokeArgMax4(const float* values)
   402	{
   403	    unsigned int best = 0U;
   404	    for (unsigned int i = 1U; i < 4U; ++i) {
   405	        if (values[i] > values[best]) {
   406	            best = i;
   407	        }
   408	    }
   409	    return best;
   410	}
