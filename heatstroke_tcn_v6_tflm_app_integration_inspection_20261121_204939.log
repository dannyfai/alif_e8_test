    11	/*
    12	 * Ethos-U85 NPU Enable Overlay
    13	 * 
    14	 * This overlay enables the Ethos-U85 NPU (ethosu1) for boards that support it.
    15	 * 
    16	 * Applicable Boards (have both U55 and U85):
    17	 *   - E8 (alif_e8_dk) - has U55 + U85
    18	 *
    19	 * NOT applicable to:
    20	 *   - B1, E1C, E7 (have U55 only, no U85)
    21	 * 
    22	 * Note: E8 board has BOTH ethosu0 (U55) and ethosu1 (U85).
    23	 *       Use this overlay to enable the U85 NPU on these boards.
    24	 * 
    25	 * Usage:
    26	 *   west build -b alif_e8_dk/<variant>/<core> <app_path> -- \
    27	 *     -DEXTRA_DTC_OVERLAY_FILE="boards/enable_ethosu85.overlay"
    28	 * 
    29	 * Build-time Safety Check:
    30	 *   If this overlay is applied to a board without U85 support (B1, E1C, E3, E7),
    31	 *   the build will fail with an error message indicating that ethosu1 node
    32	 *   does not exist on this board.
    33	 */
    34	
    35	/ {
    36		/* Compile-time assertion: ethosu1 must exist */
    37		ethosu_u85_check {
    38			compatible = "vnd,ethosu-u85-check";
    39			ethosu-node = <&ethosu1>;
    40		};
    41	};
