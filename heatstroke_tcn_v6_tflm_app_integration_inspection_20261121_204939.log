     9	# Detect NPU architecture from ETHOSU_TARGET_NPU_CONFIG
    10	# This is the SINGLE SOURCE OF TRUTH for NPU configuration
    11	if(ETHOSU_TARGET_NPU_CONFIG MATCHES "^ethos-(u[0-9]+)-([0-9]+)$")
    12	    set(ETHOSU_ARCH "${CMAKE_MATCH_1}")
    13	    set(ETHOSU_MACS "${CMAKE_MATCH_2}")
    14	
    15	    message(STATUS "ETHOSU_TARGET_NPU_CONFIG: ${ETHOSU_TARGET_NPU_CONFIG}")
    16	    message(STATUS "Detected NPU Architecture: ${ETHOSU_ARCH}, MACs: ${ETHOSU_MACS}")
    17	
    18	    # Validate and configure for U55/U65
    19	    if((ETHOSU_ARCH STREQUAL "u55") OR (ETHOSU_ARCH STREQUAL "u65"))
    20	        # Validate MAC configuration based on core type (HE vs HP)
    21	        if(CONFIG_RTSS_HE)
    22	            # HE core only supports 128 MACs for U55
    23	            if(NOT (ETHOSU_MACS STREQUAL "128"))
    24	                message(FATAL_ERROR 
    25	                    "Core type mismatch: RTSS_HE core with U55 only supports 128 MACs.\n"
    26	                    "You specified: ${ETHOSU_MACS} MACs\n"
    27	                    "For HE core, use: -DETHOSU_TARGET_NPU_CONFIG=ethos-u55-128\n"
    28	                    "For 256 MACs, use HP core board variant (rtss_hp)")
    29	            endif()
    30	            message(STATUS "Detected RTSS_HE core - U55 restricted to 128 MACs")
    31	        elseif(CONFIG_RTSS_HP)
    32	            # HP core only supports 256 MACs for U55
    33	            if(NOT (ETHOSU_MACS STREQUAL "256"))
    34	                message(FATAL_ERROR 
    35	                    "Core type mismatch: RTSS_HP core with U55 only supports 256 MACs.\n"
    36	                    "You specified: ${ETHOSU_MACS} MACs\n"
    37	                    "For HP core, use: -DETHOSU_TARGET_NPU_CONFIG=ethos-u55-256\n"
    38	                    "For 128 MACs, use HE core board variant (rtss_he)")
    39	            endif()
    40	            message(STATUS "Detected RTSS_HP core - U55 restricted to 256 MACs")
    41	        elseif(CONFIG_APSS)
    42	            message(FATAL_ERROR
    43	                "Ethos-U55 is not directly accessible from APSS (Cortex-A32).\n"
    44	                "Use Ethos-U85 instead: -DETHOSU_TARGET_NPU_CONFIG=ethos-u85-256")
    45	        else()
    46	            # Fallback validation for other core types
    47	            if(NOT (ETHOSU_MACS STREQUAL "64" OR ETHOSU_MACS STREQUAL "128" OR ETHOSU_MACS STREQUAL "256"))
    48	                message(FATAL_ERROR "Unsupported U55/U65 MAC configuration: ${ETHOSU_MACS}. Valid: 64, 128, 256")
