   255	/** @brief   Verify input and output tensor are of certain min dimensions. */
   256	
   257	static bool VerifyOneTensor(
   258	    const char* label,
   259	    size_t index,
   260	    const std::shared_ptr<arm::app::fwk::iface::TensorIface>& tensor,
   261	    const std::vector<size_t>& expectedShape)
   262	{
   263	    using arm::app::fwk::iface::TensorType;
   264	
   265	    if (!tensor) {
   266	        LOG_ERR("%s[%u] tensor handle is null",
   267	                label, static_cast<unsigned int>(index));
   268	        return false;
   269	    }
   270	
   271	    const std::vector<size_t> actualShape = tensor->Shape();
   272	    if (actualShape != expectedShape) {
   273	        LOG_ERR("%s[%u] shape mismatch",
   274	                label, static_cast<unsigned int>(index));
   275	        return false;
   276	    }
   277	
   278	    if (tensor->Type() != TensorType::FP32) {
   279	        LOG_ERR("%s[%u] must be FP32; got %s",
   280	                label,
   281	                static_cast<unsigned int>(index),
   282	                arm::app::fwk::iface::GetTensorDataTypeName(tensor->Type()));
   283	        return false;
   284	    }
   285	
   286	    size_t expectedElements = 1U;
   287	    for (const size_t dimension : expectedShape) {
   288	        expectedElements *= dimension;
   289	    }
   290	
   291	    if (tensor->GetNumElements() != expectedElements ||
   292	        tensor->Bytes() != expectedElements * sizeof(float) ||
   293	        tensor->GetData() == nullptr) {
   294	        LOG_ERR("%s[%u] element count, byte size, or data pointer is invalid",
   295	                label, static_cast<unsigned int>(index));
   296	        return false;
   297	    }
   298	
   299	    LOG_INF("%s[%u]: FP32, elements=%u, bytes=%u",
   300	            label,
   301	            static_cast<unsigned int>(index),
   302	            static_cast<unsigned int>(tensor->GetNumElements()),
   303	            static_cast<unsigned int>(tensor->Bytes()));
   304	
   305	    return true;
   306	}
   307	
   308	static bool VerifyTensorInterface(const arm::app::fwk::iface::Model& model)
   309	{
   310	    if (model.GetNumInputs() != 4U || model.GetNumOutputs() != 2U) {
   311	        LOG_ERR("Model I/O count mismatch: inputs=%u outputs=%u; expected 4/2",
   312	                static_cast<unsigned int>(model.GetNumInputs()),
   313	                static_cast<unsigned int>(model.GetNumOutputs()));
   314	        return false;
   315	    }
   316	
   317	    const std::vector<std::vector<size_t>> expectedInputs = {
   318	        {1U, 900U, 6U},  /* x_values */
   319	        {1U, 900U, 6U},  /* missing_mask */
   320	        {1U, 900U, 3U},  /* x_mark */
   321	        {1U, 30U}        /* worker_features */
   322	    };
   323	
   324	    const char* inputNames[] = {
   325	        "x_values", "missing_mask", "x_mark", "worker_features"
   326	    };
   327	
   328	    for (size_t i = 0; i < expectedInputs.size(); ++i) {
   329	        if (!VerifyOneTensor(
   330	                "Input", i, model.GetInputTensor(i), expectedInputs[i])) {
   331	            LOG_ERR("Input contract failed for %s", inputNames[i]);
   332	            return false;
   333	        }
   334	    }
   335	
   336	    const std::vector<std::vector<size_t>> expectedOutputs = {
   337	        {1U, 4U},  /* rpe_logits */
   338	        {1U, 4U}   /* psi_logits */
   339	    };
   340	
   341	    const char* outputNames[] = {"rpe_logits", "psi_logits"};
   342	
   343	    for (size_t i = 0; i < expectedOutputs.size(); ++i) {
   344	        if (!VerifyOneTensor(
   345	                "Output", i, model.GetOutputTensor(i), expectedOutputs[i])) {
   346	            LOG_ERR("Output contract failed for %s", outputNames[i]);
   347	            return false;
   348	        }
   349	    }
   350	
   351	    return true;
   352	}
