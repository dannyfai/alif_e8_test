#!/usr/bin/env python3
from pathlib import Path
import argparse
import importlib.util
import json
import sys
import hashlib
from collections import Counter

import numpy as np
import torch
import onnx
from onnx import numpy_helper, TensorProto, helper
import onnxruntime as ort


SENTINELS = (-9997.0, -9998.0, -9999.0)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def load_module(path, name):
    spec = importlib.util.spec_from_file_location(name, str(path))
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Cannot import: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def collect_constants(graph):
    values = {}

    for init in graph.initializer:
        values[init.name] = np.asarray(numpy_helper.to_array(init))

    for node in graph.node:
        if node.op_type != "Constant" or not node.output:
            continue
        for attr in node.attribute:
            if attr.name == "value":
                values[node.output[0]] = np.asarray(
                    numpy_helper.to_array(attr.t)
                )
            elif attr.name == "value_float":
                values[node.output[0]] = np.asarray(attr.f)
            elif attr.name == "value_int":
                values[node.output[0]] = np.asarray(attr.i)

    # Resolve any simple Cast constants, if present.
    for _ in range(4):
        changed = False
        for node in graph.node:
            if node.op_type != "Cast" or not node.input or not node.output:
                continue
            if node.input[0] not in values:
                continue
            to_type = None
            for attr in node.attribute:
                if attr.name == "to":
                    to_type = attr.i
            if to_type is None:
                continue
            try:
                dtype = helper.tensor_dtype_to_np_dtype(to_type)
                values[node.output[0]] = values[node.input[0]].astype(dtype)
                changed = True
            except Exception:
                pass
        if not changed:
            break

    return values


def patch_graph(input_path, output_path):
    model = onnx.load(str(input_path))
    graph = model.graph

    existing_inputs = {x.name for x in graph.input}
    if "missing_mask" in existing_inputs:
        raise RuntimeError("Input already contains missing_mask; refusing to patch twice.")␀
    if "x_values" not in existing_inputs:
        raise RuntimeError(f"x_values input not found. Inputs: {sorted(existing_inputs)}")␀

    constants = collect_constants(graph)
    matched = {}
    matched_nodes = set()
    diagnostic_equal_nodes = []

    for index, node in enumerate(graph.node):
        if node.op_type != "Equal":
            continue

        diagnostic_equal_nodes.append({
            "index": index,
            "inputs": list(node.input),
            "outputs": list(node.output),
        })

        if len(node.input) != 2:
            continue
        if "x_values" not in node.input:
            continue

        const_name = node.input[0] if node.input[1] == "x_values" else node.input[1]␀
        if const_name not in constants:
            continue

        arr = np.asarray(constants[const_name])
        if arr.size != 1:
            continue

        try:
            value = float(arr.reshape(-1)[0])
        except Exception:
            continue

        for sentinel in SENTINELS:
            if value == sentinel:
                matched.setdefault(sentinel, []).append(index)
                matched_nodes.add(index)

    missing = [s for s in SENTINELS if s not in matched]
    if missing:
        print("Could not identify all three sentinel Equal operations.")
        print("Matched:", matched)
        print("Equal nodes found:")
        print(json.dumps(diagnostic_equal_nodes, indent=2))
        raise RuntimeError(
            f"Safe graph rewrite aborted. Missing sentinel comparisons: {missing}"␀
        )

    print("Sentinel Equal nodes identified:")
    for sentinel in SENTINELS:
        print(f"  {sentinel}: graph node indices {matched[sentinel]}")

    # Replace every sentinel-comparison output with the new Boolean input.
    replacements = {}
    for index in matched_nodes:
        node = graph.node[index]
        for output_name in node.output:
            replacements[output_name] = "missing_mask"

    kept_nodes = []
    for index, node in enumerate(graph.node):
        if index in matched_nodes:
            continue
        copied = onnx.NodeProto()
        copied.CopyFrom(node)
        for j, name in enumerate(copied.input):
            if name in replacements:
                copied.input[j] = replacements[name]
        kept_nodes.append(copied)

    del graph.node[:]
    graph.node.extend(kept_nodes)

    # Remove obsolete value-info records for removed comparison outputs.
    kept_value_info = [
        item for item in graph.value_info
        if item.name not in replacements
    ]
    del graph.value_info[:]
    graph.value_info.extend(kept_value_info)

    mask_info = helper.make_tensor_value_info(
        "missing_mask",
        TensorProto.BOOL,
        [1, 900, 6],
    )

    # Keep a predictable and documented input order.
    old_inputs = {item.name: item for item in graph.input}
    ordered_names = [
        "x_values",
        "missing_mask",
        "x_mark",
        "worker_features_18",
        "compact_values",
    ]

    absent = [name for name in ordered_names if name != "missing_mask" and name not in old_inputs]␀
    if absent:
        raise RuntimeError(f"Unexpected missing graph inputs: {absent}")

    del graph.input[:]
    for name in ordered_names:
        graph.input.append(mask_info if name == "missing_mask" else old_inputs[name])␀

    onnx.checker.check_model(model)
    onnx.save(model, str(output_path))

    # Reload and check the saved artifact, not just the in-memory graph.
    saved = onnx.load(str(output_path))
    onnx.checker.check_model(saved)

    ops = Counter(node.op_type for node in saved.graph.node)
    print("Patched ONNX checker: PASS")
    print("Removed sentinel Equal nodes:", len(matched_nodes))
    print("New input: missing_mask BOOL [1,900,6]")
    print("Graph inputs:")
    for item in saved.graph.input:
        dims = [
            d.dim_value if d.dim_value else (d.dim_param or "?")
            for d in item.type.tensor_type.shape.dim
        ]
        print(
            f"  {item.name}: elem_type={item.type.tensor_type.elem_type}, "
            f"shape={dims}"
        )
    print("Graph nodes:", len(saved.graph.node))
    print("Operator counts:", json.dumps(dict(sorted(ops.items()))))
    print("Output ONNX:", output_path)
    print("Output bytes:", output_path.stat().st_size)
    print("Output SHA256:", sha256(output_path))

    return saved


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project", required=True)
    ap.add_argument("--onnx-in", required=True)
    ap.add_argument("--onnx-out", required=True)
    ap.add_argument("--seed", type=int, default=20261121)
    ap.add_argument("--group-column", default="worker_id")
    ap.add_argument("--atol", type=float, default=2e-4)
    ap.add_argument("--rtol", type=float, default=2e-4)
    args = ap.parse_args()

    project = Path(args.project).resolve()
    onnx_in = Path(args.onnx_in).resolve()
    onnx_out = Path(args.onnx_out).resolve()
    exp = project / "experiments" / "tcn_reg_20261120"

    exporter_path = exp / "export_tcn_reg_fold2_fp32_onnx_v5_manual_erf_gelu.py" 
    helper_path = exp / "train_tcn_reg_testdev_experiment.py"
    data_dir = project / "data" / "split_byid"

    for path in (onnx_in, exporter_path, helper_path,
                 data_dir / "test_seq.feather",
                 data_dir / "test_non_seq.csv"):
        if not path.is_file():
            raise FileNotFoundError(f"Required file not found: {path}")

    if onnx_out.exists():
        raise FileExistsError(
            f"Refusing to overwrite an existing output: {onnx_out}"
        )

    print("===== TCN FOLD-2 SANITIZED-INPUT / EXPLICIT-MASK V6 =====")
    print("Project:", project)
    print("Original ONNX:", onnx_in)
    print("Original ONNX SHA256:", sha256(onnx_in))
    print("V5 exporter:", exporter_path)

    # Use the exact dataset-input and compaction functions from the v5 exporter. 
    exporter = load_module(exporter_path, "tcn_fold2_v5_exporter_for_v6")
    helper_module = exporter.import_helper(helper_path)

    project_run = helper_module.import_project(project)
    dataset = helper_module.ImputationDataset(
        project_run,
        data_dir,
        "test",
        args.seed,
        args.group_column,
    )
    dataset.set_epoch(0)

    if len(dataset) != 449:
        raise RuntimeError(
            f"Expected 449 split_byid/test samples, got {len(dataset)}"
        )

    onnx_out.parent.mkdir(parents=True, exist_ok=True)
    patched_model = patch_graph(onnx_in, onnx_out)

    old_session = ort.InferenceSession(
        str(onnx_in), providers=["CPUExecutionProvider"]
    )
    new_session = ort.InferenceSession(
        str(onnx_out), providers=["CPUExecutionProvider"]
