MODEL_DIR="$EXP/onnx_fp32_fold2_manual_ln_no_erf_20261121_175710"
PYTHON="/home/user/onnx2tflite_env/bin/python"
CONVERTER="/home/user/onnx2tflite_env/bin/onnx2tflite"
LOGDIR="/home/user/sdk-alif/beeinventor/test_heatstroke/log"

mkdir -p "$LOGDIR"

RUN_TAG="$(date +%Y%m%d_%H%M%S)"
OUTDIR="$EXP/tflite_fp32_fold2_sanitized_mask_v6_$RUN_TAG"
SCRIPT="$EXP/validate_tcn_fold2_v6_tflite_all449.py"
LOG="$LOGDIR/heatstroke_tcn_v6_onnx2tflite_all449_$RUN_TAG.log"

mkdir -p "$OUTDIR"

cat > "$SCRIPT" <<'PY'
#!/usr/bin/env python3
from pathlib import Path
from collections import Counter
from datetime import datetime
import argparse
import hashlib
import importlib.util
import json
import subprocess
import sys

import numpy as np
import torch
import onnxruntime as ort
import tensorflow as tf


SENTINELS = (-9997.0, -9998.0, -9999.0)
EXPECTED_ONNX_SHA256 = (
    "1679ccd65d37834014c22f9306241e72"
    "d57a6ee1e0996584747e8b30f8c0588a"
)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def import_module(path, name):
    spec = importlib.util.spec_from_file_location(name, str(path))
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def resolve_input(details, key):
    matches = [
        d for d in details
        if key.lower() in d["name"].lower()
    ]
    if len(matches) != 1:
        raise RuntimeError(
            f"Cannot uniquely identify TFLite input '{key}'. "
            f"Matches={[x['name'] for x in matches]}; "
            f"all_inputs={[x['name'] for x in details]}"
        )
    return matches[0]


def compare(reference, candidate, atol, rtol):
    delta = np.abs(reference - candidate)
    return {
        "max_abs_error": float(delta.max()),
        "mean_abs_error": float(delta.mean()),
        "rmse": float(np.sqrt(np.mean(np.square(reference - candidate)))),
        "allclose": bool(
            np.allclose(reference, candidate, atol=atol, rtol=rtol)
        ),
        "finite": bool(np.isfinite(candidate).all()),
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project", required=True)
    ap.add_argument("--model-dir", required=True)
    ap.add_argument("--out-dir", required=True)
    ap.add_argument("--converter", required=True)
    ap.add_argument("--seed", type=int, default=20261121)
    ap.add_argument("--group-column", default="worker_id")
    ap.add_argument("--atol", type=float, default=2e-4)
    ap.add_argument("--rtol", type=float, default=2e-4)
    args = ap.parse_args()

    project = Path(args.project).resolve()
    model_dir = Path(args.model_dir).resolve()
    out_dir = Path(args.out_dir).resolve()
    converter = Path(args.converter).resolve()

    onnx_path = (
        model_dir /
        "heatstroke_tcn_reg_fold2_fp32_sanitized_mask_v6.onnx"
    )
    tflite_path = (
        out_dir /
        "heatstroke_tcn_reg_fold2_fp32_sanitized_mask_v6.tflite"
    )

    exp = project / "experiments" / "tcn_reg_20261120"
    exporter_path = (
        exp / "export_tcn_reg_fold2_fp32_onnx_v5_manual_erf_gelu.py"
    )
    helper_path = exp / "train_tcn_reg_testdev_experiment.py"
    data_dir = project / "data" / "split_byid"

    print("===== TCN FOLD-2 V6 FP32 TFLITE CONVERSION =====")
    print("Timestamp:", datetime.now().astimezone().isoformat())
    print("Python:", sys.version.replace("\n", " "))
    print("TensorFlow:", tf.__version__)
    print("ONNX Runtime:", ort.__version__)
    print("Project:", project)
    print("ONNX:", onnx_path)
    print("Output:", tflite_path)

    for path in (
        onnx_path,
        exporter_path,
        helper_path,
        data_dir / "test_seq.feather",
        data_dir / "test_non_seq.csv",
        converter,
    ):
        if not path.is_file():
            raise FileNotFoundError(f"Required file missing: {path}")

    if tflite_path.exists():
        raise FileExistsError(f"Refusing to overwrite: {tflite_path}")

    actual_sha = sha256(onnx_path)
    print("V6 ONNX SHA256:", actual_sha)
    if actual_sha != EXPECTED_ONNX_SHA256:
        raise RuntimeError(
            "ONNX SHA256 does not match the validated V6 model. "
            "Refusing conversion."
        )

    # ------------------------------------------------------------
    # 1. Convert ONNX to FP32 TFLite.
    # ------------------------------------------------------------
    command = [
        str(converter),
        str(onnx_path),
        "--cast-int64-to-int32",
        "--guarantee-non-negative-indices",
        "--verbose",
        "-o",
        str(tflite_path),
    ]

    print("\n===== ONNX2TFLITE COMMAND =====")
    print(" ".join(command))
    subprocess.run(command, check=True)

    if not tflite_path.is_file() or tflite_path.stat().st_size == 0:
        raise RuntimeError("Converter did not produce a valid TFLite file.")

    print("TFLite bytes:", tflite_path.stat().st_size)
    print("TFLite SHA256:", sha256(tflite_path))

    # ------------------------------------------------------------
    # 2. Allocate interpreter tensors and inspect operations.
    # ------------------------------------------------------------
    print("\n===== TFLITE INTERPRETER PREFLIGHT =====")
    interpreter = tf.lite.Interpreter(
        model_path=str(tflite_path)
    )
    interpreter.allocate_tensors()

    input_details = interpreter.get_input_details()
    output_details = interpreter.get_output_details()

    print("TFLite inputs:")
    for d in input_details:
        print(
            " ",
            d["name"],
            "shape=", d["shape"].tolist(),
            "dtype=", d["dtype"],
            "bytes=", int(np.prod(d["shape"])) * np.dtype(d["dtype"]).itemsize,
        )

    print("TFLite outputs:")
    for d in output_details:
        print(
            " ",
            d["name"],
            "shape=", d["shape"].tolist(),
            "dtype=", d["dtype"],
        )

    if len(output_details) != 1:
        raise RuntimeError(
            f"Expected one output, found {len(output_details)}"
        )

    input_keys = [
        "x_values",
        "missing_mask",
        "x_mark",
        "worker_features_18",
        "compact_values",
    ]

    resolved = {
        key: resolve_input(input_details, key)
        for key in input_keys
    }

    expected_shapes = {
        "x_values": (1, 900, 6),
        "missing_mask": (1, 900, 6),
        "x_mark": (1, 900, 3),
        "worker_features_18": (1, 18),
        "compact_values": (1, 1800, 6),
    }

    for key, detail in resolved.items():
        shape = tuple(int(v) for v in detail["shape"])
        if shape != expected_shapes[key]:
            raise RuntimeError(
                f"TFLite input {key} shape mismatch: {shape}"
            )

        if key == "missing_mask":
            if np.dtype(detail["dtype"]) != np.dtype(np.bool_):
                raise RuntimeError(
                    "The missing_mask input is not Boolean in TFLite: "
                    f"{detail['dtype']}. Stop and inspect conversion."
                )
        elif np.dtype(detail["dtype"]) != np.dtype(np.float32):
            raise RuntimeError(
                f"Expected FP32 input {key}; got {detail['dtype']}"
            )

    ops = interpreter._get_ops_details()
    op_counts = Counter(str(op.get("op_name", "UNKNOWN")) for op in ops)

    custom_ops = sorted(
        name for name in op_counts
        if name.upper() == "CUSTOM" or name.upper().startswith("FLEX")
    )

    print("\nTFLite operator count:", len(ops))
    print("TFLite operator histogram:")
    print(json.dumps(dict(sorted(op_counts.items())), indent=2))
    print("CUSTOM/FLEX operators:", custom_ops)

    if custom_ops:
        raise RuntimeError(
            f"Flex/custom operators detected: {custom_ops}"
        )

    print("Interpreter allocate_tensors(): PASS")
    print("No CUSTOM/FLEX operators: PASS")

    # ------------------------------------------------------------
    # 3. Set up the deterministic 449-sample dataset and V6 ORT.
    # ------------------------------------------------------------
    print("\n===== PREPARING 449-SAMPLE VALIDATION =====")
    exporter = import_module(
        exporter_path,
        "tcn_fold2_v5_exporter_for_v6_tflite_validation",
    )
    helper = exporter.import_helper(helper_path)
    project_run = helper.import_project(project)

    dataset = helper.ImputationDataset(
        project_run,
        data_dir,
        "test",
        args.seed,
        args.group_column,
    )
    dataset.set_epoch(0)

    if len(dataset) != 449:
        raise RuntimeError(
            f"Expected 449 samples, found {len(dataset)}"
        )

    ort_session = ort.InferenceSession(
        str(onnx_path),
        providers=["CPUExecutionProvider"],
    )
    print("ONNX Runtime input names:")
    print([
        (d.name, d.shape, d.type)
        for d in ort_session.get_inputs()
    ])

    ort_output_name = ort_session.get_outputs()[0].name
    tflite_output = output_details[0]

    # ------------------------------------------------------------
    # 4. Compare TFLite with V6 ONNX Runtime on every sample.
    # ------------------------------------------------------------
    failures = []
    global_max = 0.0
    abs_sum = 0.0
    square_sum = 0.0
    total_values = 0
    worst_sample = -1
    missing_entries = 0

    for index in range(len(dataset)):
        x, mark, worker, compact = exporter.make_sample_inputs(
            dataset, index
        )

        mask = (
            (x == -9997) |
            (x == -9998) |
            (x == -9999)
        )
        sanitized = torch.where(
            mask,
            torch.zeros_like(x),
            x,
        )

        feed = {
            "x_values": sanitized.cpu().numpy().astype(np.float32),
            "missing_mask": mask.cpu().numpy().astype(np.bool_),
            "x_mark": mark.cpu().numpy().astype(np.float32),
            "worker_features_18": worker.cpu().numpy().astype(np.float32),
            "compact_values": compact.cpu().numpy().astype(np.float32),
        }

        # Reference: validated V6 ONNX Runtime model.
        reference = ort_session.run(
            [ort_output_name],
            feed,
        )[0]

        # Candidate: converted FP32 TFLite model.
        for key in input_keys:
            detail = resolved[key]
            value = feed[key].astype(detail["dtype"], copy=False)
            interpreter.set_tensor(detail["index"], value)

        interpreter.invoke()
        candidate = interpreter.get_tensor(
            tflite_output["index"]
        )

        if reference.shape != candidate.shape:
            raise RuntimeError(
                f"Sample {index}: output shape mismatch "
                f"{reference.shape} vs {candidate.shape}"
            )

        metrics = compare(
            reference,
            candidate,
            args.atol,
            args.rtol,
        )

        delta = np.abs(reference - candidate)
        sample_max = metrics["max_abs_error"]

        if sample_max > global_max:
            global_max = sample_max
            worst_sample = index

        abs_sum += float(delta.sum())
        square_sum += float(np.square(reference - candidate).sum())
        total_values += delta.size
        missing_entries += int(feed["missing_mask"].sum())

        if not metrics["allclose"] or not metrics["finite"]:
            failures.append({
                "sample": index,
                **metrics,
            })

        if index % 25 == 0 or index == len(dataset) - 1:
            print(
                f"Progress {index + 1}/{len(dataset)}; "
                f"sample_max_abs={sample_max:.9g}; "
                f"failed_samples={len(failures)}"
            )

    report = {
        "model": "Fold-2 TCN regression/imputation stage, FP32",
        "onnx": str(onnx_path),
        "onnx_sha256": actual_sha,
        "tflite": str(tflite_path),
        "tflite_sha256": sha256(tflite_path),
        "dataset": "split_byid/test",
        "sample_count": len(dataset),
        "comparison": "TFLite versus V6 ONNX Runtime",
        "atol": args.atol,
        "rtol": args.rtol,
        "all_samples_pass": len(failures) == 0,
        "failed_samples": failures[:50],
        "global_max_abs_error": global_max,
        "global_mean_abs_error": abs_sum / max(total_values, 1),
        "global_rmse": float(
            np.sqrt(square_sum / max(total_values, 1))
        ),
        "worst_sample_index": worst_sample,
        "missing_sensor_entries": missing_entries,
        "operator_count": len(ops),
        "operator_histogram": dict(sorted(op_counts.items())),
        "custom_flex_operators": custom_ops,
        "input_specs": {
            key: {
                "shape": list(resolved[key]["shape"]),
                "dtype": str(resolved[key]["dtype"]),
            }
            for key in input_keys
        },
    }

    report_path = out_dir / "tflite_vs_onnx_all449_report.json"
    report_path.write_text(json.dumps(report, indent=2))

    print("\n===== ALL-449 TFLITE VALIDATION SUMMARY =====")
    print(json.dumps(report, indent=2))
    print("JSON report:", report_path)

    if failures:
        raise RuntimeError(
            f"TFLite validation FAILED: {len(failures)} / "
            f"{len(dataset)} samples outside tolerance. "
            "Do not quantize this model."
        )

    print("\n<TCN_V6_FP32_TFLITE_ALL449> PASS </TCN_V6_FP32_TFLITE_ALL449>")
    print("No INT8 quantization, Vela, firmware or flash operation performed.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(
            "\n<TCN_V6_FP32_TFLITE_ALL449> FAIL </TCN_V6_FP32_TFLITE_ALL449>",
            file=sys.stderr,
        )
        print(f"ERROR: {type(exc).__name__}: {exc}", file=sys.stderr)
        raise
PY

