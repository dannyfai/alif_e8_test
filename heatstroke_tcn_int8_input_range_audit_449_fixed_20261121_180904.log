            "x_mark": mark.cpu().numpy().astype(np.float32),
            "worker_features_18": worker.cpu().numpy().astype(np.float32),
            "compact_values": compact.cpu().numpy().astype(np.float32),
        }

        reference = ort_session.run(
            [ort_output_name], feed
        )[0]

        for key in INPUT_KEYS:
            detail = resolved[key]
            interpreter.set_tensor(
                detail["index"],
                feed[key].astype(detail["dtype"], copy=False),
            )

        interpreter.invoke()
        candidate = interpreter.get_tensor(output_detail["index"])

        if reference.shape != candidate.shape:
