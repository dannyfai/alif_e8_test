    "worker_features_18",
    "compact_values",
]

SENTINELS = (-9997.0, -9998.0, -9999.0)


def sha256(path):
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def import_module(path, name):
    spec = importlib.util.spec_from_file_location(name, str(path))
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def resolve_detail(details, key):
    found = [d for d in details if key.lower() in d["name"].lower()]
    if len(found) != 1:
        raise RuntimeError(
            f"Could not uniquely resolve {key}: "
            f"{[d['name'] for d in found]}"
        )
    return found[0]


def json_default(value):
    if isinstance(value, np.generic):
        return value.item()
    if isinstance(value, np.ndarray):
        return value.tolist()
    if isinstance(value, Path):
        return str(value)
    raise TypeError(f"Cannot serialize {type(value).__name__}")


def main():
    print("===== V6 TFLITE ALL-449 FINAL NUMERICAL REPORT =====")
    print("TensorFlow:", tf.__version__)
    print("ONNX Runtime:", ort.__version__)
    print("ONNX:", ONNX_PATH)
    print("TFLite:", TFLITE_PATH)

    exporter_path = (
        EXP / "export_tcn_reg_fold2_fp32_onnx_v5_manual_erf_gelu.py"
    )
    helper_path = EXP / "train_tcn_reg_testdev_experiment.py"
    data_dir = PROJECT / "data" / "split_byid"

    for p in (
        ONNX_PATH,
        TFLITE_PATH,
        exporter_path,
        helper_path,
        data_dir / "test_seq.feather",
        data_dir / "test_non_seq.csv",
    ):
        if not p.is_file():
            raise FileNotFoundError(p)

    onnx_sha = sha256(ONNX_PATH)
    tflite_sha = sha256(TFLITE_PATH)

    print("ONNX SHA256:", onnx_sha)
    print("TFLite SHA256:", tflite_sha)

    if onnx_sha != EXPECTED_ONNX_SHA:
        raise RuntimeError("Unexpected ONNX hash; refusing validation.")
    if tflite_sha != EXPECTED_TFLITE_SHA:
        raise RuntimeError("Unexpected TFLite hash; refusing validation.")

    # Dataset preparation uses the exact preprocessing routines
    # from the previously validated V5 exporter.
    exporter = import_module(
        exporter_path,
        "tcn_v6_report_exporter",
    )
    helper = exporter.import_helper(helper_path)
    project_run = helper.import_project(PROJECT)

    dataset = helper.ImputationDataset(
        project_run,
        data_dir,
        "test",
        20261121,
        "worker_id",
    )
    dataset.set_epoch(0)

    if len(dataset) != 449:
        raise RuntimeError(f"Expected 449 samples, got {len(dataset)}")

    # Reference ONNX Runtime.
    ort_session = ort.InferenceSession(
        str(ONNX_PATH),
        providers=["CPUExecutionProvider"],
    )
    ort_output_name = ort_session.get_outputs()[0].name

    # Reuse existing TFLite model; no conversion.
    interpreter = tf.lite.Interpreter(
        model_path=str(TFLITE_PATH)
    )
    interpreter.allocate_tensors()

    input_details = interpreter.get_input_details()
    output_details = interpreter.get_output_details()

    if len(output_details) != 1:
        raise RuntimeError("Expected exactly one TFLite output.")

    resolved = {
        key: resolve_detail(input_details, key)
        for key in INPUT_KEYS
    }

    expected_shapes = {
        "x_values": (1, 900, 6),
        "missing_mask": (1, 900, 6),
        "x_mark": (1, 900, 3),
        "worker_features_18": (1, 18),
        "compact_values": (1, 1800, 6),
    }

    for key, detail in resolved.items():
        shape = tuple(int(v) for v in detail["shape"])
        if shape != expected_shapes[key]:
            raise RuntimeError(f"{key}: unexpected shape {shape}")

        expected_dtype = np.bool_ if key == "missing_mask" else np.float32
        if np.dtype(detail["dtype"]) != np.dtype(expected_dtype):
            raise RuntimeError(
                f"{key}: expected {expected_dtype}, got {detail['dtype']}"
            )

    ops = interpreter._get_ops_details()
