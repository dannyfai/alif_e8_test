    60	#endif  /* ACTIVATION_BUF_SZ */
    61	
    62	/* IFM section name. */
    63	#define IFM_BUF_SECTION             section("ifm")
    64	
    65	/* Form the attributes, alignment is mandatory. */
    66	#define MAKE_ATTRIBUTE(x)           __attribute__((ALIGNMENT_REQ, x))
    67	#define MODEL_SECTION_ATTRIBUTE      MAKE_ATTRIBUTE(MODEL_SECTION)
    68	#define ACTIVATION_BUF_ATTRIBUTE    MAKE_ATTRIBUTE(ACTIVATION_BUF_SECTION)
    69	#define IFM_BUF_ATTRIBUTE           MAKE_ATTRIBUTE(IFM_BUF_SECTION)
    70	#define LABELS_ATTRIBUTE            MAKE_ATTRIBUTE(LABEL_SECTION)
    71	
    72	#else /* HAVE_ATTRIBUTE(aligned) || (defined(__GNUC__) && !defined(__clang__)) */
    73	
    74	#define MODEL_SECTION_ATTRIBUTE
    75	#define ACTIVATION_BUF_ATTRIBUTE
    76	#define IFM_BUF_ATTRIBUTE
    77	#define LABELS_ATTRIBUTE
    78	
    79	#endif /* HAVE_ATTRIBUTE(aligned) || (defined(__GNUC__) && !defined(__clang__)) */
    80	
    81	#if defined(__cplusplus)
    82	}
    83	#endif /* defined(__cplusplus) */
