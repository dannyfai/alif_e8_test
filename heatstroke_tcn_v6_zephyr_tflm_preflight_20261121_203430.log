    54	
    55	void MainLoop()
    56	{
    57	    arm::app::fwk::tflm::TestModel model; /* Model wrapper object. */
    58	    arm::app::fwk::iface::MemoryRegion modelMem{arm::app::inference_runner::GetModelPointer(),
    59	                                                arm::app::inference_runner::GetModelLen()};
    60	    arm::app::fwk::iface::MemoryRegion computeMem{arm::app::activationBuf,
    61	                                                  sizeof(arm::app::activationBuf)};
    62	
    63	    /* Load the model. */
    64	    if (!model.Init(computeMem, modelMem)) {
    65	        printf_err("Failed to initialise model\n");
    66	        return;
    67	    }
    68	
    69	    /* Instantiate application context. */
    70	    arm::app::ApplicationContext caseContext;
    71	
    72	    arm::app::Profiler profiler{"inference_runner"};
    73	    caseContext.Set<arm::app::Profiler&>("profiler", profiler);
    74	    caseContext.Set<arm::app::fwk::iface::Model&>("model", model);
    75	
    76	    /* Loop. */
    77	    if (RunInferenceHandler(caseContext)) {
    78	        info("Inference completed.\n");
    79	    } else {
    80	        printf_err("Inference failed.\n");
    81	    }
    82	}

