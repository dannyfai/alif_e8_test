    28	    namespace inference_runner {
    29	#if defined(DYNAMIC_MODEL_BASE) && defined(DYNAMIC_MODEL_SIZE)
    30	
    31	static uint8_t* GetModelPointer()
    32	{
    33	    info("Model pointer: 0x%08x\n", DYNAMIC_MODEL_BASE);
    34	    return reinterpret_cast<uint8_t*>(DYNAMIC_MODEL_BASE);
    35	}
