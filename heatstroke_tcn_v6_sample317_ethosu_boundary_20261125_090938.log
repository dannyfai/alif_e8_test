    45	TfLiteStatus Prepare(TfLiteContext* context, TfLiteNode* node) {
    46	  TFLITE_DCHECK(context != nullptr);
    47	  TF_LITE_ENSURE(context, node->inputs->size > 0);
    48	  TFLITE_DCHECK(node->user_data != nullptr);
    49	  TF_LITE_ENSURE(context, node->custom_initial_data_size > 0);
    50	
    51	  OpData* data = static_cast<OpData*>(node->user_data);
    52	  int num_base_addr = node->inputs->size + node->outputs->size;
    53	
    54	  // Request arrays for the base address pointers and sizes.
    55	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
    56	      context, num_base_addr * sizeof(uint64_t), &data->base_addr_idx));
    57	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
    58	      context, num_base_addr * sizeof(size_t), &data->base_addr_size_idx));
    59	
    60	  // Get command stream data size.
    61	  MicroContext* micro_context = GetMicroContext(context);
    62	  TfLiteTensor* tensor = micro_context->AllocateTempInputTensor(node, 0);
    63	  data->cms_data_size = tensor->bytes;
    64	  micro_context->DeallocateTempTfLiteTensor(tensor);
    65	  return kTfLiteOk;
    66	}
