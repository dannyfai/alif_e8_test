 174: void MainLoop()
 175: {
 176:     using arm::app::fwk::iface::MemoryRegion;
 177:     using heatstroke_tcn_v6::TcnV6Model;
 178: 
 179:     printk("TCN_V6: activation_buf=%p capacity=%u bytes\n",
 180:            activationBuf,
 181:            static_cast<unsigned int>(sizeof(activationBuf)));
 182: 
 183:     const uint8_t* model_pointer =
 184:         arm::app::polyu_heatstroke::GetModelPointer();
 185:     const size_t model_length =
 186:         arm::app::polyu_heatstroke::GetModelLen();
 187: 
 188:     if (model_pointer == nullptr || model_length == 0U) {
 189:         printk("TCN_V6_ERROR: generated model pointer/length invalid\n");
 190:         return;
 191:     }
 192: 
 193:     printk("TCN_V6_MODEL: pointer=%p bytes=%u\n",
 194:            model_pointer,
 195:            static_cast<unsigned int>(model_length));
 196: 
 197:     MemoryRegion compute_buffer(activationBuf, sizeof(activationBuf));
 198:     MemoryRegion model_buffer(
 199:         const_cast<uint8_t*>(model_pointer), model_length);
 200: 
 201:     static TcnV6Model model;
 202: 
 203:     if (!model.PrepareResolver()) {
 204:         printk("TCN_V6_ERROR: resolver preparation failed\n");
 205:         return;
 206:     }
 207: 
 208:     printk("TCN_V6: initializing TFLM model\n");
 209: 
 210:     if (!model.Init(compute_buffer, model_buffer)) {
 211:         printk("TCN_V6_ERROR: TFLM model initialization/AllocateTensors failed\n");
 212:         return;
 213:     }
 214: 
 215:     if (model.GetNumInputs() != kInputCount ||
 216:         model.GetNumOutputs() != 1U) {
 217:         printk("TCN_V6_ERROR: model interface count mismatch inputs=%u outputs=%u\n",
 218:                static_cast<unsigned int>(model.GetNumInputs()),
 219:                static_cast<unsigned int>(model.GetNumOutputs()));
 220:         return;
 221:     }
 222: 
 223:     auto* interpreter = model.GetBackendData().m_pInterpreter.get();
 224: 
 225:     if (!ValidateAndZeroInputs(interpreter) ||
 226:         !ValidateOutput(interpreter)) {
 227:         printk("TCN_V6_ERROR: tensor interface validation failed\n");
 228:         return;
 229:     }
 230: 
 231:     printk("TCN_V6_ETHOSU: model_contains_ethosu=%u\n",
 232:            model.ContainsEthosUOperator() ? 1U : 0U);
 233: 
 234:     printk("TCN_V6_ARENA: used=%u capacity=%u bytes\n",
 235:            static_cast<unsigned int>(interpreter->arena_used_bytes()),
 236:            static_cast<unsigned int>(sizeof(activationBuf)));
 237: 
 238:     printk("TCN_V6: invoking zero-input smoke inference\n");
 239: 
 240:     const uint64_t start_cycles = k_cycle_get_64();
 241:     const bool inference_ok = model.RunInference();
 242:     const uint64_t elapsed_cycles = k_cycle_get_64() - start_cycles;
 243:     const uint64_t elapsed_us = k_cyc_to_us_floor64(elapsed_cycles);
 244: 
 245:     printk("TCN_V6_INFERENCE: success=%u cycles=%llu elapsed_us=%llu\n",
 246:            inference_ok ? 1U : 0U,
 247:            static_cast<unsigned long long>(elapsed_cycles),
 248:            static_cast<unsigned long long>(elapsed_us));
 249: 
 250:     if (!inference_ok) {
 251:         printk("TCN_V6_ERROR: Invoke failed\n");
 252:         return;
 253:     }
 254: 
 255:     if (!ValidateOutput(interpreter)) {
 256:         return;
 257:     }
 258: 
 259:     ReportOutput(interpreter);
 260: 
 261:     printk("TCN_V6_ARENA_FINAL: used=%u capacity=%u bytes\n",
 262:            static_cast<unsigned int>(interpreter->arena_used_bytes()),
 263:            static_cast<unsigned int>(sizeof(activationBuf)));
 264: 
 265:     printk("TCN_V6_SMOKE_TEST: PASS (zero inputs; not an accuracy test)\n");
 266: }

