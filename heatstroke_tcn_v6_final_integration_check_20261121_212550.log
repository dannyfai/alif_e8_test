    17	#include "mlek/fwk/tflm/MobileNetModel.hpp"
    18	#include "mlek/log/log_macros.h"
    19	
    20	const tflite::MicroOpResolver& arm::app::fwk::tflm::MobileNetModel::GetOpResolver()
    21	{
    22	    return this->m_opResolver;
    23	}
    24	
    25	bool arm::app::fwk::tflm::MobileNetModel::EnlistOperations()
    26	{
    27	#ifndef ETHOS_U_NPU_ASSUMED
    28	    this->m_opResolver.AddDepthwiseConv2D();
    29	    this->m_opResolver.AddConv2D();
    30	    this->m_opResolver.AddAveragePool2D();
    31	    this->m_opResolver.AddAdd();
    32	    this->m_opResolver.AddReshape();
    33	    this->m_opResolver.AddSoftmax();
    34	#endif
    35	
    36	    if (kTfLiteOk == this->m_opResolver.AddEthosU()) {
    37	        info("Added %s support to op resolver\n", tflite::GetString_ETHOSU());
    38	    } else {
    39	        printf_err("Failed to add Arm NPU support to op resolver.");
    40	        return false;
    41	    }
    42	    return true;
    43	}

