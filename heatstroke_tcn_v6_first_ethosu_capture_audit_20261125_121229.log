    39	
    40	void* Init(TfLiteContext* context, const char* buffer, size_t length) {
    41	  TFLITE_DCHECK(context->AllocatePersistentBuffer != nullptr);
    42	  return context->AllocatePersistentBuffer(context, sizeof(OpData));
    43	}
    44	
    45	TfLiteStatus Prepare(TfLiteContext* context, TfLiteNode* node) {
    46	  TFLITE_DCHECK(context != nullptr);
    47	  TF_LITE_ENSURE(context, node->inputs->size > 0);
    48	  TFLITE_DCHECK(node->user_data != nullptr);
    49	  TF_LITE_ENSURE(context, node->custom_initial_data_size > 0);
    50	
    51	  OpData* data = static_cast<OpData*>(node->user_data);
    52	  int num_base_addr = node->inputs->size + node->outputs->size;
    53	
    54	  // Request arrays for the base address pointers and sizes.
    55	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
    56	      context, num_base_addr * sizeof(uint64_t), &data->base_addr_idx));
    57	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
    58	      context, num_base_addr * sizeof(size_t), &data->base_addr_size_idx));
    59	
    60	  // Get command stream data size.
    61	  MicroContext* micro_context = GetMicroContext(context);
    62	  TfLiteTensor* tensor = micro_context->AllocateTempInputTensor(node, 0);
    63	  data->cms_data_size = tensor->bytes;
    64	  micro_context->DeallocateTempTfLiteTensor(tensor);
    65	  return kTfLiteOk;
    66	}
    67	
    68	TfLiteStatus Eval(TfLiteContext* context, TfLiteNode* node) {
    69	  // TCN V6 runtime profiling counters.
    70	  static uint32_t tcn_v6_npu_invocation_index = 0;
    71	  static uint32_t tcn_v6_npu_cumulative_invoke_ms = 0;
    72	  static uint32_t tcn_v6_npu_cumulative_irq_delta = 0;
    73	
    74	  TFLITE_DCHECK(node->user_data != nullptr);
    75	  TFLITE_DCHECK(context != nullptr);
    76	  TFLITE_DCHECK(context->GetScratchBuffer != nullptr);
    77	
    78	  // Get base addresses.
    79	  TfLiteEvalTensor* tensor;
    80	  int i = 0;
    81	  int num_tensors = 0;
    82	  void* cms_data;
    83	  uint8_t co_type;
    84	  int result;
    85	  const OpData* data = static_cast<const OpData*>(node->user_data);
    86	  uint64_t* base_addrs = static_cast<uint64_t*>(
    87	      context->GetScratchBuffer(context, data->base_addr_idx));
    88	  size_t* base_addrs_size = static_cast<size_t*>(
    89	      context->GetScratchBuffer(context, data->base_addr_size_idx));
    90	
    91	  const uint8_t* custom_data =
    92	      static_cast<uint8_t const*>(node->custom_initial_data);
    93	  auto root = flexbuffers::GetRoot(custom_data, node->custom_initial_data_size);
    94	  co_type = root.AsInt8();
    95	  if (co_type != CO_TYPE_ETHOSU) {
    96	    MicroPrintf("CO_TYPE != ETHOSU");
    97	    return kTfLiteError;
    98	  }
    99	
   100	  // Get command stream data address.
   101	  tensor = context->GetEvalTensor(context, node->inputs->data[0]);
   102	  cms_data = reinterpret_cast<void*>(tensor->data.uint8);
   103	
   104	  // Get addresses to weights/scratch/input data.
   105	  for (i = 1; i < node->inputs->size; ++i) {
   106	    tensor = context->GetEvalTensor(context, node->inputs->data[i]);
   107	    base_addrs[num_tensors] =
   108	        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(tensor->data.uint8));
   109	    size_t byte_size = 1;
   110	    for (int k = 0; k < tensor->dims->size; k++) {
   111	      byte_size = byte_size * tensor->dims->data[k];
   112	    }
   113	    base_addrs_size[num_tensors] = byte_size;
   114	    num_tensors++;
   115	  }
   116	
   117	  // Get addresses to output data.
   118	  for (i = 0; i < node->outputs->size; ++i) {
   119	    tensor = context->GetEvalTensor(context, node->outputs->data[i]);
   120	    base_addrs[num_tensors] =
   121	        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(tensor->data.uint8));
   122	    size_t byte_size = 1;
   123	    for (int k = 0; k < tensor->dims->size; k++) {
   124	      byte_size = byte_size * tensor->dims->data[k];
   125	    }
   126	    base_addrs_size[num_tensors] = byte_size;
   127	    num_tensors++;
   128	  }
   129	
   130	  // When Vela optimizes a tflite file it will assign the tensors like this:
   131	  //
   132	  // +-------+------------------------+  +--------+-------------+
   133	  // | INPUT | Description            |  | OUTPUT | Description |
   134	  // +-------+------------------------+  +--------+-------------+
   135	  // |     0 | Ethos-U command stream |  |   0..m | Outputs     |
   136	  // |     1 | TFLM model             |  +--------+-------------+
   137	  // |     2 | TFLM arena             |
   138	  // |     3 | Ethos-U fast scratch   |
   139	  // |  4..n | Inputs                 |
   140	  // +-------+------------------------+
   141	  //
   142	  // This code will assign the NPU base addresses like this:
   143	  //
   144	  // +--------------+----------------------+
   145	  // | Base address | Description          |
   146	  // +--------------+----------------------+
   147	  // |            0 | TFLM model           |
   148	  // |            1 | TFLM arena           |
   149	  // |            2 | Ethos-U fast scratch |
   150	  // |         3..n | Input tensors        |
   151	  // |         n..m | Output tensors       |
   152	  // +--------------+----------------------+
   153	  //
   154	  // The number of base address will be limited to 8.
   155	  //
   156	  // NOTE! The command stream produced by Vela will access the IFM and OFM
   157	  // buffers using base address 1. This means that it is not possible to point
   158	  // the input and output tensors outside of the TFLM arena.
   159	  num_tensors = std::min(num_tensors, 8);
   160	
   161	  const uint32_t tcn_v6_call_index = ++tcn_v6_npu_invocation_index;
   162	  const int64_t tcn_v6_reserve_start_ms = k_uptime_get();
   163	  struct ethosu_driver *drv = ethosu_reserve_driver();
   164	  const uint32_t tcn_v6_reserve_ms = (uint32_t)(k_uptime_get() - tcn_v6_reserve_start_ms);
   165	  const uint32_t tcn_v6_irq_before = tcn_v6_ethosu_irq_count_get();
   166	  const int64_t tcn_v6_invoke_start_ms = k_uptime_get();
   167	  result = ethosu_invoke_v3(
   168	      drv, cms_data, data->cms_data_size, base_addrs,
   169	      base_addrs_size, num_tensors,
   170	      GetMicroContext(context)->external_context());
   171	  const uint32_t tcn_v6_invoke_ms = (uint32_t)(k_uptime_get() - tcn_v6_invoke_start_ms);
   172	  const uint32_t tcn_v6_irq_after = tcn_v6_ethosu_irq_count_get();
   173	  const uint32_t tcn_v6_irq_delta = tcn_v6_irq_after - tcn_v6_irq_before;
   174	  const int64_t tcn_v6_release_start_ms = k_uptime_get();
   175	  ethosu_release_driver(drv);
   176	  const uint32_t tcn_v6_release_ms = (uint32_t)(k_uptime_get() - tcn_v6_release_start_ms);
   177	  tcn_v6_npu_cumulative_invoke_ms += tcn_v6_invoke_ms;
   178	  tcn_v6_npu_cumulative_irq_delta += tcn_v6_irq_delta;
   179	  printk("TCN_V6_NPU_PROFILE: idx=%u status=%d drv_valid=%u "
   180	         "cmd_tensor_bytes=%d base_regions=%d reserve_ms=%u "
   181	         "invoke_ms=%u release_ms=%u irq_before=%u "
   182	         "irq_after=%u irq_delta=%u cumulative_invoke_ms=%u "
   183	         "cumulative_irq_delta=%u\n",
   184	         tcn_v6_call_index, result, (drv != nullptr) ? 1u : 0u,
   185	         data->cms_data_size, num_tensors, tcn_v6_reserve_ms,
   186	         tcn_v6_invoke_ms, tcn_v6_release_ms,
   187	         tcn_v6_irq_before, tcn_v6_irq_after,
   188	         tcn_v6_irq_delta, tcn_v6_npu_cumulative_invoke_ms,
   189	         tcn_v6_npu_cumulative_irq_delta);
   190	
   191	  if (-1 == result) {
   192	    return kTfLiteError;
   193	  } else {
   194	    return kTfLiteOk;
   195	  }
   196	}
