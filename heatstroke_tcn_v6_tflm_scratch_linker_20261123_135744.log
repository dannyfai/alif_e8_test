 695: TfLiteStatus MicroAllocator::RequestScratchBufferInArena(size_t bytes,
 696:                                                          int subgraph_idx,
 697:                                                          int* buffer_idx) {
 698:   // All scratch buffer requests are stored in the head section of the arena
 699:   // when a model is in the prepare phase. First align a scratch buffer request
 700:   // pointer to the start of the head:
 701:   internal::ScratchBufferRequest* requests = GetScratchBufferRequests();
 702: 
 703:   // Count the number of requested scratch buffers for the current node:
 704:   size_t current_node_request_count = 0;
 705:   for (size_t i = 0; i < scratch_buffer_request_count_; ++i) {
 706:     if (requests[i].node_idx == kUnassignedScratchBufferRequestIndex) {
 707:       ++current_node_request_count;
 708:     }
 709:   }
 710: 
 711:   // First, ensure that the per-kernel request has not exceeded the limit:
 712:   if (current_node_request_count >= kMaxScratchBuffersPerOp) {
 713:     MicroPrintf("Scratch buffer request exeeds limit per operator (%d)",
 714:                 kMaxScratchBuffersPerOp);
 715:     return kTfLiteError;
 716:   }
 717: 
 718:   // Initialize and assign values for the request at the current index:
 719:   internal::ScratchBufferRequest* current_request =
 720:       &requests[scratch_buffer_request_count_];
 721:   *current_request = {};
 722:   // Assign -1 as a sentinel value that will be updated when the node finishes
 723:   // allocating:
 724:   current_request->bytes = bytes;
 725:   current_request->node_idx = kUnassignedScratchBufferRequestIndex;
 726:   current_request->subgraph_idx = subgraph_idx;
 727: 
 728:   // Assign the current request index to the out-param:
 729:   *buffer_idx = scratch_buffer_request_count_;
 730: 
 731:   // Bump the request count to prepare for the next request:
 732:   ++scratch_buffer_request_count_;
 733:   return kTfLiteOk;
 734: }
