  40:   kNumAllocationTypes,  // must be last
  41: };
  42: 
  43: // Container for holding information about allocation recordings by a given
  44: // type. Each recording contains the number of bytes requested, the actual bytes
  45: // allocated (can defer from requested by alignment), and the number of items
  46: // allocated.
  47: struct RecordedAllocation {
  48:   size_t requested_bytes;
  49:   size_t used_bytes;
  50:   size_t count;
  51: };
  52: 
  53: // Utility subclass of MicroAllocator that records all allocations
  54: // inside the arena. A summary of allocations can be logged through the
  55: // ErrorReporter by invoking LogAllocations(). This special allocator requires
  56: // an instance of RecordingSingleArenaBufferAllocator to capture allocations in
  57: // the head and tail. Arena allocation recording can be retrieved by type
  58: // through the GetRecordedAllocation() function. This class should only be used
  59: // for auditing memory usage or integration testing.
  60: class RecordingMicroAllocator : public MicroAllocator {
  61:  public:
  62:   static RecordingMicroAllocator* Create(uint8_t* tensor_arena,
  63:                                          size_t arena_size);
  64: 
  65:   // Returns the fixed amount of memory overhead of RecordingMicroAllocator.
  66:   static size_t GetDefaultTailUsage();
  67: 
  68:   // Returns the recorded allocations information for a given allocation type.
  69:   RecordedAllocation GetRecordedAllocation(
  70:       RecordedAllocationType allocation_type) const;
  71: 
  72:   const RecordingSingleArenaBufferAllocator* GetSimpleMemoryAllocator() const;
  73: 
  74:   // Logs out through the ErrorReporter all allocation recordings by type
  75:   // defined in RecordedAllocationType.
  76:   void PrintAllocations() const;
  77: 
  78:   void* AllocatePersistentBuffer(size_t bytes) override;
