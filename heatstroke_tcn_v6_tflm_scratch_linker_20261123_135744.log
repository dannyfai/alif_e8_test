  28: size_t RecordingMicroAllocator::GetDefaultTailUsage() {
  29:   // RecordingMicroAllocator inherits from MicroAllocator and its tail usage is
  30:   // similar with MicroAllocator with SingleArenaBufferAllocator and
  31:   // MicroAllocator being replaced.
  32:   return MicroAllocator::GetDefaultTailUsage(
  33:              /*is_memory_planner_given=*/false) +
  34:          AlignSizeUp<RecordingSingleArenaBufferAllocator>() -
  35:          AlignSizeUp<SingleArenaBufferAllocator>() +
  36:          AlignSizeUp<RecordingMicroAllocator>() - AlignSizeUp<MicroAllocator>();
  37: }
  38: 
  39: RecordingMicroAllocator::RecordingMicroAllocator(
  40:     RecordingSingleArenaBufferAllocator* recording_memory_allocator,
  41:     MicroMemoryPlanner* memory_planner)
  42:     : MicroAllocator(recording_memory_allocator, memory_planner),
  43:       recording_memory_allocator_(recording_memory_allocator) {}
  44: 
  45: RecordingMicroAllocator* RecordingMicroAllocator::Create(uint8_t* tensor_arena,
  46:                                                          size_t arena_size) {
  47:   RecordingSingleArenaBufferAllocator* simple_memory_allocator =
  48:       RecordingSingleArenaBufferAllocator::Create(tensor_arena, arena_size);
  49:   TFLITE_DCHECK(simple_memory_allocator != nullptr);
  50: 
  51:   uint8_t* memory_planner_buffer =
  52:       simple_memory_allocator->AllocatePersistentBuffer(
  53:           sizeof(GreedyMemoryPlanner), alignof(GreedyMemoryPlanner));
  54:   GreedyMemoryPlanner* memory_planner =
  55:       new (memory_planner_buffer) GreedyMemoryPlanner();
  56: 
  57:   uint8_t* allocator_buffer = simple_memory_allocator->AllocatePersistentBuffer(
  58:       sizeof(RecordingMicroAllocator), alignof(RecordingMicroAllocator));
  59:   RecordingMicroAllocator* allocator = new (allocator_buffer)
  60:       RecordingMicroAllocator(simple_memory_allocator, memory_planner);
  61:   return allocator;
  62: }
