 757:   TF_LITE_ENSURE_STATUS(non_persistent_buffer_allocator_->ResizeBuffer(
 758:       scratch_buffer_head_,
 759:       sizeof(internal::ScratchBufferRequest) *
 760:           (scratch_buffer_request_count_ + kMaxScratchBuffersPerOp),
 761:       alignof(internal::ScratchBufferRequest)));
 762: 
 763:   return kTfLiteOk;
 764: }
