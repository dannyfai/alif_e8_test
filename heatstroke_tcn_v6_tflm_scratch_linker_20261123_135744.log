 153: TfLiteStatus RecordingMicroAllocator::AllocateNodeAndRegistrations(
 154:     const Model* model, SubgraphAllocations* subgraph_allocations) {
 155:   RecordedAllocation allocations = SnapshotAllocationUsage();
 156: 
 157:   TfLiteStatus status =
 158:       MicroAllocator::AllocateNodeAndRegistrations(model, subgraph_allocations);
 159: 
 160:   RecordAllocationUsage(allocations,
 161:                         recorded_node_and_registration_array_data_);
 162: 
 163:   for (size_t subgraph_idx = 0; subgraph_idx < model->subgraphs()->size();
 164:        subgraph_idx++) {
 165:     // The allocation count in SingleArenaBufferAllocator will only be 1. To
 166:     // provide better logging, decrement by 1 and add in the actual number of
 167:     // operators used in the graph: The allocation for this recording will
 168:     // always be 1. This is because the parent class mallocs one large
 169:     // allocation for the number of nodes in the graph (e.g.
 170:     // sizeof(NodeAndRegistration) * num_nodes). To prevent extra overhead and
 171:     // potential for fragmentation, manually adjust the accounting by
 172:     // decrementing by 1 and adding the actual number of nodes used in the
 173:     // graph:
 174:     if (model->subgraphs()->Get(subgraph_idx)->operators()) {
 175:       recorded_node_and_registration_array_data_.count +=
 176:           model->subgraphs()->Get(subgraph_idx)->operators()->size() - 1;
 177:     } else {
 178:       recorded_node_and_registration_array_data_.count -= 1;
 179:     }
 180:   }
 181:   return status;
 182: }
 183: 
 184: TfLiteStatus RecordingMicroAllocator::AllocateTfLiteEvalTensors(
 185:     const Model* model, SubgraphAllocations* subgraph_allocations) {
 186:   RecordedAllocation allocations = SnapshotAllocationUsage();
 187: 
 188:   TfLiteStatus status =
 189:       MicroAllocator::AllocateTfLiteEvalTensors(model, subgraph_allocations);
 190: 
 191:   RecordAllocationUsage(allocations, recorded_tflite_eval_tensor_data_);
 192: 
 193:   for (size_t subgraph_idx = 0; subgraph_idx < model->subgraphs()->size();
 194:        subgraph_idx++) {
 195:     // The allocation for this recording will always be 1. This is because the
 196:     // parent class mallocs one large allocation for the number of tensors in
 197:     // the graph (e.g. sizeof(TfLiteEvalTensor) * num_tensors). To prevent extra
 198:     // overhead and potential for fragmentation, manually adjust the accounting
 199:     // by decrementing by 1 and adding the actual number of tensors used in the
 200:     // graph:
 201:     recorded_tflite_eval_tensor_data_.count +=
 202:         model->subgraphs()->Get(subgraph_idx)->tensors()->size() - 1;
 203:   }
 204:   return status;
 205: }
