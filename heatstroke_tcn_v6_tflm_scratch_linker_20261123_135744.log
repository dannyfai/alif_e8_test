  98: bool ethosu_dev_init(struct ethosu_device *dev, void *base_address, uint32_t secure_enable, uint32_t privilege_enable)
  99: {
 100:     dev->reg        = (volatile struct NPU_REG *)base_address;
 101:     dev->secure     = secure_enable;
 102:     dev->privileged = privilege_enable;
 103: 
 104: #ifdef ETHOSU55
 105:     if (dev->reg->CONFIG.product != ETHOSU_PRODUCT_U55)
 106: #else
 107:     if (dev->reg->CONFIG.product != ETHOSU_PRODUCT_U65)
 108: #endif
 109:     {
 110:         LOG_ERR("Failed to initialize device. Driver has not been compiled for this product");
 111:         return false;
 112:     }
 113: 
 114:     // Make sure the NPU is in a known state
 115:     if (ethosu_dev_soft_reset(dev) != ETHOSU_SUCCESS)
 116:     {
 117:         return false;
 118:     }
 119: 
 120:     return true;
 121: }
