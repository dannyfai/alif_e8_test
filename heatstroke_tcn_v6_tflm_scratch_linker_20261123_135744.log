 736: TfLiteStatus MicroAllocator::FinishPrepareNodeAllocations(int node_id) {
 737:   // When a node has finished preparing, all temp allocations performed by the
 738:   // kernel should be cleaned up:
 739:   TF_LITE_ENSURE_STATUS(ResetTempAllocations());
 740: 
 741:   // Find and update any new scratch buffer requests for the current node:
 742:   internal::ScratchBufferRequest* requests = GetScratchBufferRequests();
 743: 
 744:   for (size_t i = 0; i < scratch_buffer_request_count_; ++i) {
 745:     // A request with a node_idx of -1 is a sentinel value used to indicate this
 746:     // was a new request for the current node. The allocator finally knows the
 747:     // node index at this point. Assign the value and update the list of new
 748:     // requests so the head section can be adjusted to allow for the next kernel
 749:     // to allocate at most kMaxScratchBuffersPerOp requests:
 750:     if (requests[i].node_idx == kUnassignedScratchBufferRequestIndex) {
 751:       requests[i].node_idx = node_id;
 752:     }
 753:   }
 754: 
 755:   // Ensure that the head is re-adjusted to allow for another at-most
