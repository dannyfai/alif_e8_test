  64: RecordedAllocation RecordingMicroAllocator::GetRecordedAllocation(
  65:     RecordedAllocationType allocation_type) const {
  66:   switch (allocation_type) {
  67:     case RecordedAllocationType::kTfLiteEvalTensorData:
  68:       return recorded_tflite_eval_tensor_data_;
  69:     case RecordedAllocationType::kPersistentTfLiteTensorData:
  70:       return recorded_persistent_tflite_tensor_data_;
  71:     case RecordedAllocationType::kPersistentTfLiteTensorQuantizationData:
  72:       return recorded_persistent_tflite_tensor_quantization_data_;
  73:     case RecordedAllocationType::kPersistentBufferData:
  74:       return recorded_persistent_buffer_data_;
  75:     case RecordedAllocationType::kTfLiteTensorVariableBufferData:
  76:       return recorded_tflite_tensor_variable_buffer_data_;
  77:     case RecordedAllocationType::kNodeAndRegistrationArray:
  78:       return recorded_node_and_registration_array_data_;
  79:     case RecordedAllocationType::kOpData:
  80:       return recorded_op_data_;
  81: #ifdef USE_TFLM_COMPRESSION
  82:     case RecordedAllocationType::kCompressionData:
  83:       return recorded_compression_data_;
  84: #endif  // USE_TFLM_COMPRESSION
  85:     default:
  86:       break;
  87:   }
  88:   MicroPrintf("Invalid allocation type supplied: %d", allocation_type);
  89:   return RecordedAllocation();
  90: }
