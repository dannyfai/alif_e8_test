  80:  protected:
  81:   TfLiteStatus AllocateNodeAndRegistrations(
  82:       const Model* model, SubgraphAllocations* subgraph_allocations) override;
  83:   TfLiteStatus AllocateTfLiteEvalTensors(
  84:       const Model* model, SubgraphAllocations* subgraph_allocations) override;
  85:   TfLiteStatus AllocateVariables(
  86:       const SubGraph* subgraph, TfLiteEvalTensor* eval_tensors,
  87:       const int32_t* offline_planner_offsets) override;
  88:   // TODO(b/162311891): Once all kernels have been updated to the new API drop
  89:   // this method. It is only used to record TfLiteTensor persistent allocations.
  90:   TfLiteTensor* AllocatePersistentTfLiteTensorInternal() override;
  91: 
  92:   // TODO(b/162311891): Once all kernels have been updated to the new API drop
