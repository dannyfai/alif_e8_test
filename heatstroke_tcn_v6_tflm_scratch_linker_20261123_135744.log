  64: uint64_t __attribute__((weak)) ethosu_address_remap(uint64_t address, int index)
  65: {
  66:     (void)(index);
  67:     return address;
  68: }
  69: 
  70: unsigned int __attribute__((weak)) ethosu_config_select(uint64_t address, int index)
  71: {
  72:     (void)(address);
  73:     assert(index >= -1 && index <= 7);
  74:     switch (index)
  75:     {
  76:     case -1:
  77:         return NPU_QCONFIG;
  78:     default:
  79:     case 0:
  80:         return NPU_REGIONCFG_0;
  81:     case 1:
  82:         return NPU_REGIONCFG_1;
  83:     case 2:
  84:         return NPU_REGIONCFG_2;
  85:     case 3:
  86:         return NPU_REGIONCFG_3;
  87:     case 4:
  88:         return NPU_REGIONCFG_4;
  89:     case 5:
  90:         return NPU_REGIONCFG_5;
  91:     case 6:
  92:         return NPU_REGIONCFG_6;
  93:     case 7:
  94:         return NPU_REGIONCFG_7;
  95:     }
  96: }
