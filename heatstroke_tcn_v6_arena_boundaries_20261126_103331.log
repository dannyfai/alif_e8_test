    40	void* Init(TfLiteContext* context, const char* buffer, size_t length) {
    41	  TFLITE_DCHECK(context->AllocatePersistentBuffer != nullptr);
    42	  return context->AllocatePersistentBuffer(context, sizeof(OpData));
