  280: void MainLoop()
  281: {
  282:     using arm::app::fwk::iface::MemoryRegion;
  283:     using heatstroke_tcn_v6::TcnV6Model;
  284: 
  285:     printk("TCN_V6: activation_buf=%p capacity=%u bytes\n",
  286:            activationBuf,
  287:            static_cast<unsigned int>(sizeof(activationBuf)));
  288: 
  289:     const uint8_t* model_pointer =
  290:         arm::app::polyu_heatstroke::GetModelPointer();
  291:     const size_t model_length =
  292:         arm::app::polyu_heatstroke::GetModelLen();
  293: 
  294:     if (model_pointer == nullptr || model_length == 0U) {
  295:         printk("TCN_V6_ERROR: generated model pointer/length invalid\n");
  296:         return;
  297:     }
  298: 
  299:     printk("TCN_V6_MODEL: pointer=%p bytes=%u\n",
  300:            model_pointer,
  301:            static_cast<unsigned int>(model_length));
  302: 
  303:     MemoryRegion compute_buffer(activationBuf, sizeof(activationBuf));
  304:     MemoryRegion model_buffer(
  305:         const_cast<uint8_t*>(model_pointer), model_length);
  306: 
  307:     static TcnV6Model model;
  308: 
  309:     if (!model.PrepareResolver()) {
  310:         printk("TCN_V6_ERROR: resolver preparation failed\n");
  311:         return;
  312:     }
  313: 
  314:     printk("TCN_V6: initializing TFLM model\n");
  315: 
  316:     if (!model.Init(compute_buffer, model_buffer)) {
  317:         printk("TCN_V6_ERROR: TFLM model initialization/AllocateTensors failed\n");
  318:         return;
  319:     }
  320: 
  321:     if (model.GetNumInputs() != kInputCount ||
  322:         model.GetNumOutputs() != 1U) {
  323:         printk("TCN_V6_ERROR: model interface count mismatch inputs=%u outputs=%u\n",
  324:                static_cast<unsigned int>(model.GetNumInputs()),
  325:                static_cast<unsigned int>(model.GetNumOutputs()));
  326:         return;
  327:     }
  328: 
  329:     auto* interpreter = model.GetBackendData().m_pInterpreter.get();
  330: 
  331:     if (!ValidateAndPopulateInputs(interpreter) ||
  332:         !ValidateOutput(interpreter)) {
  333:         printk("TCN_V6_ERROR: tensor interface validation failed\n");
  334:         return;
  335:     }
  336: 
  337:     printk("TCN_V6_ETHOSU: model_contains_ethosu=%u\n",
  338:            model.ContainsEthosUOperator() ? 1U : 0U);
  339: 
  340:     printk("TCN_V6_ARENA: used=%u capacity=%u bytes\n",
  341:            static_cast<unsigned int>(interpreter->arena_used_bytes()),
  342:            static_cast<unsigned int>(sizeof(activationBuf)));
  343: 
  344:     printk("TCN_V6: invoking sample317 real-input validation\n");
  345: 
  346:     const uint64_t start_cycles = k_cycle_get_64();
  347:     const bool inference_ok = model.RunInference();
  348:     const uint64_t elapsed_cycles = k_cycle_get_64() - start_cycles;
  349:     const uint64_t elapsed_us = k_cyc_to_us_floor64(elapsed_cycles);
  350: 
  351:     printk("TCN_V6_INFERENCE: success=%u cycles=%llu elapsed_us=%llu\n",
  352:            inference_ok ? 1U : 0U,
  353:            static_cast<unsigned long long>(elapsed_cycles),
  354:            static_cast<unsigned long long>(elapsed_us));
  355: 
  356:     if (!inference_ok) {
  357:         printk("TCN_V6_ERROR: Invoke failed\n");
  358:         return;
  359:     }
  360: 
  361:     if (!ValidateOutput(interpreter)) {
  362:         return;
  363:     }
  364: 
  365:     ReportOutput(interpreter);
  366: 
