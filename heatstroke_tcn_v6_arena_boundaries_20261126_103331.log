  178: TfLiteStatus AllocationInfoBuilder::InitializeAllocationInfo(
  179:     const int32_t* offline_offsets, SubgraphAllocations* allocations) {
  180:   AllocationInfo* allocation_info = info_.allocation_info;
  181:   // Initialize allocation info for every tensor in every subgraph.
  182:   int offline_index = 0;
  183:   for (size_t subgraph_idx = 0; subgraph_idx < model_->subgraphs()->size();
  184:        subgraph_idx++) {
  185:     const SubGraph* subgraph = model_->subgraphs()->Get(subgraph_idx);
  186:     TfLiteEvalTensor* eval_tensors = allocations[subgraph_idx].tensors;
  187:     AllocationInfo* subgraph_allocation_info =
  188:         &allocation_info[info_.subgraph_offsets[subgraph_idx]];
  189: 
  190:     // Ensure constraints are met.
  191:     TF_LITE_ENSURE_STATUS(ValidateSubgraph(subgraph, eval_tensors));
  192: 
  193:     for (size_t i = 0; i < subgraph->tensors()->size(); ++i) {
  194:       AllocationInfo* current = &subgraph_allocation_info[i];
  195:       current->output_ptr = &(eval_tensors[i].data.data);
  196: 
  197:       TF_LITE_ENSURE_STATUS(
  198:           TfLiteEvalTensorByteLength(&eval_tensors[i], &current->bytes));
  199: 
  200:       current->first_created = kUninitializedLifetime;
  201:       current->last_used = kUninitializedLifetime;
  202:       current->needs_allocating =
  203:           (eval_tensors[i].data.data == nullptr) &&
  204:           (!subgraph->tensors()->Get(i)->is_variable()) &&
  205:           (current->bytes != 0);
  206:       if (offline_offsets) {
  207:         current->offline_offset = offline_offsets[offline_index++];
  208: 
  209:         // Mark offline planned variable tensors so they can get an offline
  210:         // offset and be handled offline.
  211:         if (subgraph->tensors()->Get(i)->is_variable() &&
  212:             current->offline_offset != kOnlinePlannedBuffer) {
  213:           current->needs_allocating = true;
  214:         }
  215:       } else {
  216:         current->offline_offset = kOnlinePlannedBuffer;
  217:       }
  218:     }
  219:   }
  220:   // Initialize allocation info for every scratch buffer.
  221:   AllocationInfo* scratch_allocation_info =
  222:       &allocation_info[info_.scratch_offset];
  223:   for (size_t i = 0; i < info_.scratch_buffer_count; i++) {
  224:     AllocationInfo* current = &scratch_allocation_info[i];
  225:     current->first_created = kUninitializedLifetime;
  226:     current->last_used = kUninitializedLifetime;
  227:     current->needs_allocating = true;
  228:     current->offline_offset = kOnlinePlannedBuffer;
  229:   }
  230:   return kTfLiteOk;
  231: }
