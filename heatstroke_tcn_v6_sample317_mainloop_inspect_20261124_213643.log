    21	static uint8_t activationBuf[ACTIVATION_BUF_SZ] ACTIVATION_BUF_ATTRIBUTE;
    22	
    23	constexpr size_t kInputCount = 5;
    24	constexpr size_t kOutputElements = 900U * 6U;
    25	
    26	const int kExpectedRanks[kInputCount] = {3, 3, 3, 2, 3};
    27	
    28	const int kExpectedDimensions[kInputCount][3] = {
    29	    {1,  900,    6},
    30	    {1,  900,    6},
    31	    {1,  900,    3},
    32	    {1,   18,    0},
    33	    {1, 1800,    6}
    34	};
    35	
    36	const TfLiteType kExpectedTypes[kInputCount] = {
    37	    kTfLiteFloat32,
    38	    kTfLiteInt8,
    39	    kTfLiteFloat32,
    40	    kTfLiteFloat32,
    41	    kTfLiteFloat32
    42	};
    43	
    44	bool ValidateAndZeroInputs(tflite::MicroInterpreter* interpreter)
    45	{
    46	    if (interpreter == nullptr) {
    47	        printk("TCN_V6_ERROR: null interpreter\n");
    48	        return false;
    49	    }
    50	
    51	    for (size_t i = 0; i < kInputCount; ++i) {
    52	        TfLiteTensor* tensor = interpreter->input(i);
    53	
    54	        if (tensor == nullptr || tensor->dims == nullptr) {
    55	            printk("TCN_V6_ERROR: input %u missing metadata\n",
    56	                   static_cast<unsigned int>(i));
    57	            return false;
    58	        }
    59	
    60	        if (tensor->type != kExpectedTypes[i]) {
    61	            printk("TCN_V6_ERROR: input %u type=%d expected=%d\n",
    62	                   static_cast<unsigned int>(i),
    63	                   static_cast<int>(tensor->type),
    64	                   static_cast<int>(kExpectedTypes[i]));
    65	            return false;
    66	        }
    67	
    68	        if (tensor->dims->size != kExpectedRanks[i]) {
    69	            printk("TCN_V6_ERROR: input %u rank=%d expected=%d\n",
    70	                   static_cast<unsigned int>(i),
    71	                   tensor->dims->size,
    72	                   kExpectedRanks[i]);
    73	            return false;
    74	        }
    75	
    76	        for (int d = 0; d < kExpectedRanks[i]; ++d) {
    77	            if (tensor->dims->data[d] != kExpectedDimensions[i][d]) {
    78	                printk("TCN_V6_ERROR: input %u dim%u=%d expected=%d\n",
    79	                       static_cast<unsigned int>(i),
    80	                       static_cast<unsigned int>(d),
    81	                       tensor->dims->data[d],
    82	                       kExpectedDimensions[i][d]);
    83	                return false;
    84	            }
    85	        }
    86	
    87	        if (tensor->data.raw == nullptr || tensor->bytes == 0U) {
    88	            printk("TCN_V6_ERROR: input %u has no data buffer\n",
    89	                   static_cast<unsigned int>(i));
    90	            return false;
    91	        }
    92	
    93	        // This zero-fills the INT8 missing_mask input (0 = observed).
    94	        std::memset(tensor->data.raw, 0, tensor->bytes);
    95	
    96	        printk("TCN_V6_INPUT_%u: type=%d bytes=%u rank=%d shape=",
    97	               static_cast<unsigned int>(i),
    98	               static_cast<int>(tensor->type),
    99	               static_cast<unsigned int>(tensor->bytes),
   100	               tensor->dims->size);
   101	
   102	        for (int d = 0; d < tensor->dims->size; ++d) {
   103	            printk("%s%d", (d == 0) ? "" : "x", tensor->dims->data[d]);
   104	        }
   105	        printk(" zero_filled=1\n");
   106	    }
   107	
   108	    return true;
   109	}
   110	
   111	bool ValidateOutput(tflite::MicroInterpreter* interpreter)
   112	{
   113	    if (interpreter == nullptr) {
   114	        return false;
   115	    }
   116	
   117	    TfLiteTensor* output = interpreter->output(0);
   118	
   119	    if (output == nullptr || output->dims == nullptr ||
   120	        output->type != kTfLiteFloat32 ||
   121	        output->dims->size != 3 ||
   122	        output->dims->data[0] != 1 ||
   123	        output->dims->data[1] != 900 ||
   124	        output->dims->data[2] != 6 ||
   125	        output->bytes != kOutputElements * sizeof(float) ||
   126	        output->data.raw == nullptr) {
   127	        printk("TCN_V6_ERROR: output metadata mismatch\n");
   128	        return false;
   129	    }
   130	
   131	    printk("TCN_V6_OUTPUT: type=FP32 shape=[1,900,6] bytes=%u\n",
   132	           static_cast<unsigned int>(output->bytes));
   133	    return true;
   134	}
   135	
   136	void ReportOutput(tflite::MicroInterpreter* interpreter)
   137	{
   138	    TfLiteTensor* output = interpreter->output(0);
   139	    const float* values = reinterpret_cast<const float*>(output->data.raw);
   140	
   141	    float minimum = values[0];
   142	    float maximum = values[0];
   143	    double sum = 0.0;
   144	    size_t nonfinite = 0;
   145	
   146	    for (size_t i = 0; i < kOutputElements; ++i) {
   147	        const float value = values[i];
   148	
   149	        if (!std::isfinite(value)) {
   150	            ++nonfinite;
   151	            continue;
   152	        }
   153	
   154	        if (value < minimum) {
   155	            minimum = value;
   156	        }
   157	        if (value > maximum) {
   158	            maximum = value;
   159	        }
   160	        sum += static_cast<double>(value);
   161	    }
   162	
   163	    printk("TCN_V6_OUTPUT_STATS: elements=%u nonfinite=%u "
   164	           "min=%f max=%f mean=%f\n",
   165	           static_cast<unsigned int>(kOutputElements),
   166	           static_cast<unsigned int>(nonfinite),
   167	           static_cast<double>(minimum),
   168	           static_cast<double>(maximum),
   169	           sum / static_cast<double>(kOutputElements));
   170	}
