bool ValidateOutput(tflite::MicroInterpreter* interpreter)
{
    if (interpreter == nullptr) {
        return false;
    }

    TfLiteTensor* output = interpreter->output(0);

    if (output == nullptr || output->dims == nullptr ||
        output->type != kTfLiteFloat32 ||
        output->dims->size != 3 ||
        output->dims->data[0] != 1 ||
        output->dims->data[1] != 900 ||
        output->dims->data[2] != 6 ||
        output->bytes != kOutputElements * sizeof(float) ||
        output->data.raw == nullptr) {
        printk("TCN_V6_ERROR: output metadata mismatch\n");
        return false;
    }

    printk("TCN_V6_OUTPUT: type=FP32 shape=[1,900,6] bytes=%u\n",
           static_cast<unsigned int>(output->bytes));
    return true;
}

void ReportOutput(tflite::MicroInterpreter* interpreter)
{
    TfLiteTensor* output = interpreter->output(0);
    const float* values = reinterpret_cast<const float*>(output->data.raw);

    float minimum = values[0];
    float maximum = values[0];
    double sum = 0.0;
    size_t nonfinite = 0;

    for (size_t i = 0; i < kOutputElements; ++i) {
        const float value = values[i];

        if (!std::isfinite(value)) {
            ++nonfinite;
            continue;
        }

        if (value < minimum) {
            minimum = value;
        }
        if (value > maximum) {
            maximum = value;
        }
        sum += static_cast<double>(value);
    }

    printk("TCN_V6_OUTPUT_STATS: elements=%u nonfinite=%u "
           "min=%f max=%f mean=%f\n",
           static_cast<unsigned int>(kOutputElements),
           static_cast<unsigned int>(nonfinite),
           static_cast<double>(minimum),
           static_cast<double>(maximum),
           sum / static_cast<double>(kOutputElements));
}

} // namespace

void MainLoop()
{
    using arm::app::fwk::iface::MemoryRegion;
    using heatstroke_tcn_v6::TcnV6Model;

    printk("TCN_V6: activation_buf=%p capacity=%u bytes\n",
           activationBuf,
           static_cast<unsigned int>(sizeof(activationBuf)));

    const uint8_t* model_pointer =
        arm::app::polyu_heatstroke::GetModelPointer();
    const size_t model_length =
        arm::app::polyu_heatstroke::GetModelLen();

    if (model_pointer == nullptr || model_length == 0U) {
        printk("TCN_V6_ERROR: generated model pointer/length invalid\n");
        return;
    }

    printk("TCN_V6_MODEL: pointer=%p bytes=%u\n",
           model_pointer,
           static_cast<unsigned int>(model_length));

    MemoryRegion compute_buffer(activationBuf, sizeof(activationBuf));
    MemoryRegion model_buffer(
        const_cast<uint8_t*>(model_pointer), model_length);

    static TcnV6Model model;

    if (!model.PrepareResolver()) {
        printk("TCN_V6_ERROR: resolver preparation failed\n");
        return;
    }

    printk("TCN_V6: initializing TFLM model\n");

    if (!model.Init(compute_buffer, model_buffer)) {
        printk("TCN_V6_ERROR: TFLM model initialization/AllocateTensors failed\n");
        return;
    }

    if (model.GetNumInputs() != kInputCount ||
        model.GetNumOutputs() != 1U) {
        printk("TCN_V6_ERROR: model interface count mismatch inputs=%u outputs=%u\n",
               static_cast<unsigned int>(model.GetNumInputs()),
               static_cast<unsigned int>(model.GetNumOutputs()));
        return;
    }

    auto* interpreter = model.GetBackendData().m_pInterpreter.get();

    if (!ValidateAndZeroInputs(interpreter) ||
        !ValidateOutput(interpreter)) {
        printk("TCN_V6_ERROR: tensor interface validation failed\n");
        return;
    }

    printk("TCN_V6_ETHOSU: model_contains_ethosu=%u\n",
           model.ContainsEthosUOperator() ? 1U : 0U);

    printk("TCN_V6_ARENA: used=%u capacity=%u bytes\n",
           static_cast<unsigned int>(interpreter->arena_used_bytes()),
           static_cast<unsigned int>(sizeof(activationBuf)));

    printk("TCN_V6: invoking zero-input smoke inference\n");

    const uint64_t start_cycles = k_cycle_get_64();
    const bool inference_ok = model.RunInference();
    const uint64_t elapsed_cycles = k_cycle_get_64() - start_cycles;
    const uint64_t elapsed_us = k_cyc_to_us_floor64(elapsed_cycles);

    printk("TCN_V6_INFERENCE: success=%u cycles=%llu elapsed_us=%llu\n",
           inference_ok ? 1U : 0U,
           static_cast<unsigned long long>(elapsed_cycles),
           static_cast<unsigned long long>(elapsed_us));

    if (!inference_ok) {
        printk("TCN_V6_ERROR: Invoke failed\n");
        return;
    }

    if (!ValidateOutput(interpreter)) {
        return;
    }

    ReportOutput(interpreter);

    printk("TCN_V6_ARENA_FINAL: used=%u capacity=%u bytes\n",
           static_cast<unsigned int>(interpreter->arena_used_bytes()),
           static_cast<unsigned int>(sizeof(activationBuf)));

    printk("TCN_V6_SMOKE_TEST: PASS (zero inputs; not an accuracy test)\n");
}
