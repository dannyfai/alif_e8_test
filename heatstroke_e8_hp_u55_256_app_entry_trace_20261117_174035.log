   208	/**
   209	 * Configure LPGPIO0 and LPGPIO1 as inputs with interrupts
   210	 * With B1/E1C need to connect wire between SW5 (P5_7) and P15_0 to use button as Push-to-talk button.
   211	 * With B1/E1C devkit you need to also remove resistor R64. */
   212	static int configure_lpgpio(void)
   213	{
   214		int ret;
   215		const struct gpio_dt_spec *spec = &lpgpio_config;
   216	
   217		if (!spec || !spec->port) {
   218			/* Just ignore */
   219			LOG_ERR("lpgpio invalid");
   220			return -ENODEV;
   221		}
   222	
   223		/* Configure LPGPIO0 for wakeup */
   224		if (!gpio_is_ready_dt(spec)) {
   225			LOG_ERR("LPGPIO0 device is not ready");
   226			return -ENODEV;
   227		}
   228	
   229		ret = gpio_pin_configure_dt(spec, GPIO_INPUT | spec->dt_flags);
   230		if (ret != 0) {
   231			LOG_ERR("Failed to configure LPGPIO as input: %d", ret);
   232			return ret;
   233		}
   234	
   235		ret = gpio_pin_interrupt_configure_dt(spec,
   236						      GPIO_INT_EDGE_BOTH);
   237		if (ret != 0) {
   238			LOG_ERR("Failed to configure LPGPIO interrupt: %d", ret);
   239			return ret;
   240		}
   241	
   242		gpio_init_callback(&button_cb_data, button_callback, BIT(spec->pin));
   243		ret = gpio_add_callback(spec->port, &button_cb_data);
   244		if (ret != 0) {
   245			LOG_ERR("Failed to add button callback: %d", ret);
   246			return ret;
   247		}
   248	
   249		LOG_INF("LPGPIO%d configured", spec->pin);
   250	
   251		return 0;
   252	}
