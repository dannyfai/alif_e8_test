   212	void* HeatstrokeSumInit(
   213	    TfLiteContext* context,
   214	    const char* buffer,
   215	    size_t length)
   216	{
   217	    if (context == nullptr ||
   218	        context->AllocatePersistentBuffer == nullptr) {
   219	        return nullptr;
   220	    }
   221	
   222	    void* storage = context->AllocatePersistentBuffer(
   223	        context, sizeof(OpDataReduce));
   224	
   225	    if (storage == nullptr) {
   226	        return nullptr;
   227	    }
   228	
   229	    return new (storage) OpDataReduce{};
   230	}
   231	
   232	TfLiteStatus HeatstrokeSumPrepare(
   233	    TfLiteContext* context,
   234	    TfLiteNode* node)
   235	{
   236	    if (node == nullptr || node->user_data == nullptr) {
   237	        MicroPrintf("Heatstroke SUM: missing operator data.");
   238	        return kTfLiteError;
   239	    }
   240	
   241	    // Retain the stock preparation path for FP32 and quantized SUM.
   242	    // INT64 does not require its quantized scratch buffer.
   243	    return PrepareMeanOrSumHelper(
   244	        context,
   245	        node,
   246	        static_cast<OpDataReduce*>(node->user_data));
   247	}
   248	
   249	TfLiteStatus HeatstrokeSumInt64Eval(
   250	    TfLiteContext* context,
   251	    TfLiteNode* node,
   252	    const TfLiteEvalTensor* input,
   253	    const TfLiteEvalTensor* axis,
   254	    TfLiteEvalTensor* output)
   255	{
   256	    if (input == nullptr || axis == nullptr || output == nullptr ||
   257	        input->dims == nullptr || axis->dims == nullptr ||
   258	        output->dims == nullptr) {
   259	        return kTfLiteError;
   260	    }
   261	
   262	    if (output->type != kTfLiteInt64 ||
   263	        axis->type != kTfLiteInt32 ||
   264	        input->dims->size != 3) {
   265	        MicroPrintf("Heatstroke SUM INT64: unsupported tensor contract.");
   266	        return kTfLiteError;
   267	    }
   268	
   269	    size_t axis_count = 0U;
   270	    if (!GetElementCount(axis->dims, &axis_count) || axis_count != 1U) {
   271	        MicroPrintf("Heatstroke SUM INT64: expected one reduction axis.");
   272	        return kTfLiteError;
   273	    }
   274	
   275	    const int* axis_values = micro::GetTensorData<int>(axis);
   276	    if (axis_values == nullptr) {
   277	        return kTfLiteError;
   278	    }
   279	
   280	    int normalized_axis = axis_values[0];
   281	    if (normalized_axis < 0) {
   282	        normalized_axis += input->dims->size;
   283	    }
   284	
   285	    // This is the model's channel-wise valid-sample count:
   286	    // input [1,900,6], reduction axis 1, output [1,6].
   287	    if (normalized_axis != 1 ||
   288	        input->dims->data[0] != 1 ||
   289	        input->dims->data[1] != 900 ||
   290	        input->dims->data[2] != 6) {
   291	        MicroPrintf("Heatstroke SUM INT64: unexpected input shape or axis.");
   292	        return kTfLiteError;
   293	    }
   294	
   295	    const auto* params =
   296	        static_cast<const TfLiteReducerParams*>(node->builtin_data);
   297	
   298	    if (params == nullptr || params->keep_dims) {
   299	        MicroPrintf("Heatstroke SUM INT64: expected keep_dims=false.");
   300	        return kTfLiteError;
   301	    }
   302	
   303	    if (output->dims->size != 2 ||
   304	        output->dims->data[0] != 1 ||
   305	        output->dims->data[1] != 6) {
   306	        MicroPrintf("Heatstroke SUM INT64: unexpected output shape.");
   307	        return kTfLiteError;
   308	    }
   309	
   310	    const int64_t* source = micro::GetTensorData<int64_t>(input);
   311	    int64_t* destination = micro::GetTensorData<int64_t>(output);
   312	
   313	    if (source == nullptr || destination == nullptr) {
   314	        return kTfLiteError;
   315	    }
   316	
   317	    // Input is produced by CAST from a Boolean validity mask.
   318	    // Validate the expected 0/1 domain before counting it.
   319	    for (size_t i = 0U; i < 5400U; ++i) {
   320	        if (source[i] != 0 && source[i] != 1) {
   321	            MicroPrintf(
   322	                "Heatstroke SUM INT64: mask value is not Boolean.");
   323	            return kTfLiteError;
   324	        }
   325	    }
   326	
   327	    for (size_t channel = 0U; channel < 6U; ++channel) {
   328	        int64_t sum = 0;
   329	
   330	        for (size_t timestep = 0U; timestep < 900U; ++timestep) {
   331	            sum += source[timestep * 6U + channel];
   332	        }
   333	
   334	        destination[channel] = sum;
   335	    }
   336	
   337	    return kTfLiteOk;
   338	}
   339	
   340	TfLiteStatus HeatstrokeSumEval(
   341	    TfLiteContext* context,
   342	    TfLiteNode* node)
   343	{
   344	    if (context == nullptr || node == nullptr ||
   345	        node->user_data == nullptr) {
   346	        return kTfLiteError;
   347	    }
   348	
   349	    const TfLiteEvalTensor* input =
   350	        micro::GetEvalInput(context, node, 0);
   351	    TfLiteEvalTensor* output =
   352	        micro::GetEvalOutput(context, node, 0);
   353	
   354	    if (input == nullptr || output == nullptr) {
   355	        return kTfLiteError;
   356	    }
   357	
   358	    if (input->type != kTfLiteInt64) {
   359	        // Preserve the stock implementation and its FP32 accumulation
   360	        // order for the other SUM operators in this model.
   361	        return EvalSumHelper(
   362	            context,
   363	            node,
   364	            static_cast<OpDataReduce*>(node->user_data));
   365	    }
   366	
   367	    const TfLiteEvalTensor* axis =
   368	        micro::GetEvalInput(context, node, 1);
   369	
   370	    return HeatstrokeSumInt64Eval(
   371	        context, node, input, axis, output);
   372	}
