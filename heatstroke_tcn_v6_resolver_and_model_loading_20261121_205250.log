    55	 * Application-local Ethos-U runtime diagnostic.
    56	 * Reads NPU STATUS and NVIC IRQ 55 only; does not alter either.
    57	 */
    58	namespace {
    59	
    60	constexpr std::uintptr_t kHeatstrokeEthosuStatusAddress = 0x400E1004UL;
    61	constexpr IRQn_Type kHeatstrokeEthosuIrq =
    62	    static_cast<IRQn_Type>(55);
    63	
    64	struct k_work g_heatstrokeEthosuMonitorWork;
    65	struct k_timer g_heatstrokeEthosuMonitorTimer;
    66	
    67	void HeatstrokeEthosuMonitorWorkHandler(struct k_work* work)
    68	{
    69	    (void)work;
    70	
    71	    const auto* statusRegister =
    72	        reinterpret_cast<volatile const std::uint32_t*>(
    73	            kHeatstrokeEthosuStatusAddress);
    74	    const std::uint32_t status = *statusRegister;
    75	
    76	    const unsigned int enabled = static_cast<unsigned int>(
    77	        NVIC_GetEnableIRQ(kHeatstrokeEthosuIrq));
    78	    const unsigned int pending = static_cast<unsigned int>(
    79	        NVIC_GetPendingIRQ(kHeatstrokeEthosuIrq));
    80	    const unsigned int active = static_cast<unsigned int>(
    81	        NVIC_GetActive(kHeatstrokeEthosuIrq));
    82	
    83	    LOG_INF(
    84	        "ETHOSU_DIAG: status=0x%08x run=%u irq=%u bus=%u reset=%u "
    85	        "parse=%u end=%u pmu=%u wd=%u ecc=%u "
    86	        "IRQ55[en=%u pend=%u active=%u]",
    87	        static_cast<unsigned int>(status),
    88	        static_cast<unsigned int>((status >> 0U) & 1U),
    89	        static_cast<unsigned int>((status >> 1U) & 1U),
    90	        static_cast<unsigned int>((status >> 2U) & 1U),
    91	        static_cast<unsigned int>((status >> 3U) & 1U),
    92	        static_cast<unsigned int>((status >> 4U) & 1U),
    93	        static_cast<unsigned int>((status >> 5U) & 1U),
    94	        static_cast<unsigned int>((status >> 6U) & 1U),
    95	        static_cast<unsigned int>((status >> 7U) & 1U),
    96	        static_cast<unsigned int>((status >> 8U) & 1U),
    97	        enabled, pending, active);
    98	}
    99	
   100	void HeatstrokeEthosuMonitorTimerHandler(struct k_timer* timer)
   101	{
   102	    (void)timer;
   103	    (void)k_work_submit(&g_heatstrokeEthosuMonitorWork);
   104	}
   105	
   106	void StartHeatstrokeEthosuMonitor()
   107	{
   108	    k_work_init(
   109	        &g_heatstrokeEthosuMonitorWork,
   110	        HeatstrokeEthosuMonitorWorkHandler);
   111	
   112	    k_timer_init(
   113	        &g_heatstrokeEthosuMonitorTimer,
   114	        HeatstrokeEthosuMonitorTimerHandler,
   115	        nullptr);
   116	
   117	    const int initialSubmit =
   118	        k_work_submit(&g_heatstrokeEthosuMonitorWork);
   119	
   120	    if (initialSubmit < 0) {
   121	        LOG_WRN("ETHOSU_DIAG: initial snapshot submission failed: %d",
   122	                initialSubmit);
   123	    }
   124	
   125	    k_timer_start(
   126	        &g_heatstrokeEthosuMonitorTimer,
   127	        K_SECONDS(1),
   128	        K_SECONDS(1));
   129	
   130	    LOG_INF("ETHOSU_DIAG: runtime monitor started; interval=1000ms");
   131	}
