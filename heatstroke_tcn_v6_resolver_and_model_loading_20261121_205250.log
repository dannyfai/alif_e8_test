    16	
    17	// Check whether a dimension is included in the axis tensor.
    18	template <typename AxisType>
    19	bool IsDimensionReversed(
    20	    int dimension,
    21	    int rank,
    22	    const AxisType* axes,
    23	    int num_axes) {
    24	
    25	  for (int i = 0; i < num_axes; ++i) {
    26	    int axis = static_cast<int>(axes[i]);
    27	
    28	    // Normalize negative axes.
    29	    if (axis < 0) {
    30	      axis += rank;
    31	    }
    32	
    33	    if (axis == dimension) {
    34	      return true;
    35	    }
    36	  }
    37	
    38	  return false;
    39	}
    40	
    41	// Validate axis values.
    42	template <typename AxisType>
    43	bool ValidateAxes(
    44	    const AxisType* axes,
    45	    int num_axes,
    46	    int rank) {
    47	
    48	  for (int i = 0; i < num_axes; ++i) {
    49	    const int64_t axis = static_cast<int64_t>(axes[i]);
    50	
    51	    if (axis < -rank || axis >= rank) {
    52	      return false;
    53	    }
    54	  }
    55	
    56	  return true;
    57	}
    58	
    59	// Generic reverse implementation.
    60	template <typename T, typename AxisType>
    61	void ReverseTensor(
    62	    const T* input,
    63	    T* output,
    64	    const TfLiteIntArray* dims,
    65	    const AxisType* axes,
    66	    int num_axes,
    67	    int rank,
    68	    int num_elements) {
    69	
    70	  for (int out_index = 0;
    71	       out_index < num_elements;
    72	       ++out_index) {
    73	
    74	    int input_index = 0;
    75	
    76	    // Calculate the corresponding input offset.
    77	    for (int d = 0; d < rank; ++d) {
    78	
    79	      const int dim_size = dims->data[d];
    80	
    81	      int stride = 1;
    82	
    83	      for (int j = d + 1; j < rank; ++j) {
    84	        stride *= dims->data[j];
    85	      }
    86	
    87	      const int coordinate =
    88	          (out_index / stride) % dim_size;
    89	
    90	      const bool reverse = IsDimensionReversed(
    91	          d, rank, axes, num_axes);
    92	
    93	      const int input_coordinate =
    94	          reverse ? (dim_size - 1 - coordinate)
    95	                  : coordinate;
    96	
    97	      input_index += input_coordinate * stride;
    98	    }
    99	
   100	    output[out_index] = input[input_index];
   101	  }
   102	}
