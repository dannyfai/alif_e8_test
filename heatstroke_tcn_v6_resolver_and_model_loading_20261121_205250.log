   104	TfLiteStatus Prepare(
   105	    TfLiteContext* context,
   106	    TfLiteNode* node) {
   107	      
   108	  MicroContext* micro_context = GetMicroContext(context);
   109	
   110	  TF_LITE_ENSURE_EQ(context, NumInputs(node), 2);
   111	  TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
   112	
   113	  TfLiteTensor* input = micro_context->AllocateTempInputTensor(node, 0);
   114	  TfLiteTensor* axis = micro_context->AllocateTempInputTensor(node, 1);
   115	  TfLiteTensor* output = micro_context->AllocateTempOutputTensor(node, 0);
   116	
   117	  TF_LITE_ENSURE(context, input != nullptr);
   118	  TF_LITE_ENSURE(context, axis != nullptr);
   119	  TF_LITE_ENSURE(context, output != nullptr);
   120	
   121	  TF_LITE_ENSURE_EQ(context, input->type, output->type);
   122	
   123	  TF_LITE_ENSURE_EQ(
   124	      context, input->dims->size, output->dims->size);
   125	
   126	  for (int i = 0; i < input->dims->size; ++i) {
   127	    TF_LITE_ENSURE_EQ(
   128	        context,
   129	        input->dims->data[i],
   130	        output->dims->data[i]);
   131	  }
   132	
   133	  TF_LITE_ENSURE(
   134	      context,
   135	      axis->type == kTfLiteInt32 ||
   136	      axis->type == kTfLiteInt64);
   137	
   138	  micro_context->DeallocateTempTfLiteTensor(input);
   139	  micro_context->DeallocateTempTfLiteTensor(axis);
   140	  micro_context->DeallocateTempTfLiteTensor(output);
   141	
   142	  return kTfLiteOk;
   143	}
   144	
   145	template <typename T, typename AxisType>
   146	TfLiteStatus EvalTyped(
   147	    TfLiteContext* context,
   148	    const TfLiteTensor* input,
   149	    const TfLiteTensor* axis,
   150	    TfLiteTensor* output) {
   151	
   152	  const AxisType* axes =
   153	      GetTensorData<AxisType>(axis);
   154	
   155	  const int rank = input->dims->size;
   156	  const int num_axes = NumElements(axis);
   157	  const int num_elements = NumElements(input);
   158	
   159	  if (num_axes > 0) {
   160	    TF_LITE_ENSURE(context, axes != nullptr);
   161	
   162	    TF_LITE_ENSURE(
   163	        context,
   164	        ValidateAxes(axes, num_axes, rank));
   165	  }
   166	
   167	  const T* input_data = GetTensorData<T>(input);
   168	  T* output_data = GetTensorData<T>(output);
   169	
   170	  if (num_elements == 0) {
   171	    return kTfLiteOk;
   172	  }
   173	
   174	  TF_LITE_ENSURE(context, input_data != nullptr);
   175	  TF_LITE_ENSURE(context, output_data != nullptr);
   176	
   177	  ReverseTensor(
   178	      input_data,
   179	      output_data,
   180	      input->dims,
   181	      axes,
   182	      num_axes,
   183	      rank,
   184	      num_elements);
   185	
   186	  return kTfLiteOk;
   187	}
