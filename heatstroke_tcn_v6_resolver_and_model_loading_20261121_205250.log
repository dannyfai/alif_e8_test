   255	/** @brief   Verify input and output tensor are of certain min dimensions. */
   256	
   257	static bool VerifyOneTensor(
   258	    const char* label,
   259	    size_t index,
   260	    const std::shared_ptr<arm::app::fwk::iface::TensorIface>& tensor,
   261	    const std::vector<size_t>& expectedShape)
   262	{
   263	    using arm::app::fwk::iface::TensorType;
   264	
   265	    if (!tensor) {
   266	        LOG_ERR("%s[%u] tensor handle is null",
   267	                label, static_cast<unsigned int>(index));
   268	        return false;
   269	    }
   270	
   271	    const std::vector<size_t> actualShape = tensor->Shape();
   272	    if (actualShape != expectedShape) {
   273	        LOG_ERR("%s[%u] shape mismatch",
   274	                label, static_cast<unsigned int>(index));
   275	        return false;
   276	    }
   277	
   278	    if (tensor->Type() != TensorType::FP32) {
   279	        LOG_ERR("%s[%u] must be FP32; got %s",
   280	                label,
   281	                static_cast<unsigned int>(index),
   282	                arm::app::fwk::iface::GetTensorDataTypeName(tensor->Type()));
   283	        return false;
   284	    }
   285	
   286	    size_t expectedElements = 1U;
   287	    for (const size_t dimension : expectedShape) {
   288	        expectedElements *= dimension;
   289	    }
   290	
   291	    if (tensor->GetNumElements() != expectedElements ||
   292	        tensor->Bytes() != expectedElements * sizeof(float) ||
   293	        tensor->GetData() == nullptr) {
   294	        LOG_ERR("%s[%u] element count, byte size, or data pointer is invalid",
   295	                label, static_cast<unsigned int>(index));
   296	        return false;
   297	    }
   298	
   299	    LOG_INF("%s[%u]: FP32, elements=%u, bytes=%u",
   300	            label,
   301	            static_cast<unsigned int>(index),
   302	            static_cast<unsigned int>(tensor->GetNumElements()),
   303	            static_cast<unsigned int>(tensor->Bytes()));
   304	
   305	    return true;
   306	}
