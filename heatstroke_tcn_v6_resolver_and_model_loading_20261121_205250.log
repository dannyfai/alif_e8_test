   388	
   389	static int SmokeFloatToMicro(const float value)
   390	{
   391	    const double scaled = static_cast<double>(value) * 1000000.0;
   392	    if (scaled > 2147483647.0) {
   393	        return 2147483647;
   394	    }
   395	    if (scaled < -2147483648.0) {
   396	        return (-2147483647 - 1);
   397	    }
   398	    return static_cast<int>(scaled >= 0.0 ? scaled + 0.5 : scaled - 0.5);
   399	}
