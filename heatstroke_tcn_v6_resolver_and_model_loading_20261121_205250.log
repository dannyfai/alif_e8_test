   189	TfLiteStatus Eval(
   190	    TfLiteContext* context,
   191	    TfLiteNode* node) {
   192	
   193	  const TfLiteTensor* input =
   194	      GetInput(context, node, 0);
   195	
   196	  const TfLiteTensor* axis =
   197	      GetInput(context, node, 1);
   198	
   199	  TfLiteTensor* output =
   200	      GetOutput(context, node, 0);
   201	
   202	  TF_LITE_ENSURE(context, input != nullptr);
   203	  TF_LITE_ENSURE(context, axis != nullptr);
   204	  TF_LITE_ENSURE(context, output != nullptr);
   205	
   206	  if (axis->type == kTfLiteInt32) {
   207	
   208	    switch (input->type) {
   209	
   210	      case kTfLiteFloat32:
   211	        return EvalTyped<float, int32_t>(
   212	            context, input, axis, output);
   213	
   214	      case kTfLiteInt8:
   215	        return EvalTyped<int8_t, int32_t>(
   216	            context, input, axis, output);
   217	
   218	      case kTfLiteUInt8:
   219	        return EvalTyped<uint8_t, int32_t>(
   220	            context, input, axis, output);
   221	
   222	      case kTfLiteInt16:
   223	        return EvalTyped<int16_t, int32_t>(
   224	            context, input, axis, output);
   225	
   226	      case kTfLiteInt32:
   227	        return EvalTyped<int32_t, int32_t>(
   228	            context, input, axis, output);
   229	
   230	      default:
   231	        TF_LITE_KERNEL_LOG(
   232	            context,
   233	            "REVERSE_V2: Unsupported input type %d",
   234	            input->type);
   235	        return kTfLiteError;
   236	    }
   237	  }
   238	
   239	  if (axis->type == kTfLiteInt64) {
   240	
   241	    switch (input->type) {
   242	
   243	      case kTfLiteFloat32:
   244	        return EvalTyped<float, int64_t>(
   245	            context, input, axis, output);
   246	
   247	      case kTfLiteInt8:
   248	        return EvalTyped<int8_t, int64_t>(
   249	            context, input, axis, output);
   250	
   251	      case kTfLiteUInt8:
   252	        return EvalTyped<uint8_t, int64_t>(
   253	            context, input, axis, output);
   254	
   255	      case kTfLiteInt16:
   256	        return EvalTyped<int16_t, int64_t>(
   257	            context, input, axis, output);
   258	
   259	      case kTfLiteInt32:
   260	        return EvalTyped<int32_t, int64_t>(
   261	            context, input, axis, output);
   262	
   263	      default:
   264	        TF_LITE_KERNEL_LOG(
   265	            context,
   266	            "REVERSE_V2: Unsupported input type %d",
   267	            input->type);
   268	        return kTfLiteError;
   269	    }
   270	  }
   271	
   272	  return kTfLiteError;
   273	}
