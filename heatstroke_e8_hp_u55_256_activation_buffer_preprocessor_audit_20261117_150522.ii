template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> operator-( FixedPoint<tRawType, tIntegerBits> a) { return FixedPoint<tRawType, tIntegerBits>::FromRaw(Neg(a.raw())); }
template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> operator~( FixedPoint<tRawType, tIntegerBits> a) { return FixedPoint<tRawType, tIntegerBits>::FromRaw(BitNot(a.raw())); }
template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> operator+( FixedPoint<tRawType, tIntegerBits> a, FixedPoint<tRawType, tIntegerBits> b) { return FixedPoint<tRawType, tIntegerBits>::FromRaw( Add(a.raw(), b.raw())); }
template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> operator-( FixedPoint<tRawType, tIntegerBits> a, FixedPoint<tRawType, tIntegerBits> b) { return FixedPoint<tRawType, tIntegerBits>::FromRaw( Sub(a.raw(), b.raw())); }
template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> operator&( FixedPoint<tRawType, tIntegerBits> a, FixedPoint<tRawType, tIntegerBits> b) { return FixedPoint<tRawType, tIntegerBits>::FromRaw( BitAnd(a.raw(), b.raw())); }
template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> operator^( FixedPoint<tRawType, tIntegerBits> a, FixedPoint<tRawType, tIntegerBits> b) { return FixedPoint<tRawType, tIntegerBits>::FromRaw( BitXor(a.raw(), b.raw())); }
template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> operator|( FixedPoint<tRawType, tIntegerBits> a, FixedPoint<tRawType, tIntegerBits> b) { return FixedPoint<tRawType, tIntegerBits>::FromRaw( BitOr(a.raw(), b.raw())); }
template <typename tRawType, int tIntegerBits> FixedPoint<tRawType, tIntegerBits> RoundingHalfSum( FixedPoint<tRawType, tIntegerBits> a, FixedPoint<tRawType, tIntegerBits> b) { return FixedPoint<tRawType, tIntegerBits>::FromRaw( RoundingHalfSum(a.raw(), b.raw())); }
