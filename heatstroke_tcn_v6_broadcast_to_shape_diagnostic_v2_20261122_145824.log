EXPECTED_SHA="4731f162c51ed9c48e630aff6acb2136484e70656aae8fc8f439050c0adad870"

TAG="$(date +%Y%m%d_%H%M%S)"
OUTPUT="${SOURCE%.tflite}_broadcast_shape_constfix_${TAG}.tflite"
LOG="$LOGDIR/heatstroke_tcn_v6_broadcast_shape_constfix_${TAG}.log"

mkdir -p "$LOGDIR"
exec > >(tee -a "$LOG") 2>&1

echo "============================================================"
echo "TCN V6 BROADCAST_TO CONSTANT-SHAPE PATCH"
echo "Date: $(date)"
