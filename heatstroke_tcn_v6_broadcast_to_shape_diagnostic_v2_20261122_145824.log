else
    "$PYTHON" - "$SOURCE" "$OUTPUT" "$EXPECTED_SHA" <<'PY'
import os
import sys
import hashlib
import struct
import traceback

import numpy as np
import flatbuffers
from tensorflow.lite.python import schema_py_generated as fb

source, output, expected_sha = sys.argv[1:4]

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()

def enum_names(cls):
    result = {}
    for name in dir(cls):
        if name.isupper():
            value = getattr(cls, name, None)
            if isinstance(value, int):
                result[value] = name
    return result

OP_NAMES = enum_names(fb.BuiltinOperator)
TYPE_NAMES = enum_names(fb.TensorType)

def tensor_shape(t):
    try:
        return [int(t.Shape(i)) for i in range(t.ShapeLength())]
    except Exception:
        return []

def tensor_data(model, tensor):
    b = model.Buffers(tensor.Buffer())
    data = b.DataAsNumpy()
    if data is None:
        return b""
    return np.asarray(data, dtype=np.uint8).tobytes()

def read_int_vector(model, tid):
    t = model.Subgraphs(0).Tensors(tid)
    type_name = TYPE_NAMES.get(int(t.Type()), "UNKNOWN")
    raw = tensor_data(model, t)

    if type_name == "INT64" and len(raw) % 8 == 0:
        return np.frombuffer(raw, dtype="<i8").astype(np.int64).tolist()

    if type_name == "INT32" and len(raw) % 4 == 0:
        return np.frombuffer(raw, dtype="<i4").astype(np.int64).tolist()

    raise RuntimeError(
        f"Tensor {tid} is not a readable INT32/INT64 constant: "
        f"type={type_name}, bytes={len(raw)}"
    )

def broadcast_shapes(a, b):
    n = max(len(a), len(b))
    aa = [1] * (n - len(a)) + list(a)
    bb = [1] * (n - len(b)) + list(b)
    result = []

    for x, y in zip(aa, bb):
        if x == y:
            result.append(x)
        elif x == 1:
            result.append(y)
        elif y == 1:
            result.append(x)
        else:
            raise RuntimeError(
                f"Shapes are incompatible: {a} and {b}"
            )
    return result

def read_operators(model):
    sg = model.Subgraphs(0)
    result = []

    for i in range(sg.OperatorsLength()):
        op = sg.Operators(i)
        code = model.OperatorCodes(op.OpcodeIndex())
        code_value = int(code.BuiltinCode())

        placeholder = getattr(
            fb.BuiltinOperator,
            "PLACEHOLDER_FOR_GREATER_OP_CODES",
            -1
        )
        if code_value == placeholder:
            code_value = int(code.DeprecatedBuiltinCode())

        result.append({
            "index": i,
            "op": op,
            "name": OP_NAMES.get(code_value, f"BUILTIN_{code_value}"),
            "version": int(code.Version()),
            "inputs": [
                int(op.Inputs(j)) for j in range(op.InputsLength())
            ],
            "outputs": [
                int(op.Outputs(j)) for j in range(op.OutputsLength())
            ],
        })

    return result

def custom_ethosu_signature(model):
    sg = model.Subgraphs(0)
    result = []

    for i in range(sg.OperatorsLength()):
        op = sg.Operators(i)
        code = model.OperatorCodes(op.OpcodeIndex())
        code_value = int(code.BuiltinCode())

        if code_value == int(fb.BuiltinOperator.CUSTOM):
            custom_name = code.CustomCode()
            if custom_name == b"ethos-u":
                options = op.CustomOptionsAsNumpy()
                options_bytes = (
                    np.asarray(options, dtype=np.uint8).tobytes()
                    if options is not None else b""
                )
                result.append((
                    tuple(int(op.Inputs(j))
                          for j in range(op.InputsLength())),
                    tuple(int(op.Outputs(j))
                          for j in range(op.OutputsLength())),
                    options_bytes
                ))

    return result

def main():
    if os.path.exists(output):
        raise RuntimeError(
            f"Refusing to overwrite an existing file: {output}"
        )

    source_sha = sha256_file(source)
    print("SOURCE_SHA256:", source_sha)

    if source_sha != expected_sha:
        raise RuntimeError("Source model SHA256 does not match expected model.") 

    raw = open(source, "rb").read()
    model = fb.Model.GetRootAsModel(raw, 0)
    sg = model.Subgraphs(0)

    print("MODEL_VERSION:", model.Version())
    print("OPERATORS:", sg.OperatorsLength())
    print("TENSORS:", sg.TensorsLength())
    print("BUFFERS:", model.BuffersLength())

    if sg.OperatorsLength() != 266:
        raise RuntimeError("Unexpected operator count.")

    ops = read_operators(model)

    broadcast_args = [
        x for x in ops if x["name"] == "BROADCAST_ARGS"
    ]
    broadcast_to = [
        x for x in ops if x["name"] == "BROADCAST_TO"
    ]

    if len(broadcast_args) != 1 or len(broadcast_to) != 1:
        raise RuntimeError(
            "Expected exactly one BROADCAST_ARGS and one BROADCAST_TO."
        )

    args_op = broadcast_args[0]
    to_op = broadcast_to[0]

    print()
    print("BROADCAST_ARGS_NODE:", args_op["index"])
    print("BROADCAST_ARGS_INPUTS:", args_op["inputs"])
    print("BROADCAST_ARGS_OUTPUTS:", args_op["outputs"])
    print("BROADCAST_TO_NODE:", to_op["index"])
    print("BROADCAST_TO_INPUTS:", to_op["inputs"])
    print("BROADCAST_TO_OUTPUTS:", to_op["outputs"])

    if len(args_op["inputs"]) != 2 or len(args_op["outputs"]) != 1:
        raise RuntimeError("Unexpected BROADCAST_ARGS signature.")

    if len(to_op["inputs"]) != 2 or len(to_op["outputs"]) != 1:
        raise RuntimeError("Unexpected BROADCAST_TO signature.")

    old_shape_tid = to_op["inputs"][1]
    if old_shape_tid != args_op["outputs"][0]:
        raise RuntimeError(
            "BROADCAST_TO shape input is not the BROADCAST_ARGS output."
        )

    # Validate the two shape operands are embedded constants.
    shape_a_tid, shape_b_tid = args_op["inputs"]

    sg_raw = model.Subgraphs(0)
    ta = sg_raw.Tensors(shape_a_tid)
    tb = sg_raw.Tensors(shape_b_tid)

    if int(ta.Buffer()) == 0 or int(tb.Buffer()) == 0:
        raise RuntimeError(
            "BROADCAST_ARGS inputs are not both embedded constants."
        )

    shape_a = read_int_vector(model, shape_a_tid)
    shape_b = read_int_vector(model, shape_b_tid)
    target_shape = broadcast_shapes(shape_a, shape_b)

    print()
    print("BROADCAST_ARGS_INPUT_A:", shape_a)
    print("BROADCAST_ARGS_INPUT_B:", shape_b)
    print("COMPUTED_CONSTANT_TARGET:", target_shape)

    if target_shape != [1, 900, 6]:
        raise RuntimeError(
            f"Unexpected computed target shape: {target_shape}"
        )

    input_tid = to_op["inputs"][0]
    input_shape = tensor_shape(sg_raw.Tensors(input_tid))
    output_tid = to_op["outputs"][0]
    output_shape = tensor_shape(sg_raw.Tensors(output_tid))

    print("BROADCAST_TO_DATA_SHAPE:", input_shape)
    print("BROADCAST_TO_OUTPUT_DECLARED_SHAPE:", output_shape)

    if input_shape != [1, 1, 6]:
        raise RuntimeError("Unexpected BROADCAST_TO data input shape.")

    if output_shape != target_shape:
        raise RuntimeError(
            "Computed target does not match declared output shape."
        )

