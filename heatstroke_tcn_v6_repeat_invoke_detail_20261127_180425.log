=== MAINLOOP INVOKE REGION ===
           static_cast<unsigned int>(model_length));

    MemoryRegion compute_buffer(activationBuf, sizeof(activationBuf));
    MemoryRegion model_buffer(
        const_cast<uint8_t*>(model_pointer), model_length);

    static TcnV6Model model;

    if (!model.PrepareResolver()) {
        printk("TCN_V6_ERROR: resolver preparation failed\n");
        return;
    }

    printk("TCN_V6: initializing TFLM model\n");

    if (!model.Init(compute_buffer, model_buffer)) {
        printk("TCN_V6_ERROR: TFLM model initialization/AllocateTensors failed\n");
        return;
    }

    if (model.GetNumInputs() != kInputCount ||
        model.GetNumOutputs() != 1U) {
        printk("TCN_V6_ERROR: model interface count mismatch inputs=%u outputs=%u\n",
               static_cast<unsigned int>(model.GetNumInputs()),
               static_cast<unsigned int>(model.GetNumOutputs()));
        return;
    }

    auto* interpreter = model.GetBackendData().m_pInterpreter.get();

    if (!ValidateAndPopulateInputs(interpreter) ||
        !ValidateOutput(interpreter)) {
        printk("TCN_V6_ERROR: tensor interface validation failed\n");
        return;
    }

    printk("TCN_V6_ETHOSU: model_contains_ethosu=%u\n",
           model.ContainsEthosUOperator() ? 1U : 0U);

    printk("TCN_V6_ARENA: used=%u capacity=%u bytes\n",
           static_cast<unsigned int>(interpreter->arena_used_bytes()),
           static_cast<unsigned int>(sizeof(activationBuf)));

    printk("TCN_V6: invoking sample317 real-input validation\n");

    const uint64_t start_cycles = k_cycle_get_64();
    const bool inference_ok = model.RunInference();
    const uint64_t elapsed_cycles = k_cycle_get_64() - start_cycles;
    const uint64_t elapsed_us = k_cyc_to_us_floor64(elapsed_cycles);

    printk("TCN_V6_INFERENCE: success=%u cycles=%llu elapsed_us=%llu\n",
           inference_ok ? 1U : 0U,
           static_cast<unsigned long long>(elapsed_cycles),
           static_cast<unsigned long long>(elapsed_us));

    if (!inference_ok) {
        printk("TCN_V6_ERROR: Invoke failed\n");
        return;
    }

    if (!ValidateOutput(interpreter)) {
        return;
    }

    ReportOutput(interpreter);

    printk("TCN_V6_ARENA_FINAL: used=%u capacity=%u bytes\n",
           static_cast<unsigned int>(interpreter->arena_used_bytes()),
           static_cast<unsigned int>(sizeof(activationBuf)));

    printk("TCN_V6_SAMPLE317_RUN: FINISHED (inspect numerical comparison metrics)\n");
}

=== ETHOS-U KERNEL: ADDRESS PREPARATION / INVOKE ===

  const uint8_t* custom_data =
      static_cast<uint8_t const*>(node->custom_initial_data);
  auto root = flexbuffers::GetRoot(custom_data, node->custom_initial_data_size);
  co_type = root.AsInt8();
  if (co_type != CO_TYPE_ETHOSU) {
    MicroPrintf("CO_TYPE != ETHOSU");
    return kTfLiteError;
  }

  // Get command stream data address.
  tensor = context->GetEvalTensor(context, node->inputs->data[0]);
  cms_data = reinterpret_cast<void*>(tensor->data.uint8);

  // Get addresses to weights/scratch/input data.
  for (i = 1; i < node->inputs->size; ++i) {
    tensor = context->GetEvalTensor(context, node->inputs->data[i]);
    base_addrs[num_tensors] =
        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(tensor->data.uint8));
    size_t byte_size = 1;
    for (int k = 0; k < tensor->dims->size; k++) {
      byte_size = byte_size * tensor->dims->data[k];
    }
    base_addrs_size[num_tensors] = byte_size;
    num_tensors++;
  }

  // Get addresses to output data.
  for (i = 0; i < node->outputs->size; ++i) {
    tensor = context->GetEvalTensor(context, node->outputs->data[i]);
    base_addrs[num_tensors] =
        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(tensor->data.uint8));
    size_t byte_size = 1;
    for (int k = 0; k < tensor->dims->size; k++) {
      byte_size = byte_size * tensor->dims->data[k];
    }
    base_addrs_size[num_tensors] = byte_size;
    num_tensors++;
  }

  // When Vela optimizes a tflite file it will assign the tensors like this:
  //
  // +-------+------------------------+  +--------+-------------+
  // | INPUT | Description            |  | OUTPUT | Description |
  // +-------+------------------------+  +--------+-------------+
  // |     0 | Ethos-U command stream |  |   0..m | Outputs     |
  // |     1 | TFLM model             |  +--------+-------------+
  // |     2 | TFLM arena             |
  // |     3 | Ethos-U fast scratch   |
  // |  4..n | Inputs                 |
  // +-------+------------------------+
  //
  // This code will assign the NPU base addresses like this:
  //
  // +--------------+----------------------+
  // | Base address | Description          |
  // +--------------+----------------------+
  // |            0 | TFLM model           |
  // |            1 | TFLM arena           |
  // |            2 | Ethos-U fast scratch |
  // |         3..n | Input tensors        |
  // |         n..m | Output tensors       |
  // +--------------+----------------------+
  //
  // The number of base address will be limited to 8.
  //
  // NOTE! The command stream produced by Vela will access the IFM and OFM
  // buffers using base address 1. This means that it is not possible to point
  // the input and output tensors outside of the TFLM arena.
  num_tensors = std::min(num_tensors, 8);

  const uint32_t tcn_v6_call_index = ++tcn_v6_npu_invocation_index;
  const int64_t tcn_v6_reserve_start_ms = k_uptime_get();
  struct ethosu_driver *drv = ethosu_reserve_driver();
  const uint32_t tcn_v6_reserve_ms = (uint32_t)(k_uptime_get() - tcn_v6_reserve_start_ms);
  const uint32_t tcn_v6_irq_before = tcn_v6_ethosu_irq_count_get();
  const int64_t tcn_v6_invoke_start_ms = k_uptime_get();
  result = ethosu_invoke_v3(
      drv, cms_data, data->cms_data_size, base_addrs,
      base_addrs_size, num_tensors,
      GetMicroContext(context)->external_context());
  const uint32_t tcn_v6_invoke_ms = (uint32_t)(k_uptime_get() - tcn_v6_invoke_start_ms);
  const uint32_t tcn_v6_irq_after = tcn_v6_ethosu_irq_count_get();
  const uint32_t tcn_v6_irq_delta = tcn_v6_irq_after - tcn_v6_irq_before;
  const int64_t tcn_v6_release_start_ms = k_uptime_get();
  ethosu_release_driver(drv);
  const uint32_t tcn_v6_release_ms = (uint32_t)(k_uptime_get() - tcn_v6_release_start_ms);
  tcn_v6_npu_cumulative_invoke_ms += tcn_v6_invoke_ms;
  tcn_v6_npu_cumulative_irq_delta += tcn_v6_irq_delta;
  printk("TCN_V6_NPU_PROFILE: idx=%u status=%d drv_valid=%u "
         "cmd_tensor_bytes=%d base_regions=%d reserve_ms=%u "
         "invoke_ms=%u release_ms=%u irq_before=%u "
         "irq_after=%u irq_delta=%u cumulative_invoke_ms=%u "
         "cumulative_irq_delta=%u\n",
         tcn_v6_call_index, result, (drv != nullptr) ? 1u : 0u,
         data->cms_data_size, num_tensors, tcn_v6_reserve_ms,
         tcn_v6_invoke_ms, tcn_v6_release_ms,
         tcn_v6_irq_before, tcn_v6_irq_after,
         tcn_v6_irq_delta, tcn_v6_npu_cumulative_invoke_ms,
         tcn_v6_npu_cumulative_irq_delta);

  if (-1 == result) {
    return kTfLiteError;
  } else {
    return kTfLiteOk;
  }
}

