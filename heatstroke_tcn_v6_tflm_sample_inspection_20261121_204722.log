     5	cmake_minimum_required(VERSION 3.20.0)
     6	
     7	find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
     8	
     9	# Detect NPU architecture from ETHOSU_TARGET_NPU_CONFIG
    10	# This is the SINGLE SOURCE OF TRUTH for NPU configuration
    11	if(ETHOSU_TARGET_NPU_CONFIG MATCHES "^ethos-(u[0-9]+)-([0-9]+)$")
    12	    set(ETHOSU_ARCH "${CMAKE_MATCH_1}")
    13	    set(ETHOSU_MACS "${CMAKE_MATCH_2}")
    14	
    15	    message(STATUS "ETHOSU_TARGET_NPU_CONFIG: ${ETHOSU_TARGET_NPU_CONFIG}")
    16	    message(STATUS "Detected NPU Architecture: ${ETHOSU_ARCH}, MACs: ${ETHOSU_MACS}")
    17	
    18	    # Validate and configure for U55/U65
    19	    if((ETHOSU_ARCH STREQUAL "u55") OR (ETHOSU_ARCH STREQUAL "u65"))
    20	        # Validate MAC configuration based on core type (HE vs HP)
    21	        if(CONFIG_RTSS_HE)
    22	            # HE core only supports 128 MACs for U55
    23	            if(NOT (ETHOSU_MACS STREQUAL "128"))
    24	                message(FATAL_ERROR 
    25	                    "Core type mismatch: RTSS_HE core with U55 only supports 128 MACs.\n"
    26	                    "You specified: ${ETHOSU_MACS} MACs\n"
    27	                    "For HE core, use: -DETHOSU_TARGET_NPU_CONFIG=ethos-u55-128\n"
    28	                    "For 256 MACs, use HP core board variant (rtss_hp)")
    29	            endif()
    30	            message(STATUS "Detected RTSS_HE core - U55 restricted to 128 MACs")
    31	        elseif(CONFIG_RTSS_HP)
    32	            # HP core only supports 256 MACs for U55
    33	            if(NOT (ETHOSU_MACS STREQUAL "256"))
    34	                message(FATAL_ERROR 
    35	                    "Core type mismatch: RTSS_HP core with U55 only supports 256 MACs.\n"
    36	                    "You specified: ${ETHOSU_MACS} MACs\n"
    37	                    "For HP core, use: -DETHOSU_TARGET_NPU_CONFIG=ethos-u55-256\n"
    38	                    "For 128 MACs, use HE core board variant (rtss_he)")
    39	            endif()
    40	            message(STATUS "Detected RTSS_HP core - U55 restricted to 256 MACs")
    41	        elseif(CONFIG_APSS)
    42	            message(FATAL_ERROR
    43	                "Ethos-U55 is not directly accessible from APSS (Cortex-A32).\n"
    44	                "Use Ethos-U85 instead: -DETHOSU_TARGET_NPU_CONFIG=ethos-u85-256")
    45	        else()
    46	            # Fallback validation for other core types
    47	            if(NOT (ETHOSU_MACS STREQUAL "64" OR ETHOSU_MACS STREQUAL "128" OR ETHOSU_MACS STREQUAL "256"))
    48	                message(FATAL_ERROR "Unsupported U55/U65 MAC configuration: ${ETHOSU_MACS}. Valid: 64, 128, 256")
    49	            endif()
    50	        endif()
    51	
    52	        # Validate overlay file matches NPU type
    53	        if(DEFINED EXTRA_DTC_OVERLAY_FILE)
    54	            if(EXTRA_DTC_OVERLAY_FILE MATCHES "ethosu85\\.overlay")
    55	                message(FATAL_ERROR 
    56	                    "Overlay mismatch: ETHOSU_TARGET_NPU_CONFIG='${ETHOSU_TARGET_NPU_CONFIG}' (U55) "
    57	                    "but using U85 overlay '${EXTRA_DTC_OVERLAY_FILE}'.\n"
    58	                    "For U55, use: -DEXTRA_DTC_OVERLAY_FILE=\"boards/enable_ethosu55.overlay\"")
    59	            endif()
    60	        endif()
    61	
    62	        # Set architecture flag
    63	        set(ETHOSU_ARCH_U55 y CACHE BOOL "U55 Flag")
    64	        add_compile_definitions(ETHOSU_ARCH_U55="${ETHOSU_ARCH_U55}")
    65	
    66	        # Automatically set the appropriate CONFIG_ARM_ETHOS_U55_* based on MACS
    67	        if(ETHOSU_MACS STREQUAL "256")
    68	            set(CONFIG_ARM_ETHOS_U55_256 y CACHE BOOL "U55 256 MACs" FORCE)
    69	            message(STATUS "Auto-configured: CONFIG_ARM_ETHOS_U55_256=y")
    70	        elseif(ETHOSU_MACS STREQUAL "128")
    71	            set(CONFIG_ARM_ETHOS_U55_128 y CACHE BOOL "U55 128 MACs" FORCE)
    72	            message(STATUS "Auto-configured: CONFIG_ARM_ETHOS_U55_128=y")
    73	        elseif(ETHOSU_MACS STREQUAL "64")
    74	            set(CONFIG_ARM_ETHOS_U55_64 y CACHE BOOL "U55 64 MACs" FORCE)
    75	            message(STATUS "Auto-configured: CONFIG_ARM_ETHOS_U55_64=y")
    76	        endif()
    77	
    78	        message(STATUS "Building for Ethos-U55 with ${ETHOSU_MACS} MACs")
    79	
    80	    # Validate and configure for U85
    81	    elseif(ETHOSU_ARCH STREQUAL "u85")
    82	        # Validate board supports U85 FIRST (before MAC check)
    83	        # Note: E4, E8 boards have dual NPUs (U55 + U85)
    84	        if(NOT (CONFIG_SOC_SERIES_E8 OR CONFIG_SOC_SERIES_E4))
    85	            message(FATAL_ERROR 
    86	                "Ethos-U85 is only available on E4, E8 boards.\n"
    87	                "Current board does not support U85.\n"
    88	                "For this board, use: -DETHOSU_TARGET_NPU_CONFIG=ethos-u55-256")
    89	        endif()
    90	
    91	        # Validate MAC configuration - U85 only supports 256 MACs on Alif boards
    92	        if(NOT (ETHOSU_MACS STREQUAL "256"))
    93	            message(FATAL_ERROR 
    94	                "Unsupported U85 MAC configuration: ${ETHOSU_MACS}\n"
    95	                "Alif Ensemble boards only support Ethos-U85 with 256 MACs.\n"
    96	                "Use: -DETHOSU_TARGET_NPU_CONFIG=ethos-u85-256")
    97	        endif()
    98	
    99	        # Validate overlay file matches NPU type (catches accidental U55 overlay with U85 config)
   100	        if(DEFINED EXTRA_DTC_OVERLAY_FILE)
   101	            if(EXTRA_DTC_OVERLAY_FILE MATCHES "ethosu55\\.overlay")
   102	                message(FATAL_ERROR 
   103	                    "Overlay mismatch: ETHOSU_TARGET_NPU_CONFIG='${ETHOSU_TARGET_NPU_CONFIG}' (U85) "
   104	                    "but using U55 overlay '${EXTRA_DTC_OVERLAY_FILE}'.\n"
   105	                    "For U85 on RTSS, use: -S ethos-u85-enable\n"
   106	                    "For U85 on APSS,  use: -S ethos-u85-apss-enable")
   107	            endif()
   108	        endif()
   109	
   110	        # Set architecture flag
   111	        set(ETHOSU_ARCH_U85 y CACHE BOOL "U85 Flag")
   112	        add_compile_definitions(ETHOSU_ARCH_U85="${ETHOSU_ARCH_U85}")
   113	
   114	        # Automatically set CONFIG_ARM_ETHOS_U85_256 (only 256 MACs supported)
   115	        set(CONFIG_ARM_ETHOS_U85_256 y CACHE BOOL "U85 256 MACs" FORCE)
   116	        message(STATUS "Auto-configured: CONFIG_ARM_ETHOS_U85_256=y")
   117	
   118	        message(STATUS "Building for Ethos-U85 with ${ETHOSU_MACS} MACs")
   119	
   120	    else()
   121	        message(FATAL_ERROR "Unsupported NPU architecture: ${ETHOSU_ARCH}. Valid: u55, u65, u85")
   122	    endif()
   123	
   124	else()
   125	    message(FATAL_ERROR 
   126	        "Invalid or missing ETHOSU_TARGET_NPU_CONFIG: '${ETHOSU_TARGET_NPU_CONFIG}'\n"
   127	        "Required format: ethos-u<arch>-<macs>\n"
   128	        "Examples:\n"
   129	        "  -DETHOSU_TARGET_NPU_CONFIG=ethos-u55-128\n"
   130	        "  -DETHOSU_TARGET_NPU_CONFIG=ethos-u55-256\n"
   131	        "  -DETHOSU_TARGET_NPU_CONFIG=ethos-u85-256")
   132	endif()
   133	
   134	project(tflm_ethosu_app)
   135	
   136	target_include_directories(app PRIVATE ../../../../include)
   137	
   138	add_subdirectory(
   139	    ../../../../lib/ethosu_utils
   140	    ${CMAKE_BINARY_DIR}/lib/ethosu_utils
   141	)
   142	
   143	target_sources(app PRIVATE src/main.cpp)
   144	
   145	# APSS (Cortex-A32): include the SRAM1 linker snippet so the tensor arena
   146	# is placed into the non-cacheable SRAM1 memory region defined in the overlay.
   147	if(CONFIG_APSS)
   148	    zephyr_linker_sources(SECTIONS boards/apss_sram1_sections.ld)
   149	endif()

