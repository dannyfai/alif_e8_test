    10	
    11	/*
    12	 * Ethos-U55 NPU Enable Overlay
    13	 *
    14	 * This overlay enables the Ethos-U55 NPU (ethosu0) for all boards.
    15	 *
    16	 * Applicable to ALL Boards:
    17	 *   - B1 (alif_b1_dk)      - U55 only
    18	 *   - E1C (alif_e1c_dk)    - U55 only
    19	 *   - E7 (alif_e7_dk)      - U55 only
    20	 *   - E8 (alif_e8_dk)      - U55 + U85
    21	 *
    22	 * Note: All boards have ethosu0 (U55). E8 additionally has ethosu1 (U85).
    23	 *
    24	 * Usage:
    25	 *   west build -b alif_e8_dk/<variant>/<core> <app_path> -S ethos-u55-enable
    26	 *
    27	 * Build-time Safety Check:
    28	 *   If this overlay is applied to a board without U55 support,
    29	 *   the build will fail with an error message indicating that ethosu0 node
    30	 *   does not exist on this board.
    31	 */
    32	
    33	/ {
    34		/* Compile-time assertion: ethosu0 must exist */
    35		ethosu_u55_check {
    36			compatible = "vnd,ethosu-u55-check";
    37			ethosu-node = <&ethosu0>;
    38		};
    39	};
    40	
    41	&ethosu0 {
    42		status = "okay";
    43	};

