     1	cmake_minimum_required(VERSION 3.20.0)
     2	
     3	# Locate the alif-mlek west module. It provides the Vela-compiled models and the
     4	# source-generator CMake helpers used to turn a .tflite into a C array. Ask west
     5	# for the module path instead of hardcoding the workspace layout.
     6	execute_process(
     7	    COMMAND west list --format "{abspath}" alif-mlek
     8	    WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
     9	    OUTPUT_VARIABLE MLEK_ROOT
    10	    OUTPUT_STRIP_TRAILING_WHITESPACE
    11	    RESULT_VARIABLE MLEK_LIST_RESULT
    12	    ERROR_QUIET
    13	)
    14	if (MLEK_LIST_RESULT OR NOT EXISTS ${MLEK_ROOT})
    15	    message(FATAL_ERROR
    16	        "alif-mlek module not found. Enable and fetch it first:\n"
    17	        "  west config manifest.project-filter -- +alif-mlek\n"
    18	        "  west update\n")
    19	endif()
    20	
    21	# Make the MLEK source-generator helpers (setup_source_generator,
    22	# generate_model_code) available without pulling in the full MLEK examples lib.
    23	set(MLEK_SCRIPTS_DIR ${MLEK_ROOT}/scripts)
    24	list(APPEND CMAKE_MODULE_PATH ${MLEK_SCRIPTS_DIR}/cmake)
    25	include(source_gen_utils)
    26	
    27	# ---------------------------------------------------------------------------
    28	# Ethos-U NPU selection
    29	# ---------------------------------------------------------------------------
    30	# When ETHOSU_TARGET_NPU_CONFIG is provided on the command line it is the single
    31	# source of truth for the NPU. We must act on it BEFORE find_package(Zephyr) so
    32	# that the matching Kconfig choice (CONFIG_ARM_ETHOS_U<arch>_<macs>) is fed into
    33	# the build and the Ethos-U driver targets the requested NPU. This overrides the
    34	# board default (E8 rtss_hp defaults to Ethos-U55 with 256 MACs).
    35	#
    36	# The parsed value is also used to pick the correct Vela-compiled model below.
    37	# Vela config-ID prefix: U55 -> H, U65 -> Y, U85 -> Z (e.g. ethos-u85-256 -> Z256).
    38	if (DEFINED ETHOSU_TARGET_NPU_CONFIG)
    39	    string(TOLOWER "${ETHOSU_TARGET_NPU_CONFIG}" _npu_cfg)
    40	    if (_npu_cfg MATCHES "^ethos-(u[0-9]+)-([0-9]+)$")
    41	        set(_npu_arch "${CMAKE_MATCH_1}")
    42	        set(_npu_macs "${CMAKE_MATCH_2}")
    43	        if (_npu_arch STREQUAL "u55")
    44	            set(_npu_prefix "H")
    45	        elseif (_npu_arch STREQUAL "u65")
    46	            set(_npu_prefix "Y")
    47	        elseif (_npu_arch STREQUAL "u85")
    48	            set(_npu_prefix "Z")
    49	        else()
    50	            message(FATAL_ERROR
    51	                "Unsupported Ethos-U architecture '${_npu_arch}' in "
    52	                "ETHOSU_TARGET_NPU_CONFIG='${ETHOSU_TARGET_NPU_CONFIG}'")
    53	        endif()
    54	        set(ETHOS_U_NPU_CONFIG_ID "${_npu_prefix}${_npu_macs}")
    55	
    56	        # Feed the matching Kconfig choice into the Zephyr configuration.
    57	        string(TOUPPER "${_npu_arch}" _npu_arch_uc)
    58	        set(CONFIG_ARM_ETHOS_${_npu_arch_uc}_${_npu_macs} y
    59	            CACHE INTERNAL "Selected Ethos-U NPU configuration" FORCE)
    60	        message(STATUS
    61	            "Ethos-U: ETHOSU_TARGET_NPU_CONFIG=${ETHOSU_TARGET_NPU_CONFIG} -> "
    62	            "CONFIG_ARM_ETHOS_${_npu_arch_uc}_${_npu_macs}=y, model ID ${ETHOS_U_NPU_CONFIG_ID}")
    63	    else()
    64	        message(FATAL_ERROR
    65	            "Invalid ETHOSU_TARGET_NPU_CONFIG='${ETHOSU_TARGET_NPU_CONFIG}'.\n"
    66	            "Expected format: ethos-u<arch>-<macs>, e.g. ethos-u55-256 or ethos-u85-256")
    67	    endif()
    68	endif()
    69	
    70	find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
    71	project(alif_inference)
    72	
    73	# ---------------------------------------------------------------------------
    74	# Build-time model generation from MLEK resources
    75	# ---------------------------------------------------------------------------
    76	set(RESOURCES_PATH ${MLEK_ROOT}/resources_downloaded CACHE PATH
    77	    "Path to MLEK resources (models compiled with Vela)")
    78	setup_source_generator()
    79	
    80	# Source generation output directory
    81	set(SRC_GEN_DIR ${CMAKE_CURRENT_BINARY_DIR}/generated/src)
    82	file(MAKE_DIRECTORY ${SRC_GEN_DIR})
    83	
    84	# Determine NPU config ID based on Zephyr Kconfig.
    85	# If ETHOSU_TARGET_NPU_CONFIG was supplied on the command line, ETHOS_U_NPU_CONFIG_ID
    86	# has already been computed above. Otherwise fall back to the board Kconfig defaults.
    87	if (NOT DEFINED ETHOS_U_NPU_CONFIG_ID)
    88	    if (CONFIG_ARM_ETHOS_U85_256)
    89	        set(ETHOS_U_NPU_CONFIG_ID "Z256")
    90	    elseif (CONFIG_ARM_ETHOS_U55_256)
    91	        set(ETHOS_U_NPU_CONFIG_ID "H256")
    92	    else()
    93	        set(ETHOS_U_NPU_CONFIG_ID "H128")
    94	    endif()
    95	endif()
    96	
    97	# Model file path
    98	set(KWS_MODEL_PATH ${RESOURCES_PATH}/kws/kws_micronet_m_vela_${ETHOS_U_NPU_CONFIG_ID}.tflite
    99	    CACHE FILEPATH "Path to the KWS TFLite model (Vela-compiled)")
   100	
   101	if (NOT EXISTS ${KWS_MODEL_PATH})
   102	    message(FATAL_ERROR
   103	        "KWS model not found at ${KWS_MODEL_PATH}\n"
   104	        "Run set_up_default_resources.py first:\n"
   105	        "  python3 ${MLEK_ROOT}/set_up_default_resources.py\n")
   106	endif()
   107	
   108	# Validate the generated model C array against the selected NPU.
   109	set(ETHOS_U_NPU_ENABLED ON)
   110	
   111	# Generate model C array and parameter constants
   112	set(EXTRA_MODEL_CODE
   113	    "/* Model parameters for alif_inference */"
   114	    "extern const int   g_FrameLength    = 640"
   115	    "extern const int   g_FrameStride    = 320"
   116	    "extern const int   g_AudioRate      = 16000"
   117	    "extern const float g_ScoreThreshold = 0.5"
   118	)
   119	
   120	generate_model_code(
   121	    MODEL_PATH  ${KWS_MODEL_PATH}
   122	    DESTINATION ${SRC_GEN_DIR}
   123	    EXPRESSIONS ${EXTRA_MODEL_CODE}
   124	    NAMESPACE   "arm" "app" "kws"
   125	)
   126	
   127	# Collect the generated source files
   128	file(GLOB KWS_GENERATED_SOURCES ${SRC_GEN_DIR}/*.cc)
   129	
   130	# ---------------------------------------------------------------------------
   131	
   132	target_include_directories(app PRIVATE
   133	    src
   134	    ../../alif_common
   135	    ../../alif_common/audio
   136	    ../../alif_common/audio/include
   137	)
   138	
   139	target_sources(app PRIVATE
   140	    src/mfcc/PlatformMath.cc
   141	    src/mfcc/KwsProcessing.cc
   142	    src/mfcc/Mfcc.cc
   143	    src/main.cpp
   144	    src/KWSModel.cpp
   145	    src/LiveMicInput.cpp
   146	    ../../alif_common/audio/AudioBackend.cpp
   147	    ${KWS_GENERATED_SOURCES}
   148	)

