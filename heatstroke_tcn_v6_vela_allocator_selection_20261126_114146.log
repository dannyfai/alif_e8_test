  335:         op_info = sg.schedule.cost_map[sched_op]
  336:         cascade = op_info.cascade
  337:         cascade_info = sg.schedule.cascades.get(cascade, None)
  338: 
  339:         if cascade_info is None:
  340:             # Op is not part of a cascade, check if the ifm can be overwritten by the ofm
  341:             merge_elementwise_op_ranges(sg, sched_op, lr_graph, target_mem_area, target_mem_type_set)
  342: 
  343:         time_to_set = time_for_cascade.get(cascade, lr_graph.current_time)
  344: 
  345:         op_info.time_index = time_to_set
  346: 
  347:         # Mark usage for all tensors related to this Pass
  348:         ps = sched_op.parent_ps
