  171: def _get_ifm_to_fuse(sched_op, target_mem_area=None, target_mem_type_set=None):
  172:     ifm_tens = None
  173:     elem_op = sched_op.parent_op
  174:     if sched_op.op_type.is_elementwise_op() and elem_op.memory_function is not Op.VariableTensorWrite:
  175:         # Check if possible to merge ifm/ofm live ranges of elementwise op
  176:         if not tensor_should_be_ignored(elem_op.ofm, target_mem_area, target_mem_type_set):
  177:             # Check if overwriting the inputs can be allowed
  178:             OpShapeTens = namedtuple("OpShapeTens", ["op_shape", "tens"])
  179:             outp = OpShapeTens(elem_op.ofm_shapes[0], elem_op.ofm)
  180:             inps = []
  181:             if elem_op.ifm is not None:
  182:                 inps.append(OpShapeTens(elem_op.ifm_shapes[0], elem_op.ifm))
  183:             if elem_op.ifm2 is not None:
  184:                 inps.append(OpShapeTens(elem_op.ifm_shapes[1], elem_op.ifm2))
  185:             # find an input tensor that can be overwritten by the output
  186:             for inp in inps:
  187:                 if (
  188:                     # check op input and output shapes allow overlapping
  189:                     inp.op_shape == outp.op_shape
  190:                     # check input tensor is valid
  191:                     and inp.tens is not None
  192:                     and inp.tens.shape != []
  193:                     and not inp.tens.ifm_write_protected
  194:                     and not tensor_should_be_ignored(inp.tens, target_mem_area, target_mem_type_set)
  195:                     # check input and output tensors are compatible
  196:                     and inp.tens.format == outp.tens.format
  197:                     and inp.tens.dtype == outp.tens.dtype
  198:                     # check input tensor only has one consumer
  199:                     and len(inp.tens.consumer_list) == 1
  200:                     # check output tensor only has one producer
  201:                     and len(outp.tens.ops) == 1
  202:                 ):
  203:                     ifm_tens = inp.tens
  204:                     break
  205:     elif sched_op.op_type == Op.Memcpy:
  206:         # Check if possible to merge ifm/ofm live ranges of dma op
  207:         dma_op = sched_op.parent_op
  208:         ifm = dma_op.ifm
  209:         ofm = dma_op.ofm
  210:         if not (
  211:             tensor_should_be_ignored(ifm, target_mem_area, target_mem_type_set)
  212:             or tensor_should_be_ignored(ofm, target_mem_area, target_mem_type_set)
  213:             # input tensor only allowed to have one consumer
  214:             or len(ifm.consumer_list) > 1
  215:         ):
  216:             # Currently DMA only used when bypassing memory only ops so ok to reuse ifm
  217:             # if ifm has only one consumer
  218:             ifm_tens = ifm
  219: 
  220:     return ifm_tens

