  364:                 or tens.mem_area != target_mem_area
  365:             ):
  366:                 continue
  367: 
  368:             else:
  369:                 rng = lr_graph.get_or_create_range(tens)
  370: 
  371:             rng.mark_usage(time_to_set)
  372: 
  373:         for idx, weight_tens in enumerate(op_info.buffered_weight_tensors):
  374:             if weight_tens.mem_type in target_mem_type_set and weight_tens.mem_area == target_mem_area:
  375:                 rng = lr_graph.get_or_create_range(weight_tens)
  376:                 start_time = time_to_set
  377:                 length = 1
  378:                 if weight_tens.pre_buffer:
  379:                     start_time -= 1
  380:                     length += 1
  381:                 if len(op_info.buffered_weight_tensors) > 1:
  382:                     last_idx = len(op_info.ofm_depth_slices) % len(op_info.buffered_weight_tensors)
  383:                     # Double buffering: reduce end time of the buffer that is not used last
  384:                     if last_idx != idx:
  385:                         length -= 1
  386:                 rng.mark_usage(start_time, length)
  387: 
  388:         if time_to_set == lr_graph.current_time:
  389:             lr_graph.current_time += 2
  390: 
  391:         if cascade != 0:
