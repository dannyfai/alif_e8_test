        const TFLMRegistration registration =
            tflite::RegisterHeatstrokeLayerNormQuantize();

        if (this->m_opResolver.AddCustom(
                "HeatstrokeLayerNormQuantize",
                &registration) != kTfLiteOk) {
            printf_err(
                "Failed to register fused heat-stress LayerNorm operator.\n");
            return false;
        }

        if (this->m_opResolver.FindOp(
