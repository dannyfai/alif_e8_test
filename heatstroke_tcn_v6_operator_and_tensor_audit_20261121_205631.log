            tflite::RegisterHeatstrokeInt64SubKernel();
        if (this->m_opResolver.AddBuiltin(
                tflite::BuiltinOperator_SUB,
                registration,
                tflite::ParseSub) != kTfLiteOk) {
            printf_err("Failed to register heat-stress INT64 SUB.\\n");
