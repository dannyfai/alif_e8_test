                registration,
                ParseHeatstrokeBidirectionalSequenceLstm) != kTfLiteOk) {
            printf_err(
                "Failed to register heat-stress bidirectional LSTM.\n");
            return false;
        }
    }

    /*
     * Ethos-U registration.
     *
     * AddEthosU() in this SDK can report success even when the hardware
     * registration is null. Therefore, explicitly verify FindOp().
     */
    if (this->m_opResolver.AddEthosU() != kTfLiteOk) {
        printf_err("Failed to add Ethos-U to the resolver.\n");
        return false;
    }

    const char* ethos_name = tflite::GetString_ETHOSU();

    if (ethos_name == nullptr ||
        this->m_opResolver.FindOp(ethos_name) == nullptr) {
        printf_err(
            "Ethos-U registration is missing from the resolver.\n");
        return false;
    }

#if defined(HEATSTROKE_LAYER_NORM_FUSION_EXPERIMENT)
