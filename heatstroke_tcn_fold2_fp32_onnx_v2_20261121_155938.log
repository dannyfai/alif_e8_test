PROJECT="/home/user/sdk-alif/beeinventor/PolyU/Heat_Stress_Model_1_v20260514"
OUTDIR="$PROJECT/experiments/tcn_reg_20261120/onnx_fp32_fold2_external_compact_20261121_155940"␀
ONNX="$OUTDIR/heatstroke_tcn_reg_fold2_fp32_external_compact.onnx"
TFLITE="$OUTDIR/heatstroke_tcn_reg_fold2_fp32_external_compact.tflite"
LOGDIR="/home/user/sdk-alif/beeinventor/test_heatstroke/log"
PYTHON="/home/user/onnx2tflite_env/bin/python"
CONVERTER="/home/user/onnx2tflite_env/bin/onnx2tflite"

mkdir -p "$LOGDIR"
LOG="$LOGDIR/heatstroke_tcn_fp32_onnx2tflite_$(date +%Y%m%d_%H%M%S).log"
exec > >(tee "$LOG") 2>&1

trap 'rc=$?; trap - EXIT; echo; echo "CONVERSION EXIT CODE: $rc"; echo "LOG: $LOG"; if [ -t 0 ]; then read -r -p "Press Enter to close..."; fi; exit "$rc"' EXIT 

echo "===== TCN FOLD-2 FP32 ONNX TO TFLITE ====="
date

echo
echo "===== VERIFY INPUT FILES AND CONVERTER ====="
test -s "$ONNX"
test -x "$CONVERTER"
test ! -e "$TFLITE"

ls -lh "$ONNX"
sha256sum "$ONNX"
"$CONVERTER" --help | head -45

echo
echo "===== CONVERT FP32 MODEL ====="
"$CONVERTER" "$ONNX" \
    --cast-int64-to-int32 \
    --guarantee-non-negative-indices \
    --verbose \
    -o "$TFLITE"

echo
echo "===== VERIFY TFLITE FILE ====="
test -s "$TFLITE"
ls -lh "$TFLITE"
sha256sum "$TFLITE"

echo
echo "===== LOAD TFLITE AND INSPECT OPERATORS ====="
"$PYTHON" -u - "$TFLITE" <<'PY'
import sys
from collections import Counter
import tensorflow as tf

path = sys.argv[1]
print("TensorFlow:", tf.__version__)
print("TFLite:", path)

interpreter = tf.lite.Interpreter(model_path=path)
interpreter.allocate_tensors()

inputs = interpreter.get_input_details()
outputs = interpreter.get_output_details()
ops = interpreter._get_ops_details()

print("\nINPUT TENSORS:")
for x in inputs:
