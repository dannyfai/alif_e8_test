  714: def generate_register_command_stream_for_sg(nng, sg, arch, verbose=False):
  715:     """Generates command stream for the subgraph, adds it to sg.register_command_stream"""
  716:     # Convert high level command stream to list of NpuOperation
  717:     npu_op_list = []
  718:     npu_op_to_cmd = dict()  # map from npu op to high level command
  719:     for cmd in sg.high_level_command_stream:
  720:         if isinstance(cmd, NpuStripe) and cmd.ps.npu_block_type == NpuBlockType.Default:
  721:             print("Warning: Skipping register command stream generation for", cmd.ps)
  722:         elif isinstance(cmd, NOP):
  723:             # NOP should not generate anything
  724:             continue
  725:         else:
  726:             npu_op = convert_command_to_npu_op(cmd, arch)
  727:             npu_op_list.append(npu_op)
  728:             npu_op_to_cmd[npu_op] = cmd
  729:     mem_limits = get_mem_limits_for_regions(arch)
  730:     # Generate register commands
  731:     if len(sg.high_level_command_stream) > 0:
  732:         stream_id = DebugDatabase.add_stream(sg)
  733:         sg.generated_stream_id = stream_id
  734: 
  735:         def add_to_debug_db(npu_op: NpuOperation, offset: int):
  736:             """Adds info to the debug database"""
  737:             if not isinstance(npu_op, NpuDmaOperation):
  738:                 cmd = npu_op_to_cmd[npu_op]
  739:                 DebugDatabase.add_command(stream_id, offset, cmd.ps.primary_op)
  740: 
  741:         sg.register_command_stream = generate_command_stream(
  742:             npu_op_list, arch, verbose, mem_limits, add_to_debug_db, npu_op_to_cmd
  743:         )
