    81	                        static_cast<double>(op_data->output_scale));
    82	      TF_LITE_ENSURE_EQ(context, op_data->input_zp, op_data->output_zp);
    83	      ReduceEvalVision(*op_data_xtensa, input, output);
    84	      break;
    85	    }
    86	    default: {
    87	      // Use the reference EvalMax for all other cases.
    88	      return EvalMaxHelper(context, node, op_data);
    89	    }
