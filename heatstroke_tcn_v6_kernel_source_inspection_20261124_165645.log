    24	struct OpDataMirrorPad {
    25	  int input_dims;
    26	  int output_size;
    27	  int offset;
    28	  int output_dims_num_elements_buffer_index;
    29	  int input_dims_num_elements_buffer_index;
    30	};
    31	
    32	// Helper method that fills the left and right pads.
    33	template <typename T>
    34	inline void GetPadding(const T* data, int offset, int64_t* left_pad,
    35	                       int64_t* right_pad) {
    36	  *left_pad = static_cast<int64_t>(*(data + offset * 2));
    37	  *right_pad = static_cast<int64_t>(*(data + offset * 2 + 1));
    38	}
    39	
    40	// Given dimension index and the left/right padding.
    41	// Returns the corresponding dimension in the input array.
    42	inline int GetInputDimension(int padded_dimension, int left_pad, int right_pad,
    43	                             int input_dim_size, int offset) {
    44	  if (padded_dimension < left_pad) {
    45	    const int original_ind = left_pad + offset - 1;
    46	    return original_ind - (std::min(padded_dimension, original_ind - offset));
    47	  }
    48	  padded_dimension -= left_pad;
    49	  if (padded_dimension >= input_dim_size) {
    50	    padded_dimension -= input_dim_size;
    51	    const int original_ind = input_dim_size - (1 + offset);
    52	    return original_ind - std::min(padded_dimension, original_ind);
    53	  }
    54	  return padded_dimension;
    55	}
    56	
    57	// Given and index in output array, returns the index of the value
    58	// in input array.
    59	int GetFlatIndex(int index, int num_dims,
    60	                 const TfLiteEvalTensor* padding_matrix,
    61	                 const TfLiteIntArray* input_dims,
    62	                 int* output_dims_num_elements, int* input_dims_num_elements,
    63	                 const int offset) {
    64	  int flat_index = 0;
    65	  int64_t left_pad = 0, right_pad = 0, dimension_index, index_in_input;
    66	
    67	  for (int i = 0; i < num_dims; ++i) {
    68	    switch (padding_matrix->type) {
    69	      case kTfLiteInt32:
    70	        GetPadding(padding_matrix->data.i32, i, &left_pad, &right_pad);
    71	        break;
    72	      case kTfLiteInt64:
    73	        GetPadding(padding_matrix->data.i64, i, &left_pad, &right_pad);
    74	        break;
    75	      default:
    76	        break;
    77	    }
    78	    dimension_index = index / output_dims_num_elements[i];
    79	
    80	    index_in_input = GetInputDimension(dimension_index, left_pad, right_pad,
    81	                                       input_dims->data[i], offset);
    82	
    83	    flat_index += index_in_input * (input_dims_num_elements)[i];
    84	    index %= output_dims_num_elements[i];
    85	  }
    86	
    87	  return flat_index;
    88	}
    89	
    90	template <typename T>
    91	void MirrorPad(const TfLiteEvalTensor* padding_matrix,
    92	               const TfLiteIntArray* input_dims, int* output_dims_num_elements,
    93	               int* input_dims_num_elements, const T* input_data,
    94	               T* output_data, const int offset, const int num_dims,
    95	               const int output_size) {
    96	  for (int i = 0; i < output_size; ++i) {
    97	    output_data[i] = input_data[GetFlatIndex(
    98	        i, num_dims, padding_matrix, input_dims, output_dims_num_elements,
    99	        input_dims_num_elements, offset)];
   100	  }
   101	}
   102	
   103	TfLiteStatus MirrorPadEval(TfLiteContext* context, TfLiteNode* node) {
   104	  TFLITE_DCHECK(node->user_data != nullptr);
   105	  TfLiteStatus status = kTfLiteOk;
   106	  const OpDataMirrorPad* data =
   107	      static_cast<const OpDataMirrorPad*>(node->user_data);
   108	
   109	  const TfLiteEvalTensor* input_tensor =
   110	      tflite::micro::GetEvalInput(context, node, 0);
   111	  const TfLiteEvalTensor* padding_matrix =
   112	      tflite::micro::GetEvalInput(context, node, 1);
   113	
   114	  TfLiteEvalTensor* output_tensor =
   115	      tflite::micro::GetEvalOutput(context, node, 0);
   116	  const int input_dims = data->input_dims;
   117	  const int output_size = data->output_size;
   118	
   119	  int* input_dims_num_elements = (int*)context->GetScratchBuffer(
   120	      context, data->input_dims_num_elements_buffer_index);
   121	  int* output_dims_num_elements = (int*)context->GetScratchBuffer(
   122	      context, data->output_dims_num_elements_buffer_index);
   123	
   124	  for (int i = 0; i < input_dims; i++) {
   125	    output_dims_num_elements[i] = 1;
   126	    input_dims_num_elements[i] = 1;
   127	  }
   128	
   129	  for (int i = input_dims - 2; i >= 0; i--) {
   130	    output_dims_num_elements[i] =
   131	        output_dims_num_elements[i + 1] * output_tensor->dims->data[i + 1];
   132	
   133	    input_dims_num_elements[i] =
   134	        input_dims_num_elements[i + 1] * input_tensor->dims->data[i + 1];
   135	  }
   136	
   137	  switch (output_tensor->type) {
   138	    case kTfLiteFloat32: {
   139	      MirrorPad(padding_matrix, input_tensor->dims, output_dims_num_elements,
   140	                input_dims_num_elements,
   141	                tflite::micro::GetTensorData<float>(input_tensor),
   142	                tflite::micro::GetTensorData<float>(output_tensor),
   143	                data->offset, input_dims, output_size);
   144	      break;
   145	    }
   146	    case kTfLiteInt8: {
   147	      MirrorPad(padding_matrix, input_tensor->dims, output_dims_num_elements,
   148	                input_dims_num_elements,
   149	                tflite::micro::GetTensorData<int8_t>(input_tensor),
   150	                tflite::micro::GetTensorData<int8_t>(output_tensor),
   151	                data->offset, input_dims, output_size);
   152	      break;
   153	    }
   154	    default:
   155	      status = kTfLiteError;
   156	      break;
   157	  }
   158	
   159	#undef TF_LITE_MIRROR_PAD
   160	
   161	  return status;
   162	}
   163	
   164	void* MirrorPadInit(TfLiteContext* context, const char* buffer, size_t length) {
   165	  TFLITE_DCHECK(context->AllocatePersistentBuffer != nullptr);
   166	  return context->AllocatePersistentBuffer(context, sizeof(OpDataMirrorPad));
   167	}
   168	
   169	TfLiteStatus MirrorPadPrepare(TfLiteContext* context, TfLiteNode* node) {
   170	  MicroContext* micro_context = GetMicroContext(context);
   171	
   172	  TFLITE_DCHECK(node->user_data != nullptr);
   173	  OpDataMirrorPad* data = static_cast<OpDataMirrorPad*>(node->user_data);
   174	
   175	  TfLiteTensor* input_tensor = micro_context->AllocateTempInputTensor(node, 0);
   176	  TfLiteTensor* padding_matrix =
   177	      micro_context->AllocateTempInputTensor(node, 1);
   178	  TfLiteTensor* output_tensor =
   179	      micro_context->AllocateTempOutputTensor(node, 0);
   180	
   181	  TF_LITE_ENSURE_EQ(context, NumDimensions(padding_matrix), 2);
   182	  TF_LITE_ENSURE_EQ(context, SizeOfDimension(padding_matrix, 0),
   183	                    NumDimensions(input_tensor));
   184	  auto* params =
   185	      reinterpret_cast<TfLiteMirrorPaddingParams*>(node->builtin_data);
   186	  if (params == nullptr) {
   187	    return kTfLiteError;
   188	  }
   189	
   190	  data->offset =
   191	      params->mode != TfLiteMirrorPaddingMode::kTfLiteMirrorPaddingReflect ? 0
   192	                                                                           : 1;
   193	  data->input_dims = NumDimensions(input_tensor);
   194	  data->output_size = NumElements(output_tensor);
   195	
   196	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
   197	      context, data->input_dims * sizeof(int),
   198	      &data->output_dims_num_elements_buffer_index));
   199	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
   200	      context, data->input_dims * sizeof(int),
   201	      &data->input_dims_num_elements_buffer_index));
   202	
   203	  micro_context->DeallocateTempTfLiteTensor(input_tensor);
   204	  micro_context->DeallocateTempTfLiteTensor(padding_matrix);
   205	  micro_context->DeallocateTempTfLiteTensor(output_tensor);
   206	  return kTfLiteOk;
   207	}
   208	
   209	}  // namespace
   210	
   211	TFLMRegistration Register_MIRROR_PAD() {
   212	  return tflite::micro::RegisterOp(MirrorPadInit, MirrorPadPrepare,
   213	                                   MirrorPadEval);
   214	}
