  1209	TfLiteStatus MicroAllocator::AllocateScratchBufferHandles(
  1210	    ScratchBufferHandle** scratch_buffer_handles, size_t handle_count) {
  1211	  TFLITE_DCHECK(scratch_buffer_handles != nullptr);
  1212	
  1213	  if (scratch_buffer_request_count_ == 0) {
  1214	    // No scratch buffer requests were requested during model allocation.
  1215	    return kTfLiteOk;
  1216	  }
  1217	
  1218	  // Allocate a consecutive block of memory store the scratch buffer handles.
  1219	  // This alignment ensures quick lookup during inference time for the model:
  1220	  *scratch_buffer_handles = reinterpret_cast<ScratchBufferHandle*>(
  1221	      persistent_buffer_allocator_->AllocatePersistentBuffer(
  1222	          sizeof(ScratchBufferHandle) * handle_count,
  1223	          alignof(ScratchBufferHandle)));
  1224	
  1225	  return kTfLiteOk;
  1226	}
