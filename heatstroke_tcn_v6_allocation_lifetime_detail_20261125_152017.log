  1121	  //
  1122	  // Note that AllocationInfo is only needed for creating the plan. It will be
  1123	  // allocated from the temp section and cleaned up at the bottom of this
  1124	  // function.
  1125	
  1126	  // Use the AllocationInfoBuilder class to help determine where buffers are
  1127	  // used in the subgraph.
  1128	  AllocationInfoBuilder builder(model, non_persistent_buffer_allocator_);
