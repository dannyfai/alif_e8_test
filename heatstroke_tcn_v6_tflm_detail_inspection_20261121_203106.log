    98	# For Ethos-U driver, we need to override the default region configs
    99	# Region numbers are decided by Vela and they do not need to conform to set rules.
   100	# Traditionally they have been used as:
   101	#
   102	# Region 0: Weights and biases (and const tensors)
   103	# Region 1: IFM/OFM/Calculation buffers (tensor arena)
   104	# Region 2: Ethos-U'd dedicated cache region (fast cache memory)
   105	#
   106	# NOTE: The above scheme is completely dependent on Vela and could potentially
   107	#       change.
   108	#
   109	# Common definitions:
   110	# For Ethos-U55/U65/U85, region configs are set as:
   111	#   0 or 1 = AXI0 set
   112	#   2 or 3 = AXI1 set
   113	target_compile_definitions(ethosu_core_driver PUBLIC
   114	    NPU_REGIONCFG_2=1   # AXI0=M0
   115	    NPU_REGIONCFG_3=1   # AXI0=M0
   116	    NPU_REGIONCFG_4=1   # AXI0=M0
   117	    NPU_REGIONCFG_5=1   # AXI0=M0
   118	    NPU_REGIONCFG_6=1   # AXI0=M0
   119	    NPU_REGIONCFG_7=1)  # AXI0=M0
   120	
   121	# Definitions relevant for all NPUs but depend on memory mode
   122	if (ETHOS_U_NPU_MEMORY_MODE STREQUAL Dedicated_Sram)
   123	    target_compile_definitions(ethosu_core_driver PUBLIC
   124	        NPU_QCONFIG=3       # AXI1=M1
   125	        NPU_REGIONCFG_0=3   # AXI1=M1
   126	        NPU_REGIONCFG_1=3)  # AXI1=M1
   127	elseif (ETHOS_U_NPU_MEMORY_MODE STREQUAL Shared_Sram)
   128	    target_compile_definitions(ethosu_core_driver PUBLIC
   129	        NPU_QCONFIG=3       # AXI1=M1
   130	        NPU_REGIONCFG_0=3   # AXI1=M1
   131	        NPU_REGIONCFG_1=0)  # AXI0=M0
   132	else()
   133	    target_compile_definitions(ethosu_core_driver PUBLIC
   134	        NPU_QCONFIG=0       # AXI0=M0
   135	        NPU_REGIONCFG_0=0   # AXI0=M0
   136	        NPU_REGIONCFG_1=0)  # AXI0=M0
   137	endif()
   138	
   139	# Ethos-U55 and Ethos-U65 supports up to 128 bytes,
   140	# and Ethos-U85 supports up to 256 bytes.
   141	# Although, this is system implementation dependent the platforms we build for should support the
   142	# maximum burst length for all NPU configurations.
   143	if (ETHOS_U_NPU_ID STREQUAL U55 OR ETHOS_U_NPU_ID STREQUAL U65)
   144	    target_compile_definitions(ethosu_core_driver PRIVATE
   145	        AXI_LIMIT0_MAX_BEATS_BYTES=1
   146	        AXI_LIMIT1_MAX_BEATS_BYTES=1
   147	        AXI_LIMIT2_MAX_BEATS_BYTES=1
   148	        AXI_LIMIT3_MAX_BEATS_BYTES=1) # 0 = 64 byte burst & 1 = 128 byte burst
   149	    # Use "normal" (modifiable) transactions, improving interconnect transit
   150	    target_compile_definitions(ethosu_core_driver PRIVATE
   151	        AXI_LIMIT0_MEM_TYPE=2
   152	        AXI_LIMIT1_MEM_TYPE=2
   153	        AXI_LIMIT2_MEM_TYPE=2
   154	        AXI_LIMIT3_MEM_TYPE=2) # 2 = Normal Non-cacheable Non-bufferable
   155	elseif (ETHOS_U_NPU_ID STREQUAL U85)
   156	    target_compile_definitions(ethosu_core_driver PRIVATE
   157	        AXI_LIMIT_SRAM_MAX_BEATS=2
   158	        AXI_LIMIT_EXT_MAX_BEATS=2) # 0 = 64 byte burst, 1 = 128 byte burst, 2 = 256 byte burst
   159	    # Use "normal" (modifiable) transactions, improving interconnect transit
   160	    target_compile_definitions(ethosu_core_driver PRIVATE
   161	        NPU_MEM_ATTR_0=0x20  # Normal Non-cacheable Non-bufferable, SRAM ports
   162	        NPU_MEM_ATTR_1=0x20  # Normal Non-cacheable Non-bufferable, SRAM ports
   163	        NPU_MEM_ATTR_2=0x24  # Normal Non-cacheable Non-bufferable, EXT ports
   164	        NPU_MEM_ATTR_3=0x24) # Normal Non-cacheable Non-bufferable, EXT ports
   165	endif()
   166	
   167	# Use "normal" (modifiable) transactions, improving interconnect transit
   168	target_compile_definitions(ethosu_core_driver PRIVATE
   169	        AXI_LIMIT0_MEM_TYPE=2
   170	        AXI_LIMIT1_MEM_TYPE=2
   171	        AXI_LIMIT2_MEM_TYPE=2
   172	        AXI_LIMIT3_MEM_TYPE=2) # 2 = Normal Non-cacheable Non-bufferable
   173	
