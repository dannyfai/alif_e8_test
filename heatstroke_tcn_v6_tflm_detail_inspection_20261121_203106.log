    65	/**
    66	 * @brief  Initialises the NPU IRQ
    67	 **/
    68	static void arm_ethosu_npu_irq_init(void)
    69	{
    70	    const IRQn_Type ethosu_irqnum = (IRQn_Type)ETHOS_U_IRQN;
    71	
    72	    /* Register the EthosU IRQ handler in our vector table.
    73	     * Note, this handler comes from the EthosU driver */
    74	    NVIC_SetVector(ethosu_irqnum, (uint32_t)arm_ethosu_npu_irq_handler);
    75	
    76	    /* Enable the IRQ */
    77	    NVIC_EnableIRQ(ethosu_irqnum);
    78	
    79	    debug("EthosU IRQ#: %u, Handler: 0x%p\n",
    80	          ethosu_irqnum, arm_ethosu_npu_irq_handler);
    81	}
    82	
    83	/**
    84	 * @brief   Defines the Ethos-U interrupt handler: just a wrapper around the default
    85	 *          implementation.
    86	 **/
    87	void arm_ethosu_npu_irq_handler(void)
    88	{
    89	    /* Call the default interrupt handler from the NPU driver */
    90	    ethosu_irq_handler(&ethosu_drv);
    91	}
    92	
    93	int arm_ethosu_npu_init(void)
    94	{
    95	    int err = 0;
    96	
    97	    /* Initialise the IRQ */
    98	    arm_ethosu_npu_irq_init();
    99	
   100	    /* Initialise Ethos-U device */
   101	    void* const ethosu_base_address = (void *)(ETHOS_U_BASE_ADDR);
   102	    info("Initialising Ethos-U device@0x%" PRIx32 "\n", (uint32_t)(ETHOS_U_BASE_ADDR));
   103	
   104	    if (get_cache_arena_size() > 0) {
   105	        info("Using Dedicated_Sram memory mode; fast cache size: %zu\n",
   106	             get_cache_arena_size());
   107	    } else {
   108	        info("Using Sram_Only/Shared_Sram memory mode\n");
   109	    }
   110	
   111	    if (0 != (err = ethosu_init(&ethosu_drv,         /* Ethos-U driver device pointer */
   112	                                ethosu_base_address, /* Ethos-U NPU's base address. */
   113	                                get_cache_arena(),   /* Pointer to fast mem area - NULL for U55. */
   114	                                get_cache_arena_size(), /* Fast mem region size. */
   115	                                ETHOS_U_SEC_ENABLED,    /* Security enable. */
   116	                                ETHOS_U_PRIV_ENABLED))) /* Privilege enable. */ {
   117	        printf_err("Failed to initialise Ethos-U device\n");
   118	        return err;
   119	    }
   120	
   121	    info("Ethos-U device initialised\n");
   122	
   123	    /* Get Ethos-U version */
   124	    struct ethosu_driver_version driver_version;
   125	    struct ethosu_hw_info hw_info;
   126	
   127	    ethosu_get_driver_version(&driver_version);
   128	    ethosu_get_hw_info(&ethosu_drv, &hw_info);
   129	
   130	    info("Ethos-U version info:\n");
   131	    info("\tArch:       v%" PRIu32 ".%" PRIu32 ".%" PRIu32 "\n",
   132	         hw_info.version.arch_major_rev,
   133	         hw_info.version.arch_minor_rev,
   134	         hw_info.version.arch_patch_rev);
   135	    info("\tDriver:     v%" PRIu8 ".%" PRIu8 ".%" PRIu8 "\n",
   136	         driver_version.major,
   137	         driver_version.minor,
   138	         driver_version.patch);
   139	    info("\tMACs/cc:    %" PRIu32 "\n", (uint32_t)(1 << hw_info.cfg.macs_per_cc));
   140	    info("\tCmd stream: v%" PRIu32 "\n", hw_info.cfg.cmd_stream_version);
   141	
   142	    return 0;
   143	}

