    const std::vector<size_t>& expectedShape)
{
    auto tensor = model.GetInputTensor(index);
    if (!VerifyOneTensor(name, index, tensor, expectedShape)) {
        return false;
    }

    if (tensor->Bytes() != sourceBytes || sourceBits == nullptr) {
        LOG_ERR("%s[%u] input payload size mismatch",
                name, static_cast<unsigned int>(index));
        return false;
    }

    std::memcpy(tensor->GetData(), sourceBits, sourceBytes);
    LOG_INF("%s[%u] bound: %u bytes",
            name,
            static_cast<unsigned int>(index),
            static_cast<unsigned int>(sourceBytes));
    return true;
}

static float DecodeSmokeReference(const std::uint32_t bits)
{
    float value = 0.0F;
    std::memcpy(&value, &bits, sizeof(value));
    return value;
}

static int SmokeFloatToMicro(const float value)
{
    const double scaled = static_cast<double>(value) * 1000000.0;
    if (scaled > 2147483647.0) {
        return 2147483647;
    }
    if (scaled < -2147483648.0) {
        return (-2147483647 - 1);
    }
    return static_cast<int>(scaled >= 0.0 ? scaled + 0.5 : scaled - 0.5);
}

static unsigned int SmokeArgMax4(const float* values)
{
    unsigned int best = 0U;
    for (unsigned int i = 1U; i < 4U; ++i) {
        if (values[i] > values[best]) {
            best = i;
        }
    }
    return best;
}


static bool RunHeatstrokeSmokeInference(PolyUModel1& model)
{
    static_assert(sizeof(float) == sizeof(std::uint32_t),
                  "Smoke test requires 32-bit FP32");

    LOG_INF("=== THREE-SAMPLE HEATSTROKE MCU INFERENCE ===");
    LOG_INF("Multi-sample vector count: %u",
            static_cast<unsigned int>(heatstroke_smoke::kSampleCount));

    const auto& backendData = model.GetBackendData();
    if (!backendData.m_pInterpreter) {
        LOG_ERR("TFLM backend interpreter pointer is null");
        return false;
    }

    for (std::uint32_t slot = 0U;
         slot < heatstroke_smoke::kSampleCount; ++slot) {
        const auto& sample = heatstroke_smoke::kSamples[slot];

        LOG_INF("=== SAMPLE %u / %u ===",
                static_cast<unsigned int>(slot + 1U),
                static_cast<unsigned int>(heatstroke_smoke::kSampleCount));
        LOG_INF("Dataset position: %u; sample ID: %u",
                static_cast<unsigned int>(sample.dataset_position),
                static_cast<unsigned int>(sample.dataset_sample_id));
        LOG_INF("Missing positions: %u",
                static_cast<unsigned int>(sample.missing_count));
        LOG_INF("Ground-truth labels RPE=%u PSI=%u",
                static_cast<unsigned int>(sample.rpe_label),
                static_cast<unsigned int>(sample.psi_label));
        LOG_INF("Input-vector SHA256: %s", sample.input_sha256);

        const auto resetStatus = backendData.m_pInterpreter->Reset();
        if (resetStatus != kTfLiteOk) {
            LOG_ERR("MicroInterpreter::Reset failed; status=%d",
                    static_cast<int>(resetStatus));
            return false;
        }
        LOG_INF("MicroInterpreter::Reset: SUCCESS");

        if (!BindSmokeInputTensor(
                model, 0U, "x_values", sample.x_values_bits,
                5400U * sizeof(std::uint32_t),
                std::vector<size_t>{1U, 900U, 6U})) {
            return false;
        }
        if (!BindSmokeInputTensor(
                model, 1U, "missing_mask", sample.missing_mask_bits,
                5400U * sizeof(std::uint32_t),
                std::vector<size_t>{1U, 900U, 6U})) {
            return false;
        }
        if (!BindSmokeInputTensor(
                model, 2U, "x_mark", sample.x_mark_bits,
                2700U * sizeof(std::uint32_t),
                std::vector<size_t>{1U, 900U, 3U})) {
            return false;
        }
        if (!BindSmokeInputTensor(
                model, 3U, "worker_features", sample.worker_features_bits,
                30U * sizeof(std::uint32_t),
                std::vector<size_t>{1U, 30U})) {
            return false;
        }

        arm::app::fwk::tflm::ResetHeatstrokeOperatorTiming();
        const std::int64_t startMs = k_uptime_get();
        LOG_INF("HEATSTROKE_DIAG: entering TFLM RunInference()");
        StartHeatstrokeEthosuMonitor();
        const bool inferenceOk = model.RunInference();
        StopHeatstrokeEthosuMonitor();
        arm::app::fwk::tflm::LogHeatstrokeOperatorTiming();

        if (!inferenceOk) {
            LOG_ERR("TFLM RunInference() returned false for slot %u",
                    static_cast<unsigned int>(slot));
            return false;
        }
        const std::int64_t elapsedMs = k_uptime_get() - startMs;
