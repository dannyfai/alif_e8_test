]3008;start=a42095f2-0a52-42f5-9c1e-4928dae99b45;machineid=98c0083067a249a3a7325750b1c85d6f;user=user;hostname=user-Swift-SFL14-52M;bootid=d68672a6-a3c8-42e4-97be-02c8d7da21f2;pid=00000000000000182542;type=command;cwd=/home/user/sdk-alif\========== PATCHED KERNEL ==========
]3008;start=a42095f2-0a52-42f5-9c1e-4928dae99b45;machineid=98c0083067a249a3a7325750b1c85d6f;user=user;hostname=user-Swift-SFL14-52M;bootid=d68672a6-a3c8-42e4-97be-02c8d7da21f2;pid=00000000000000182542;type=command;cwd=/home/user/sdk-alif\    25	namespace tflite {
    26	
    27	namespace {
    28	constexpr int kInputTensor = 0;
    29	constexpr int kShapeTensor = 1;
    30	constexpr int kOutputTensor = 0;
    31	// Support a maximum of 5 dimensions in TFLM.
    32	constexpr int kMaxDims = 5;
    33	
    34	TfLiteStatus ValidateOutputTensor(TfLiteContext* context, TfLiteTensor* input,
    35	                                  TfLiteTensor* shape, TfLiteTensor* output) {
    36	  // Ensures the shape is a 1D tensor.
    37	  TF_LITE_ENSURE_EQ(context, NumDimensions(shape), 1);
    38	
    39	  const int input_num_dims = NumDimensions(input);
    40	  const int output_num_dims = NumDimensions(output);
    41	  const int shape_num_dims = SizeOfDimension(shape, 0);
    42	
    43	  TF_LITE_ENSURE_MSG(
    44	      context, output_num_dims == shape_num_dims,
    45	      "Output must match with the expected shape dimension.");
    46	
    47	  TF_LITE_ENSURE_MSG(
    48	      context, input_num_dims <= output_num_dims,
    49	      "Output shape must be broadcastable from input shape.");
    50	
    51	  TF_LITE_ENSURE_MSG(
    52	      context, output_num_dims <= kMaxDims,
    53	      "BroadcastTo only supports 1-5D tensor.");
    54	
    55	  // IMPORTANT:
    56	  //
    57	  // The shape input may be produced by an earlier operator such as
    58	  // BROADCAST_ARGS. During AllocateTensors(), TFLM calls Prepare()
    59	  // before invoking any operators. Therefore the runtime values in
    60	  // shape->data must not be read here.
    61	  //
    62	  // This TFLite model already declares the BROADCAST_TO output shape
    63	  // statically. Use those model dimensions for Prepare-time validation.
    64	  //
    65	  // BroadcastToEval() also uses the allocated output tensor dimensions
    66	  // to perform the actual broadcast.
    67	
    68	  const tflite::RuntimeShape output_shape =
    69	      tflite::GetTensorShape(output);
    70	
    71	  const int extending_dims = output_num_dims - input_num_dims;
    72	
    73	  for (int idx = 0; idx < input_num_dims; ++idx) {
    74	    const int input_dim = SizeOfDimension(input, idx);
    75	    const int output_dim =
    76	        output_shape.Dims(extending_dims + idx);
    77	
    78	    TF_LITE_ENSURE_MSG(
    79	        context,
    80	        input_dim == 1 || input_dim == output_dim,
    81	        "Output shape must be broadcastable from input shape "
    82	        "(static output dimensions).");
    83	  }
    84	
    85	  return kTfLiteOk;
    86	}
    87	
    88	TfLiteStatus BroadcastToPrepare(TfLiteContext* context, TfLiteNode* node) {
    89	  TF_LITE_ENSURE(context, NumInputs(node) == 2);
    90	  TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
    91	  MicroContext* micro_context = GetMicroContext(context);
    92	  TfLiteTensor* input =
    93	      micro_context->AllocateTempInputTensor(node, kInputTensor);
    94	  TfLiteTensor* shape =
    95	      micro_context->AllocateTempInputTensor(node, kShapeTensor);
    96	  TfLiteTensor* output =
    97	      micro_context->AllocateTempOutputTensor(node, kOutputTensor);
    98	
    99	  TF_LITE_ENSURE_MSG(context, (NumDimensions(input) <= kMaxDims),
   100	                     "BroadcastTo only supports 1-5D tensor.");
   101	
   102	  TF_LITE_ENSURE(context,
   103	                 shape->type == kTfLiteInt32 || shape->type == kTfLiteInt64);
   104	  TF_LITE_ENSURE_EQ(context, input->type, output->type);
   105	
   106	  // Does not support String type due to its variable size. This limitation is
   107	  // the same as TFLite.
   108	  TF_LITE_ENSURE(context, input->type != kTfLiteString);
   109	
   110	  TF_LITE_ENSURE_STATUS(ValidateOutputTensor(context, input, shape, output));
   111	  micro_context->DeallocateTempTfLiteTensor(input);
   112	  micro_context->DeallocateTempTfLiteTensor(shape);
   113	  micro_context->DeallocateTempTfLiteTensor(output);
   114	  return kTfLiteOk;
   115	}
