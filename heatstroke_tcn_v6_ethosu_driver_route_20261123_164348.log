   180	#if defined(CONFIG_PM_DEVICE)
   181	/**
   182	 * @brief Ethos-U PM device action handler
   183	 *
   184	 * Handles power management state transitions for the Ethos-U device.
   185	 * Coordinates with power domain via PM framework.
   186	 *
   187	 * @param dev Ethos-U device struct
   188	 * @param action PM device action
   189	 *
   190	 * @return 0 if successful, negative errno otherwise
   191	 */
   192	static int ethosu_pm_action(const struct device *dev, enum pm_device_action action)
   193	{
   194		int ret = 0;
   195		const struct ethosu_dts_info *config = dev->config;
   196		struct ethosu_data *data = dev->data;
   197		struct ethosu_driver *drv = &data->drv;
   198	
   199		switch (action) {
   200		case PM_DEVICE_ACTION_RESUME:
   201			return ethosu_zephyr_init(dev);
   202	
   203		case PM_DEVICE_ACTION_SUSPEND:
   204			/*
   205			 * Refuse to suspend while the NPU is reserved or an inference is
   206			 * in flight. Tearing down in that state would free the driver
   207			 * semaphore under an active job, and ethosu_deregister_driver()
   208			 * would block on the global handle semaphore while holding the
   209			 * driver mutex, deadlocking the subsystem.
   210			 */
   211			if (drv->reserved || drv->job.state != ETHOSU_JOB_IDLE) {
   212				return -EBUSY;
   213			}
   214	
   215			/*
   216			 * Enable NPU clock and power gating for low-power STOP mode.
   217			 * This writes NPU registers, so it must run while the NPU is
   218			 * still powered and accessible (before ethosu_deinit()).
   219			 */
   220			if (ethosu_dev_set_clock_and_power(&drv->dev, ETHOSU_CLOCK_Q_ENABLE,
   221							   ETHOSU_POWER_Q_ENABLE) != ETHOSU_SUCCESS) {
   222				return -EIO;
   223			}
   224	
   225			/*
   226			 * Disable the NPU IRQ before freeing the driver semaphore so a
   227			 * stale/pending interrupt cannot call ethosu_semaphore_give() on
   228			 * freed memory.
   229			 */
   230			irq_disable(config->irqn);
   231	
   232			/*
   233			 * Symmetric teardown: deregister the handle and free the driver
   234			 * semaphore so the next RESUME's ethosu_init() starts from a clean
   235			 * state. Retained SRAM would otherwise make
   236			 * ethosu_register_driver() splice the driver onto itself.
   237			 */
   238			ethosu_deinit(drv);
   239			return 0;
   240	
   241		case PM_DEVICE_ACTION_TURN_OFF:
   242		case PM_DEVICE_ACTION_TURN_ON:
   243			break;
   244	
   245		default:
   246			ret = -ENOTSUP;
   247			break;
   248		}
   249	
   250		return ret;
   251	}
   252	#endif /* CONFIG_PM_DEVICE */
