   134	
   135	void ethosu_zephyr_irq_handler(const struct device *dev)
   136	{
   137		struct ethosu_data *data = dev->data;
   138		struct ethosu_driver *drv = &data->drv;
   139	
   140		ethosu_irq_handler(drv);
