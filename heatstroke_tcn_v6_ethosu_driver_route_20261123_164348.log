   142	
   143	static int ethosu_zephyr_init(const struct device *dev)
   144	{
   145		const struct ethosu_dts_info *config = dev->config;
   146		struct ethosu_data *data = dev->data;
   147		struct ethosu_driver *drv = &data->drv;
   148		struct ethosu_driver_version version;
   149	
   150		LOG_DBG("Ethos-U DTS info. base_address=0x%p, secure_enable=%u, privilege_enable=%u",
   151			config->base_addr, config->secure_enable, config->privilege_enable);
   152	
   153		if (config->clk_dev != NULL) {
   154			if (!device_is_ready(config->clk_dev)) {
   155				LOG_ERR("Clock device not ready");
   156				return -ENODEV;
   157			}
   158			if (clock_control_on(config->clk_dev, config->clk_id)) {
   159				LOG_ERR("Failed to enable NPU clock");
   160				return -EIO;
   161			}
   162		}
   163	
   164		ethosu_get_driver_version(&version);
   165	
   166		LOG_DBG("Version. major=%u, minor=%u, patch=%u", version.major, version.minor,
   167			version.patch);
   168	
   169		if (ethosu_init(drv, config->base_addr, NULL, 0, config->secure_enable,
   170				config->privilege_enable)) {
   171			LOG_ERR("Failed to initialize NPU with ethosu_init().");
   172			return -EINVAL;
   173		}
   174	
   175		config->irq_config();
   176	
   177		return 0;
   178	}
