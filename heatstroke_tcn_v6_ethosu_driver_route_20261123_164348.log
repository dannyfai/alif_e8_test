    25	/*******************************************************************************
    26	 * Re-implementation/Overrides __((weak)) symbol functions from ethosu_driver.c
    27	 * To handle mutex and semaphores
    28	 *******************************************************************************/
    29	
    30	void *ethosu_mutex_create(void)
    31	{
    32		struct k_mutex *mutex;
    33	
    34		mutex = k_malloc(sizeof(*mutex));
    35		if (mutex == NULL) {
    36			LOG_ERR("Failed allocate mutex");
    37			return NULL;
    38		}
    39	
    40		k_mutex_init(mutex);
    41	
    42		return (void *)mutex;
    43	}
    44	
    45	int ethosu_mutex_lock(void *mutex)
    46	{
    47		int status;
    48	
    49		status = k_mutex_lock((struct k_mutex *)mutex, K_FOREVER);
    50		if (status != 0) {
    51			LOG_ERR("Failed to lock mutex with error - %d", status);
    52			return -1;
    53		}
    54	
    55		return 0;
    56	}
    57	
    58	int ethosu_mutex_unlock(void *mutex)
    59	{
    60		k_mutex_unlock((struct k_mutex *)mutex);
    61		return 0;
    62	}
    63	
    64	void *ethosu_semaphore_create(void)
    65	{
    66		struct k_sem *sem;
    67	
    68		sem = k_malloc(sizeof(*sem));
    69		if (sem == NULL) {
    70			LOG_ERR("Failed to allocate semaphore");
    71			return NULL;
    72		}
    73	
    74		k_sem_init(sem, 0, 100);
    75	
    76		return (void *)sem;
    77	}
    78	
    79	int ethosu_semaphore_take(void *sem, uint64_t timeout)
    80	{
    81		int status;
    82	
    83		status = k_sem_take((struct k_sem *)sem, (timeout == ETHOSU_SEMAPHORE_WAIT_FOREVER)
    84								 ? K_FOREVER
    85								 : Z_TIMEOUT_TICKS(timeout));
    86	
    87		if (status != 0) {
    88			/* The Ethos-U driver expects the semaphore implementation to never fail except for
    89			 * when a timeout occurs, and the current ethosu_semaphore_take implementation makes
    90			 * no distinction, in terms of return codes, between a timeout and other semaphore
    91			 * take failures. Also, note that a timeout is virtually indistinguishable from
    92			 * other failures if the driver logging is disabled. Handling errors other than a
    93			 * timeout is therefore not covered here and is deferred to the application
    94			 * developer if necessary.
    95			 */
    96			if (status != -EAGAIN) {
    97				LOG_ERR("Failed to take semaphore with error - %d", status);
    98			}
    99			return -1;
   100		}
   101	
   102		return 0;
   103	}
   104	
   105	int ethosu_semaphore_give(void *sem)
   106	{
   107		k_sem_give((struct k_sem *)sem);
   108		return 0;
   109	}
