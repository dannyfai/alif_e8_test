   254	#define ETHOSU_DEVICE_INIT(n)                                                                      \
   255		static struct ethosu_data ethosu_data_##n;                                                 \
   256	                                                                                                   \
   257		static void ethosu_zephyr_irq_config_##n(void)                                             \
   258		{                                                                                          \
   259			IRQ_CONNECT(DT_INST_IRQN(n), DT_INST_IRQ(n, priority), ethosu_zephyr_irq_handler,  \
   260				    DEVICE_DT_INST_GET(n), 0);                                             \
   261			irq_enable(DT_INST_IRQN(n));                                                       \
   262		}                                                                                          \
   263	                                                                                                   \
   264		static const struct ethosu_dts_info ethosu_dts_info_##n = {                                \
   265			.base_addr = (void *)DT_INST_REG_ADDR(n),                                          \
   266			.secure_enable = DT_INST_PROP(n, secure_enable),                                   \
   267			.privilege_enable = DT_INST_PROP(n, privilege_enable),                             \
   268			.irqn = DT_INST_IRQN(n),                                                           \
   269			.irq_config = &ethosu_zephyr_irq_config_##n,                                       \
   270			.clk_dev = COND_CODE_1(DT_INST_NODE_HAS_PROP(n, clocks),                           \
   271				(DEVICE_DT_GET(DT_INST_CLOCKS_CTLR(n))), (NULL)),			   \
   272			.clk_id = COND_CODE_1(DT_INST_NODE_HAS_PROP(n, clocks),                            \
   273				((clock_control_subsys_t)DT_INST_CLOCKS_CELL(n, clkid)), (NULL)),	   \
   274		};                                                                                         \
   275	                                                                                                   \
   276		PM_DEVICE_DT_INST_DEFINE(n, ethosu_pm_action);                                             \
   277	                                                                                                   \
   278		DEVICE_DT_INST_DEFINE(n, ethosu_zephyr_init, PM_DEVICE_DT_INST_GET(n), &ethosu_data_##n,   \
   279				      &ethosu_dts_info_##n, POST_KERNEL,                                   \
   280				      CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, NULL);
   281	
   282	DT_INST_FOREACH_STATUS_OKAY(ETHOSU_DEVICE_INIT);

