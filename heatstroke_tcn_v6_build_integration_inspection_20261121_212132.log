    51	/*
    52	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    53	 * required by this implementation. Validate its options type and leave
    54	 * builtin_data null.
    55	 */
    56	TfLiteStatus ParseHeatstrokeSign(
    57	    const tflite::Operator* op,
    58	    tflite::ErrorReporter*,
    59	    tflite::BuiltinDataAllocator*,
    60	    void** builtin_data)
    61	{
    62	    if (builtin_data != nullptr) {
    63	        *builtin_data = nullptr;
    64	    }
    65	
    66	    if (op == nullptr ||
    67	        op->builtin_options_type() !=
    68	            tflite::BuiltinOptions_SignOptions) {
    69	        return kTfLiteError;
    70	    }
    71	
    72	    return kTfLiteOk;
    73	}
    74	
    75	/*
    76	 * Application-local INT32 SIGN implementation.
    77	 *
    78	 * y = -1 when x < 0
    79	 * y =  0 when x = 0
    80	 * y =  1 when x > 0
    81	 *
    82	 * No temporary buffer or scratch allocation is required.
    83	 */
    84	TfLiteStatus HeatstrokeSignEval(
    85	    TfLiteContext* context,
    86	    TfLiteNode* node)
    87	{
    88	    if (context == nullptr || node == nullptr) {
    89	        return kTfLiteError;
    90	    }
    91	
    92	    const TfLiteEvalTensor* input =
    93	        tflite::micro::GetEvalInput(context, node, 0);
    94	
    95	    TfLiteEvalTensor* output =
    96	        tflite::micro::GetEvalOutput(context, node, 0);
    97	
    98	    if (input == nullptr || output == nullptr) {
    99	        return kTfLiteError;
   100	    }
   101	
   102	    if (input->type != kTfLiteInt32 ||
   103	        output->type != kTfLiteInt32) {
   104	        MicroPrintf(
   105	            "Heatstroke SIGN requires INT32 input/output. "
   106	            "Input=%d Output=%d",
   107	            input->type,
   108	            output->type);
   109	        return kTfLiteError;
   110	    }
   111	
   112	    const auto input_shape =
   113	        tflite::micro::GetTensorShape(input);
   114	
   115	    const auto output_shape =
   116	        tflite::micro::GetTensorShape(output);
   117	
   118	    const int input_count = input_shape.FlatSize();
   119	    const int output_count = output_shape.FlatSize();
   120	
   121	    if (input_count < 0 || input_count != output_count) {
   122	        MicroPrintf(
   123	            "Heatstroke SIGN tensor element-count mismatch.");
   124	        return kTfLiteError;
   125	    }
   126	
   127	    const int32_t* input_data =
   128	        tflite::micro::GetTensorData<int32_t>(input);
   129	
   130	    int32_t* output_data =
   131	        tflite::micro::GetTensorData<int32_t>(output);
   132	
   133	    if (input_count > 0 &&
   134	        (input_data == nullptr || output_data == nullptr)) {
   135	        MicroPrintf(
   136	            "Heatstroke SIGN received a null tensor data pointer.");
   137	        return kTfLiteError;
   138	    }
   139	
   140	    for (int i = 0; i < input_count; ++i) {
   141	        const int32_t value = input_data[i];
   142	
   143	        output_data[i] =
   144	            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
   145	    }
   146	
   147	    return kTfLiteOk;
   148	}
   149	
   150	TFLMRegistration RegisterHeatstrokeSignKernel()
   151	{
   152	    return tflite::micro::RegisterOp(
   153	        nullptr,
   154	        nullptr,
   155	        HeatstrokeSignEval);
   156	}
