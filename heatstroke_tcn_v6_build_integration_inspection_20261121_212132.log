   189	template <typename InputT, typename IndexT>
   190	TfLiteStatus HeatstrokeGatherCopy(
   191	    const TfLiteGatherParams* params,
   192	    const TfLiteEvalTensor* input,
   193	    const TfLiteEvalTensor* indices,
   194	    TfLiteEvalTensor* output)
   195	{
   196	    if (params == nullptr || input == nullptr ||
   197	        indices == nullptr || output == nullptr ||
   198	        input->dims == nullptr || indices->dims == nullptr ||
   199	        output->dims == nullptr) {
   200	        MicroPrintf("Heatstroke GATHER received invalid tensor metadata.");
   201	        return kTfLiteError;
   202	    }
   203	
   204	    const TfLiteIntArray* input_dims = input->dims;
   205	    const TfLiteIntArray* index_dims = indices->dims;
