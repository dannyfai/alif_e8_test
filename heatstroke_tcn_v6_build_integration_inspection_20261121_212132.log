   176	bool HeatstrokeGatherCheckedMultiply(
   177	    size_t a, size_t b, size_t* result)
   178	{
   179	    if (result == nullptr ||
   180	        (b != 0U &&
   181	         a > (std::numeric_limits<size_t>::max)() / b)) {
   182	        return false;
   183	    }
   184	
   185	    *result = a * b;
   186	    return true;
   187	}
