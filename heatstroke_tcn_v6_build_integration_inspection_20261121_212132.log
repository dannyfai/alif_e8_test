    43	/*
    44	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    45	 * required by this implementation. Validate its options type and leave
    46	 * builtin_data null.
    47	 */
    48	TfLiteStatus ParseHeatstrokeSign(
    49	    const tflite::Operator* op,
    50	    tflite::ErrorReporter*,
    51	    tflite::BuiltinDataAllocator*,
    52	    void** builtin_data)
    53	{
    54	    if (builtin_data != nullptr) {
    55	        *builtin_data = nullptr;
    56	    }
    57	
    58	    if (op == nullptr ||
    59	        op->builtin_options_type() !=
    60	            tflite::BuiltinOptions_SignOptions) {
    61	        return kTfLiteError;
    62	    }
    63	
    64	    return kTfLiteOk;
    65	}
    66	
    67	/*
    68	 * Application-local INT32 SIGN implementation.
    69	 *
    70	 * y = -1 when x < 0
    71	 * y =  0 when x = 0
    72	 * y =  1 when x > 0
    73	 *
    74	 * No temporary buffer or scratch allocation is required.
    75	 */
    76	TfLiteStatus HeatstrokeSignEval(
    77	    TfLiteContext* context,
    78	    TfLiteNode* node)
    79	{
    80	    if (context == nullptr || node == nullptr) {
    81	        return kTfLiteError;
    82	    }
    83	
    84	    const TfLiteEvalTensor* input =
    85	        tflite::micro::GetEvalInput(context, node, 0);
    86	
    87	    TfLiteEvalTensor* output =
    88	        tflite::micro::GetEvalOutput(context, node, 0);
    89	
    90	    if (input == nullptr || output == nullptr) {
    91	        return kTfLiteError;
    92	    }
    93	
    94	    if (input->type != kTfLiteInt32 ||
    95	        output->type != kTfLiteInt32) {
    96	        MicroPrintf(
    97	            "Heatstroke SIGN requires INT32 input/output. "
    98	            "Input=%d Output=%d",
    99	            input->type,
   100	            output->type);
   101	        return kTfLiteError;
   102	    }
   103	
   104	    const auto input_shape =
   105	        tflite::micro::GetTensorShape(input);
   106	
   107	    const auto output_shape =
   108	        tflite::micro::GetTensorShape(output);
   109	
   110	    const int input_count = input_shape.FlatSize();
   111	    const int output_count = output_shape.FlatSize();
   112	
   113	    if (input_count < 0 || input_count != output_count) {
   114	        MicroPrintf(
   115	            "Heatstroke SIGN tensor element-count mismatch.");
   116	        return kTfLiteError;
   117	    }
   118	
   119	    const int32_t* input_data =
   120	        tflite::micro::GetTensorData<int32_t>(input);
   121	
   122	    int32_t* output_data =
   123	        tflite::micro::GetTensorData<int32_t>(output);
   124	
   125	    if (input_count > 0 &&
   126	        (input_data == nullptr || output_data == nullptr)) {
   127	        MicroPrintf(
   128	            "Heatstroke SIGN received a null tensor data pointer.");
   129	        return kTfLiteError;
   130	    }
   131	
   132	    for (int i = 0; i < input_count; ++i) {
   133	        const int32_t value = input_data[i];
   134	
   135	        output_data[i] =
   136	            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
   137	    }
   138	
   139	    return kTfLiteOk;
   140	}
   141	
   142	TFLMRegistration RegisterHeatstrokeSignKernel()
   143	{
   144	    return tflite::micro::RegisterOp(
   145	        nullptr,
   146	        nullptr,
   147	        HeatstrokeSignEval);
   148	}
