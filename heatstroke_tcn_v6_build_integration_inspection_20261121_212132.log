   210	    if (input_rank <= 0 || index_rank < 0) {
   211	        MicroPrintf("Heatstroke GATHER received an invalid tensor rank.");
   212	        return kTfLiteError;
   213	    }
   214	
   215	    int axis = params->axis;
   216	    if (axis < 0) {
   217	        axis += input_rank;
   218	    }
   219	
   220	    if (axis < 0 || axis >= input_rank) {
   221	        MicroPrintf("Heatstroke GATHER axis is out of range.");
   222	        return kTfLiteError;
   223	    }
   224	
   225	    int batch_dims = params->batch_dims;
   226	    if (batch_dims < 0) {
   227	        batch_dims += index_rank;
   228	    }
   229	
   230	    if (batch_dims < 0 ||
   231	        batch_dims > axis ||
   232	        batch_dims >= input_rank ||
   233	        batch_dims > index_rank) {
   234	        MicroPrintf("Heatstroke GATHER batch_dims is invalid.");
   235	        return kTfLiteError;
   236	    }
   237	
   238	    for (int i = 0; i < input_rank; ++i) {
   239	        if (input_dims->data[i] < 0) {
   240	            MicroPrintf("Heatstroke GATHER has a negative input dimension.");
