   164	bool HeatstrokeGatherCheckedMultiply(
   165	    size_t a, size_t b, size_t* result)
   166	{
   167	    if (result == nullptr ||
   168	        (b != 0U &&
   169	         a > (std::numeric_limits<size_t>::max)() / b)) {
   170	        return false;
   171	    }
   172	
   173	    *result = a * b;
   174	    return true;
   175	}
   176	
   177	template <typename InputT, typename IndexT>
   178	TfLiteStatus HeatstrokeGatherCopy(
   179	    const TfLiteGatherParams* params,
