    47	/*
    48	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    49	 * required by this implementation. Validate its options type and leave
    50	 * builtin_data null.
    51	 */
    52	TfLiteStatus ParseHeatstrokeSign(
    53	    const tflite::Operator* op,
    54	    tflite::ErrorReporter*,
    55	    tflite::BuiltinDataAllocator*,
    56	    void** builtin_data)
    57	{
    58	    if (builtin_data != nullptr) {
    59	        *builtin_data = nullptr;
    60	    }
    61	
    62	    if (op == nullptr ||
    63	        op->builtin_options_type() !=
    64	            tflite::BuiltinOptions_SignOptions) {
    65	        return kTfLiteError;
    66	    }
    67	
    68	    return kTfLiteOk;
    69	}
    70	
    71	/*
    72	 * Application-local INT32 SIGN implementation.
    73	 *
    74	 * y = -1 when x < 0
    75	 * y =  0 when x = 0
    76	 * y =  1 when x > 0
    77	 *
    78	 * No temporary buffer or scratch allocation is required.
    79	 */
    80	TfLiteStatus HeatstrokeSignEval(
    81	    TfLiteContext* context,
    82	    TfLiteNode* node)
    83	{
    84	    if (context == nullptr || node == nullptr) {
    85	        return kTfLiteError;
    86	    }
    87	
    88	    const TfLiteEvalTensor* input =
    89	        tflite::micro::GetEvalInput(context, node, 0);
    90	
    91	    TfLiteEvalTensor* output =
    92	        tflite::micro::GetEvalOutput(context, node, 0);
    93	
    94	    if (input == nullptr || output == nullptr) {
    95	        return kTfLiteError;
    96	    }
    97	
    98	    if (input->type != kTfLiteInt32 ||
    99	        output->type != kTfLiteInt32) {
   100	        MicroPrintf(
   101	            "Heatstroke SIGN requires INT32 input/output. "
   102	            "Input=%d Output=%d",
   103	            input->type,
   104	            output->type);
   105	        return kTfLiteError;
   106	    }
   107	
   108	    const auto input_shape =
   109	        tflite::micro::GetTensorShape(input);
   110	
   111	    const auto output_shape =
   112	        tflite::micro::GetTensorShape(output);
   113	
   114	    const int input_count = input_shape.FlatSize();
   115	    const int output_count = output_shape.FlatSize();
   116	
   117	    if (input_count < 0 || input_count != output_count) {
   118	        MicroPrintf(
   119	            "Heatstroke SIGN tensor element-count mismatch.");
   120	        return kTfLiteError;
   121	    }
   122	
   123	    const int32_t* input_data =
   124	        tflite::micro::GetTensorData<int32_t>(input);
   125	
   126	    int32_t* output_data =
   127	        tflite::micro::GetTensorData<int32_t>(output);
   128	
   129	    if (input_count > 0 &&
   130	        (input_data == nullptr || output_data == nullptr)) {
   131	        MicroPrintf(
   132	            "Heatstroke SIGN received a null tensor data pointer.");
   133	        return kTfLiteError;
   134	    }
   135	
   136	    for (int i = 0; i < input_count; ++i) {
   137	        const int32_t value = input_data[i];
   138	
   139	        output_data[i] =
   140	            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
   141	    }
   142	
   143	    return kTfLiteOk;
   144	}
   145	
   146	TFLMRegistration RegisterHeatstrokeSignKernel()
   147	{
   148	    return tflite::micro::RegisterOp(
   149	        nullptr,
   150	        nullptr,
   151	        HeatstrokeSignEval);
   152	}
