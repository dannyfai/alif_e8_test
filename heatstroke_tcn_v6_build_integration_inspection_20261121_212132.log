   219	        batch_dims > axis ||
   220	        batch_dims >= input_rank ||
   221	        batch_dims > index_rank) {
   222	        MicroPrintf("Heatstroke GATHER batch_dims is invalid.");
   223	        return kTfLiteError;
   224	    }
   225	
   226	    for (int i = 0; i < input_rank; ++i) {
   227	        if (input_dims->data[i] < 0) {
