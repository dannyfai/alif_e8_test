    60	using HeatstrokeInvokeFunction =
    61	    TfLiteStatus (*)(TfLiteContext*, TfLiteNode*);
    62	
    63	struct HeatstrokeOperatorTiming
    64	{
    65	    std::uint32_t calls{0};
    66	    std::uint64_t total_cycles{0};
    67	    std::uint64_t total_wall_ms{0};
    68	    std::uint64_t max_wall_ms{0};
    69	};
    70	
    71	constexpr std::uint32_t kHeatstrokeMaxBiLstmCalls = 4;
    72	
    73	struct HeatstrokeBiLstmCallDetail
    74	{
    75	    std::uint64_t cycles{0};
    76	    std::uint64_t wall_ms{0};
    77	    std::int32_t input_count{-1};
    78	    std::int32_t output_count{-1};
    79	    std::int32_t input_indices[8] = {-1,-1,-1,-1,-1,-1,-1,-1};
    80	    std::int32_t output_indices[4] = {-1,-1,-1,-1};
    81	};
    82	
    83	HeatstrokeBiLstmCallDetail
    84	    g_heatstrokeBiLstmCallDetails[kHeatstrokeMaxBiLstmCalls]{};
    85	
    86	HeatstrokeInvokeFunction g_heatstrokeOriginalEthosUInvoke = nullptr;
    87	HeatstrokeInvokeFunction g_heatstrokeOriginalBiLstmInvoke = nullptr;
    88	
    89	HeatstrokeOperatorTiming g_heatstrokeEthosUTiming{};
    90	HeatstrokeOperatorTiming g_heatstrokeBiLstmTiming{};
    91	
    92	bool g_heatstrokeTimingHookStatusLogged = false;
    93	
    94	void RecordHeatstrokeOperatorTiming(
    95	    HeatstrokeOperatorTiming& stats,
    96	    std::uint64_t elapsed_cycles,
    97	    std::uint64_t elapsed_ms)
    98	{
    99	    ++stats.calls;
   100	    stats.total_cycles += elapsed_cycles;
   101	    stats.total_wall_ms += elapsed_ms;
   102	
   103	    if (elapsed_ms > stats.max_wall_ms) {
   104	        stats.max_wall_ms = elapsed_ms;
   105	    }
   106	}
   107	
   108	TfLiteStatus HeatstrokeTimedEthosUInvoke(
   109	    TfLiteContext* context,
   110	    TfLiteNode* node)
   111	{
   112	    if (g_heatstrokeOriginalEthosUInvoke == nullptr) {
   113	        return kTfLiteError;
   114	    }
   115	
   116	    const std::uint64_t cycles_start = k_cycle_get_64();
   117	    const std::int64_t time_start_ms = k_uptime_get();
   118	
   119	    const TfLiteStatus result =
   120	        g_heatstrokeOriginalEthosUInvoke(context, node);
   121	
   122	    const std::int64_t time_end_ms = k_uptime_get();
   123	    const std::uint64_t cycles_end = k_cycle_get_64();
   124	
   125	    const std::uint64_t elapsed_ms =
   126	        (time_end_ms >= time_start_ms)
   127	            ? static_cast<std::uint64_t>(time_end_ms - time_start_ms)
   128	            : 0U;
   129	
   130	    RecordHeatstrokeOperatorTiming(
   131	        g_heatstrokeEthosUTiming,
   132	        cycles_end - cycles_start,
   133	        elapsed_ms);
   134	
   135	    return result;
   136	}
   137	
   138	TfLiteStatus HeatstrokeTimedBiLstmInvoke(
   139	    TfLiteContext* context,
   140	    TfLiteNode* node)
   141	{
   142	    if (g_heatstrokeOriginalBiLstmInvoke == nullptr) {
   143	        return kTfLiteError;
   144	    }
   145	
   146	
   147	    const std::uint32_t call_index = g_heatstrokeBiLstmTiming.calls;
   148	    HeatstrokeBiLstmCallDetail* call_detail =
   149	        (call_index < kHeatstrokeMaxBiLstmCalls)
   150	            ? &g_heatstrokeBiLstmCallDetails[call_index]
   151	            : nullptr;
   152	
   153	    if (call_detail != nullptr && node != nullptr) {
   154	        if (node->inputs != nullptr) {
   155	            call_detail->input_count = node->inputs->size;
   156	            for (int i = 0; i < node->inputs->size && i < 8; ++i) {
   157	                call_detail->input_indices[i] = node->inputs->data[i];
   158	            }
   159	        }
   160	
   161	        if (node->outputs != nullptr) {
   162	            call_detail->output_count = node->outputs->size;
   163	            for (int i = 0; i < node->outputs->size && i < 4; ++i) {
   164	                call_detail->output_indices[i] = node->outputs->data[i];
   165	            }
   166	        }
   167	    }
   168	
   169	    const std::uint64_t cycles_start = k_cycle_get_64();
   170	    const std::int64_t time_start_ms = k_uptime_get();
   171	
   172	    const TfLiteStatus result =
   173	        g_heatstrokeOriginalBiLstmInvoke(context, node);
   174	
   175	    const std::int64_t time_end_ms = k_uptime_get();
   176	    const std::uint64_t cycles_end = k_cycle_get_64();
   177	
   178	    const std::uint64_t elapsed_ms =
   179	        (time_end_ms >= time_start_ms)
   180	            ? static_cast<std::uint64_t>(time_end_ms - time_start_ms)
   181	            : 0U;
   182	
   183	    if (call_detail != nullptr) {
   184	        call_detail->cycles = cycles_end - cycles_start;
   185	        call_detail->wall_ms = elapsed_ms;
   186	    }
   187	
   188	    RecordHeatstrokeOperatorTiming(
   189	        g_heatstrokeBiLstmTiming,
   190	        cycles_end - cycles_start,
   191	        elapsed_ms);
   192	
   193	    return result;
   194	}
