    55	/*
    56	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    57	 * required by this implementation. Validate its options type and leave
    58	 * builtin_data null.
    59	 */
    60	TfLiteStatus ParseHeatstrokeSign(
    61	    const tflite::Operator* op,
    62	    tflite::ErrorReporter*,
    63	    tflite::BuiltinDataAllocator*,
    64	    void** builtin_data)
    65	{
    66	    if (builtin_data != nullptr) {
    67	        *builtin_data = nullptr;
    68	    }
    69	
    70	    if (op == nullptr ||
    71	        op->builtin_options_type() !=
    72	            tflite::BuiltinOptions_SignOptions) {
    73	        return kTfLiteError;
    74	    }
    75	
    76	    return kTfLiteOk;
    77	}
    78	
    79	/*
    80	 * Application-local INT32 SIGN implementation.
    81	 *
    82	 * y = -1 when x < 0
    83	 * y =  0 when x = 0
    84	 * y =  1 when x > 0
    85	 *
    86	 * No temporary buffer or scratch allocation is required.
    87	 */
    88	TfLiteStatus HeatstrokeSignEval(
    89	    TfLiteContext* context,
    90	    TfLiteNode* node)
    91	{
    92	    if (context == nullptr || node == nullptr) {
    93	        return kTfLiteError;
    94	    }
    95	
    96	    const TfLiteEvalTensor* input =
    97	        tflite::micro::GetEvalInput(context, node, 0);
    98	
    99	    TfLiteEvalTensor* output =
   100	        tflite::micro::GetEvalOutput(context, node, 0);
   101	
   102	    if (input == nullptr || output == nullptr) {
   103	        return kTfLiteError;
   104	    }
   105	
   106	    if (input->type != kTfLiteInt32 ||
   107	        output->type != kTfLiteInt32) {
   108	        MicroPrintf(
   109	            "Heatstroke SIGN requires INT32 input/output. "
   110	            "Input=%d Output=%d",
   111	            input->type,
   112	            output->type);
   113	        return kTfLiteError;
   114	    }
   115	
   116	    const auto input_shape =
   117	        tflite::micro::GetTensorShape(input);
   118	
   119	    const auto output_shape =
   120	        tflite::micro::GetTensorShape(output);
   121	
   122	    const int input_count = input_shape.FlatSize();
   123	    const int output_count = output_shape.FlatSize();
   124	
   125	    if (input_count < 0 || input_count != output_count) {
   126	        MicroPrintf(
   127	            "Heatstroke SIGN tensor element-count mismatch.");
   128	        return kTfLiteError;
   129	    }
   130	
   131	    const int32_t* input_data =
   132	        tflite::micro::GetTensorData<int32_t>(input);
   133	
   134	    int32_t* output_data =
   135	        tflite::micro::GetTensorData<int32_t>(output);
   136	
   137	    if (input_count > 0 &&
   138	        (input_data == nullptr || output_data == nullptr)) {
   139	        MicroPrintf(
   140	            "Heatstroke SIGN received a null tensor data pointer.");
   141	        return kTfLiteError;
   142	    }
   143	
   144	    for (int i = 0; i < input_count; ++i) {
   145	        const int32_t value = input_data[i];
   146	
   147	        output_data[i] =
   148	            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
   149	    }
   150	
   151	    return kTfLiteOk;
   152	}
   153	
   154	TFLMRegistration RegisterHeatstrokeSignKernel()
   155	{
   156	    return tflite::micro::RegisterOp(
   157	        nullptr,
   158	        nullptr,
   159	        HeatstrokeSignEval);
   160	}
   161	
   162	} // namespace
   163	
   164	
   165	namespace tflite {
   166	namespace {
   167	
   168	constexpr int kHsGatherInput = 0;
   169	constexpr int kHsGatherIndices = 1;
   170	constexpr int kHsGatherOutput = 0;
   171	
   172	bool HeatstrokeGatherCheckedMultiply(
   173	    size_t a, size_t b, size_t* result)
   174	{
   175	    if (result == nullptr ||
   176	        (b != 0U &&
   177	         a > (std::numeric_limits<size_t>::max)() / b)) {
   178	        return false;
   179	    }
   180	
   181	    *result = a * b;
   182	    return true;
   183	}
   184	
   185	template <typename InputT, typename IndexT>
   186	TfLiteStatus HeatstrokeGatherCopy(
   187	    const TfLiteGatherParams* params,
   188	    const TfLiteEvalTensor* input,
   189	    const TfLiteEvalTensor* indices,
   190	    TfLiteEvalTensor* output)
   191	{
   192	    if (params == nullptr || input == nullptr ||
   193	        indices == nullptr || output == nullptr ||
   194	        input->dims == nullptr || indices->dims == nullptr ||
   195	        output->dims == nullptr) {
   196	        MicroPrintf("Heatstroke GATHER received invalid tensor metadata.");
   197	        return kTfLiteError;
   198	    }
   199	
   200	    const TfLiteIntArray* input_dims = input->dims;
   201	    const TfLiteIntArray* index_dims = indices->dims;
   202	
   203	    const int input_rank = input_dims->size;
   204	    const int index_rank = index_dims->size;
   205	
   206	    if (input_rank <= 0 || index_rank < 0) {
   207	        MicroPrintf("Heatstroke GATHER received an invalid tensor rank.");
   208	        return kTfLiteError;
   209	    }
   210	
   211	    int axis = params->axis;
   212	    if (axis < 0) {
   213	        axis += input_rank;
   214	    }
   215	
   216	    if (axis < 0 || axis >= input_rank) {
   217	        MicroPrintf("Heatstroke GATHER axis is out of range.");
   218	        return kTfLiteError;
   219	    }
   220	
   221	    int batch_dims = params->batch_dims;
   222	    if (batch_dims < 0) {
   223	        batch_dims += index_rank;
   224	    }
   225	
   226	    if (batch_dims < 0 ||
   227	        batch_dims > axis ||
   228	        batch_dims >= input_rank ||
   229	        batch_dims > index_rank) {
   230	        MicroPrintf("Heatstroke GATHER batch_dims is invalid.");
   231	        return kTfLiteError;
   232	    }
   233	
   234	    for (int i = 0; i < input_rank; ++i) {
   235	        if (input_dims->data[i] < 0) {
   236	            MicroPrintf("Heatstroke GATHER has a negative input dimension.");
   237	            return kTfLiteError;
   238	        }
   239	    }
   240	
   241	    for (int i = 0; i < index_rank; ++i) {
   242	        if (index_dims->data[i] < 0) {
   243	            MicroPrintf("Heatstroke GATHER has a negative index dimension.");
   244	            return kTfLiteError;
   245	        }
   246	    }
   247	
   248	    for (int i = 0; i < batch_dims; ++i) {
   249	        if (input_dims->data[i] != index_dims->data[i]) {
   250	            MicroPrintf("Heatstroke GATHER batch dimensions do not match.");
   251	            return kTfLiteError;
   252	        }
   253	    }
   254	
   255	    const int axis_size = input_dims->data[axis];
   256	
   257	    size_t batch_size = 1U;
   258	    size_t outer_size = 1U;
   259	    size_t inner_size = 1U;
   260	    size_t coord_size = 1U;

