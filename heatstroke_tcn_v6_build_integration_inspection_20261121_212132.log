    59	/*
    60	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    61	 * required by this implementation. Validate its options type and leave
    62	 * builtin_data null.
    63	 */
    64	TfLiteStatus ParseHeatstrokeSign(
    65	    const tflite::Operator* op,
    66	    tflite::ErrorReporter*,
    67	    tflite::BuiltinDataAllocator*,
    68	    void** builtin_data)
    69	{
    70	    if (builtin_data != nullptr) {
    71	        *builtin_data = nullptr;
    72	    }
    73	
    74	    if (op == nullptr ||
    75	        op->builtin_options_type() !=
    76	            tflite::BuiltinOptions_SignOptions) {
    77	        return kTfLiteError;
    78	    }
    79	
    80	    return kTfLiteOk;
    81	}
    82	
    83	/*
    84	 * Application-local INT32 SIGN implementation.
    85	 *
    86	 * y = -1 when x < 0
    87	 * y =  0 when x = 0
    88	 * y =  1 when x > 0
    89	 *
    90	 * No temporary buffer or scratch allocation is required.
    91	 */
    92	TfLiteStatus HeatstrokeSignEval(
    93	    TfLiteContext* context,
    94	    TfLiteNode* node)
    95	{
    96	    if (context == nullptr || node == nullptr) {
    97	        return kTfLiteError;
    98	    }
    99	
   100	    const TfLiteEvalTensor* input =
   101	        tflite::micro::GetEvalInput(context, node, 0);
   102	
   103	    TfLiteEvalTensor* output =
   104	        tflite::micro::GetEvalOutput(context, node, 0);
   105	
   106	    if (input == nullptr || output == nullptr) {
   107	        return kTfLiteError;
   108	    }
   109	
   110	    if (input->type != kTfLiteInt32 ||
   111	        output->type != kTfLiteInt32) {
   112	        MicroPrintf(
   113	            "Heatstroke SIGN requires INT32 input/output. "
   114	            "Input=%d Output=%d",
   115	            input->type,
   116	            output->type);
   117	        return kTfLiteError;
   118	    }
   119	
   120	    const auto input_shape =
   121	        tflite::micro::GetTensorShape(input);
   122	
   123	    const auto output_shape =
   124	        tflite::micro::GetTensorShape(output);
   125	
   126	    const int input_count = input_shape.FlatSize();
   127	    const int output_count = output_shape.FlatSize();
   128	
   129	    if (input_count < 0 || input_count != output_count) {
   130	        MicroPrintf(
   131	            "Heatstroke SIGN tensor element-count mismatch.");
   132	        return kTfLiteError;
   133	    }
   134	
   135	    const int32_t* input_data =
   136	        tflite::micro::GetTensorData<int32_t>(input);
   137	
   138	    int32_t* output_data =
   139	        tflite::micro::GetTensorData<int32_t>(output);
   140	
   141	    if (input_count > 0 &&
   142	        (input_data == nullptr || output_data == nullptr)) {
   143	        MicroPrintf(
   144	            "Heatstroke SIGN received a null tensor data pointer.");
   145	        return kTfLiteError;
   146	    }
   147	
   148	    for (int i = 0; i < input_count; ++i) {
   149	        const int32_t value = input_data[i];
   150	
   151	        output_data[i] =
   152	            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
   153	    }
   154	
   155	    return kTfLiteOk;
   156	}
   157	
   158	TFLMRegistration RegisterHeatstrokeSignKernel()
   159	{
   160	    return tflite::micro::RegisterOp(
   161	        nullptr,
   162	        nullptr,
   163	        HeatstrokeSignEval);
   164	}
