   197	const tflite::MicroOpResolver&
   198	arm::app::fwk::tflm::PolyUModel1::GetOpResolver()
   199	{
   200	    const char* ethos_name = tflite::GetString_ETHOSU();
   201	
   202	    /*
   203	     * The resolver's registrations_ array is public and mutable in this
   204	     * SDK version. Modify its entries directly before the interpreter
   205	     * captures their registration pointers.
   206	     *
   207	     * Keep every original callback and replace only invoke.
   208	     */
   209	    for (unsigned int i = 0;
   210	         i < this->m_opResolver.registrations_len_;
   211	         ++i) {
   212	
   213	        TFLMRegistration& registration =
   214	            this->m_opResolver.registrations_[i];
   215	
   216	        if (registration.builtin_code ==
   217	            tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM) {
   218	
   219	            if (registration.invoke != nullptr &&
   220	                registration.invoke != &HeatstrokeTimedBiLstmInvoke) {
   221	
   222	                g_heatstrokeOriginalBiLstmInvoke = registration.invoke;
   223	                registration.invoke = &HeatstrokeTimedBiLstmInvoke;
   224	            }
   225	        }
   226	
   227	        if (registration.builtin_code ==
   228	                tflite::BuiltinOperator_CUSTOM &&
   229	            ethos_name != nullptr &&
   230	            registration.custom_name != nullptr &&
   231	            std::strcmp(registration.custom_name, ethos_name) == 0) {
   232	
   233	            if (registration.invoke != nullptr &&
   234	                registration.invoke != &HeatstrokeTimedEthosUInvoke) {
   235	
   236	                g_heatstrokeOriginalEthosUInvoke = registration.invoke;
   237	                registration.invoke = &HeatstrokeTimedEthosUInvoke;
   238	            }
   239	        }
   240	    }
   241	
   242	    if (!g_heatstrokeTimingHookStatusLogged) {
   243	        printk("HEATSTROKE_PROFILE_HOOKS: Ethos-U=%s BiLSTM=%s\n",
   244	            g_heatstrokeOriginalEthosUInvoke != nullptr
   245	                ? "installed" : "missing",
   246	            g_heatstrokeOriginalBiLstmInvoke != nullptr
   247	                ? "installed" : "missing");
   248	
   249	        g_heatstrokeTimingHookStatusLogged = true;
   250	    }
   251	
   252	    return this->m_opResolver;
   253	}
