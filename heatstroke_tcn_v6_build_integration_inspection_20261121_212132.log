   177	
   178	
   179	volatile uint8_t button_pressed = 0U;
   180	static struct gpio_callback button_cb_data;
   181	static bool por_boot;
   182	static struct k_sem button_wait_sem;
   183	
   184	static void button_callback(const struct device *dev, struct gpio_callback *cb, uint32_t pins)
   185	{
   186		ARG_UNUSED(dev);
   187		ARG_UNUSED(cb);
   188		ARG_UNUSED(pins);
   189	
   190		if (por_boot) {
   191			/* Ignore button press event if it's from POR boot, as the button state may be unstable during POR. */
   192			return;
   193		}
   194	
   195		int val = gpio_pin_get_dt(&lpgpio_config);  // 1 = pressed, 0 = released
   196	    if (val < 0) {
   197	        LOG_ERR("Failed to read pin: %d", val);
   198	        return;
   199	    }
   200	
   201	    button_pressed = (val == 1);
   202	    LOG_INF("Button %s", button_pressed ? "pressed" : "released");
   203	
   204		if (!k_sem_count_get(&button_wait_sem) && button_pressed) {
   205			k_sem_give(&button_wait_sem);
   206		}
   207	}
   208	
   209	/**
   210	 * Configure LPGPIO0 and LPGPIO1 as inputs with interrupts
   211	 * With B1/E1C need to connect wire between SW5 (P5_7) and P15_0 to use button as Push-to-talk button.
   212	 * With B1/E1C devkit you need to also remove resistor R64. */
   213	static int configure_lpgpio(void)
   214	{
   215		int ret;
   216		const struct gpio_dt_spec *spec = &lpgpio_config;
   217	
   218		if (!spec || !spec->port) {
   219			/* Just ignore */
   220			LOG_ERR("lpgpio invalid");
   221			return -ENODEV;
   222		}
   223	
   224		/* Configure LPGPIO0 for wakeup */
   225		if (!gpio_is_ready_dt(spec)) {
   226			LOG_ERR("LPGPIO0 device is not ready");
   227			return -ENODEV;
   228		}
   229	
   230		ret = gpio_pin_configure_dt(spec, GPIO_INPUT | spec->dt_flags);
   231		if (ret != 0) {
   232			LOG_ERR("Failed to configure LPGPIO as input: %d", ret);
   233			return ret;
   234		}
   235	
   236		ret = gpio_pin_interrupt_configure_dt(spec,
   237						      GPIO_INT_EDGE_BOTH);
   238		if (ret != 0) {
   239			LOG_ERR("Failed to configure LPGPIO interrupt: %d", ret);
   240			return ret;
   241		}
   242	
   243		gpio_init_callback(&button_cb_data, button_callback, BIT(spec->pin));
   244		ret = gpio_add_callback(spec->port, &button_cb_data);
   245		if (ret != 0) {
   246			LOG_ERR("Failed to add button callback: %d", ret);
   247			return ret;
   248		}
   249	
   250		LOG_INF("LPGPIO%d configured", spec->pin);
   251	
   252		return 0;
   253	}
