   308	static bool VerifyTensorInterface(const arm::app::fwk::iface::Model& model)
   309	{
   310	    if (model.GetNumInputs() != 4U || model.GetNumOutputs() != 2U) {
   311	        LOG_ERR("Model I/O count mismatch: inputs=%u outputs=%u; expected 4/2",
   312	                static_cast<unsigned int>(model.GetNumInputs()),
   313	                static_cast<unsigned int>(model.GetNumOutputs()));
   314	        return false;
   315	    }
   316	
   317	    const std::vector<std::vector<size_t>> expectedInputs = {
   318	        {1U, 900U, 6U},  /* x_values */
   319	        {1U, 900U, 6U},  /* missing_mask */
   320	        {1U, 900U, 3U},  /* x_mark */
   321	        {1U, 30U}        /* worker_features */
   322	    };
   323	
   324	    const char* inputNames[] = {
   325	        "x_values", "missing_mask", "x_mark", "worker_features"
   326	    };
   327	
   328	    for (size_t i = 0; i < expectedInputs.size(); ++i) {
   329	        if (!VerifyOneTensor(
   330	                "Input", i, model.GetInputTensor(i), expectedInputs[i])) {
   331	            LOG_ERR("Input contract failed for %s", inputNames[i]);
   332	            return false;
   333	        }
   334	    }
   335	
   336	    const std::vector<std::vector<size_t>> expectedOutputs = {
   337	        {1U, 4U},  /* rpe_logits */
   338	        {1U, 4U}   /* psi_logits */
   339	    };
   340	
   341	    const char* outputNames[] = {"rpe_logits", "psi_logits"};
   342	
   343	    for (size_t i = 0; i < expectedOutputs.size(); ++i) {
   344	        if (!VerifyOneTensor(
   345	                "Output", i, model.GetOutputTensor(i), expectedOutputs[i])) {
   346	            LOG_ERR("Output contract failed for %s", outputNames[i]);
   347	            return false;
   348	        }
   349	    }
   350	
   351	    return true;
   352	}
