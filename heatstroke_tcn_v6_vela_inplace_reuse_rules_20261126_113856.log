   393: 
   394:     time_to_set = lr_graph.current_time
   395:     for tens in sg.output_tensors:
   396:         if tens.mem_type not in target_mem_type_set or tens.mem_area != target_mem_area:
   397:             continue
   398:         rng = lr_graph.get_or_create_range(tens)
   399:         rng.mark_usage(time_to_set)
