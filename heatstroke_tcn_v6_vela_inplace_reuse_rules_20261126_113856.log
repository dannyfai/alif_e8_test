----- FUNCTION Scheduler.avoid_nhcwb16_for_ofm, lines 446-483 -----
   446:     def avoid_nhcwb16_for_ofm(self, tens, ps, arch):
   447:         """For elementwise ops when ifm is in nhwc format and not brick format aligned (16),
   448:         then if the ofm can overwrite the ifm it is better to enforce ofm format to nhwc in
   449:         order to reduce memory transactions"""
   450: 
   451:         op = ps.primary_op
   452:         if not op.type.is_elementwise_op():
   453:             return False
   454: 
   455:         depth = op.ofm_shapes[0][-1]
   456:         if (depth % 16) == 0:
   457:             return False
   458: 
   459:         # Check if overwriting the inputs can be allowed
   460:         OpShapeTens = namedtuple("OpShapeTens", ["op_shape", "tens"])
   461:         outp = OpShapeTens(op.ofm_shapes[0], op.ofm)
   462:         inps = []
   463:         if op.ifm is not None:
   464:             inps.append(OpShapeTens(op.ifm_shapes[0], op.ifm))
   465:         if op.ifm2 is not None:
   466:             inps.append(OpShapeTens(op.ifm_shapes[1], op.ifm2))
   467: 
   468:         # Find an input tensor that can be overwritten by the output
   469:         for inp in inps:
   470:             if (
   471:                 # check op input and output shapes allow overlapping
   472:                 inp.op_shape == outp.op_shape
   473:                 # check input tensor is valid
   474:                 and inp.tens is not None
   475:                 and inp.tens.shape != []
   476:                 # check input and output tensors are compatible
   477:                 and inp.tens.format == outp.tens.format
   478:                 and inp.tens.dtype == outp.tens.dtype
   479:             ):
   480:                 if inp.tens.format == TensorFormat.NHWC:
   481:                     return True
   482: 
   483:         return False

