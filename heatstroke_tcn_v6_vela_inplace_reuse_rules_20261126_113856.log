    93: def verify_allocation(live_ranges: LiveRangeGraph, alignment: int):
    94:     verify_alignment(live_ranges, alignment)
    95:     nr_time_slots = 1 + max(lr.end_time for lr in live_ranges.lrs)
    96:     # Contains active live ranges at each timestamp
    97:     lrs_at_time: List[List[LiveRange]] = [[] for i in range(nr_time_slots)]
    98:     for lr in live_ranges.lrs:
    99:         for t in range(lr.start_time, lr.end_time + 1):
   100:             lrs_at_time[t].append(lr)
   101:     for t in range(nr_time_slots):
   102:         lrs_new_items = [lr for lr in lrs_at_time[t] if t == 0 or lr not in lrs_at_time[t - 1]]
   103:         for m in lrs_new_items:
   104:             for n in lrs_at_time[t]:
   105:                 overlap, tens_n, tens_m = n.overlaps_address(m)
   106:                 if overlap and not (tens_n.equivalent(tens_m) and tens_n.address == tens_m.address):
   107:                     raise AllocationError(
   108:                         f"Overlapping buffers: {n.name}: {tens_n.address} -> {tens_n.address + n.size}"
