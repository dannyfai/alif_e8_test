   331: def extract_live_ranges_from_schedule(sg, target_mem_area, target_mem_type_set, lr_graph, verbose_progress=False):
   332:     time_for_cascade = {}
   333:     for index, sched_op in enumerate(sg.sched_ops):
   334:         progress_print(verbose_progress, "Processing SchedulerOp", index, sg.sched_ops)
   335:         op_info = sg.schedule.cost_map[sched_op]
   336:         cascade = op_info.cascade
   337:         cascade_info = sg.schedule.cascades.get(cascade, None)
   338: 
   339:         if cascade_info is None:
   340:             # Op is not part of a cascade, check if the ifm can be overwritten by the ofm
   341:             merge_elementwise_op_ranges(sg, sched_op, lr_graph, target_mem_area, target_mem_type_set)
   342: 
   343:         time_to_set = time_for_cascade.get(cascade, lr_graph.current_time)
   344: 
   345:         op_info.time_index = time_to_set
   346: 
   347:         # Mark usage for all tensors related to this Pass
   348:         ps = sched_op.parent_ps
   349:         for tens in ps.inputs + ps.outputs + ps.intermediates:
   350:             if (
   351:                 target_mem_area == MemArea.Sram
   352:                 and cascade_info
   353:                 and tens == ps.ifm_tensor
   354:                 and sched_op in cascade_info.buffers
   355:             ):
   356:                 # This tensor is a rolling buffer in a cascade and the size of the LiveRange needs to be modified
   357:                 # for enabling temporal memory snapshots without modifying the original Tensor
   358:                 rng = lr_graph.get_or_create_range(tens)
   359:                 rng.set_buffer_size(cascade_info.buffers[sched_op].elements() * sched_op.ifm.dtype.size_in_bytes())
   360:             elif (
   361:                 tens.purpose == TensorPurpose.Weights
   362:                 or tens.purpose == TensorPurpose.FSBias
   363:                 or tens.mem_type not in target_mem_type_set
   364:                 or tens.mem_area != target_mem_area
   365:             ):
   366:                 continue
   367: 
   368:             else:
   369:                 rng = lr_graph.get_or_create_range(tens)
   370: 
   371:             rng.mark_usage(time_to_set)
   372: 
   373:         for idx, weight_tens in enumerate(op_info.buffered_weight_tensors):
   374:             if weight_tens.mem_type in target_mem_type_set and weight_tens.mem_area == target_mem_area:
   375:                 rng = lr_graph.get_or_create_range(weight_tens)
   376:                 start_time = time_to_set
   377:                 length = 1
   378:                 if weight_tens.pre_buffer:
   379:                     start_time -= 1
   380:                     length += 1
   381:                 if len(op_info.buffered_weight_tensors) > 1:
   382:                     last_idx = len(op_info.ofm_depth_slices) % len(op_info.buffered_weight_tensors)
   383:                     # Double buffering: reduce end time of the buffer that is not used last
   384:                     if last_idx != idx:
   385:                         length -= 1
   386:                 rng.mark_usage(start_time, length)
   387: 
   388:         if time_to_set == lr_graph.current_time:
   389:             lr_graph.current_time += 2
   390: 
   391:         if cascade != 0:
