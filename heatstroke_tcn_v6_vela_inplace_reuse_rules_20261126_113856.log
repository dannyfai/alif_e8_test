----- FUNCTION linear_allocate_live_ranges, lines 39-67 -----
    39: def linear_allocate_live_ranges(live_ranges, alloc_granularity=Tensor.AllocationQuantum):
    40:     # Allocates using increasing addresses. Duplicate constant tensors will be allocated to the same address
    41:     total_sz = 0
    42:     allocated_tensors = []
    43: 
    44:     # just assign increasing addresses, except for duplicates
    45:     for tens, lr in live_ranges.ranges.items():
    46:         if tens in allocated_tensors:
    47:             continue
    48: 
    49:         address = total_sz
    50:         if tens.weight_compression_config is not None:
    51:             for allocated_tens in allocated_tensors:
    52:                 if allocated_tens.weight_compression_config == tens.weight_compression_config:
    53:                     assert allocated_tens.scale_compression_config == tens.scale_compression_config
    54:                     address = allocated_tens.address
    55:                     break
    56:         if tens.purpose == TensorPurpose.LUT:
    57:             for allocated_tens in allocated_tensors:
    58:                 if allocated_tens.equivalent(tens):
    59:                     address = allocated_tens.address
    60:                     break
    61:         lr.set_address(address)
    62:         allocated_tensors += lr.tensors
    63:         if address == total_sz:
    64:             total_sz += numeric_util.round_up(int(math.ceil(lr.size)), alloc_granularity)
    65: 
    66:     verify_alignment(live_ranges, alloc_granularity)
    67:     return total_sz

----- FUNCTION hillclimb_allocate_live_ranges, lines 70-81 -----
    70: def hillclimb_allocate_live_ranges(
    71:     live_ranges: LiveRangeGraph, alloc_granularity: int, max_iterations: int, mem_limit: int
    72: ) -> int:
    73:     # Allocates using the hill climb allocator
    74:     addresses = hillclimb_allocation.allocate_live_ranges(live_ranges.lrs, max_iterations, mem_limit)
    75:     # The result is a list containing the allocated addresses
    76:     total_sz = 0
    77:     for lr, address in zip(live_ranges.lrs, addresses):
    78:         total_sz = max(total_sz, address + lr.size)
    79:         lr.set_address(address)
    80:     verify_allocation(live_ranges, alloc_granularity)
    81:     return total_sz

