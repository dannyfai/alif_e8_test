    10	
    11	config USE_APP_MENU
    12		bool "Use application menu to choose a test case"
    13		default false
    14	
    15	config ACTIVATION_BUF_SECTION
    16		string "Linker section where activation buffer (tensor arena) is placed"
    17		default ".bss.activation_buf"
    18	
    19	config ACTIVATION_BUF_SZ
    20		hex "Tensor arena size"
    21		default 0x00091000
    22	
    23	config MODEL_IN_EXT_FLASH
    24		bool "Put ML model to external flash"
    25		select FLASH
    26		select ALIF_OSPI_FLASH_XIP
    27		help
    28			Initialize OSPI controller to XIP mode. Initialize the onboard flash device. Link ML model data to external flash address space.
    29			In addition to normal zephyr.bin output, ospi0/1.bin is generated. When enabled, the model memory section is set automatically (See BufAttributes.h)
    30	
    31	config MODEL_SECTION
    32		string "Linker section where ML model is placed"
    33		depends on !MODEL_IN_EXT_FLASH
    34		default ".rodata.tflm_model"
    35	
    36	config ETHOS_U_AXI0_ONLY
    37		bool "Only use AXI0 port on the Ethos"
    38		default false
    39	
    40	config AUDIO_SAMPLES
    41		int "Number of audio samples to store"
    42		default 16000
    43	
    44	config AUDIO_STRIDE
    45		int "Number of audio samples in a single stride"
    46		default 8000
    47	
    48	config RESULTS_MEMORY
    49		int "Number of inference results to keep in memory"
    50		default 8
    51	
    52	config AUDIO_CHANNELS
    53		int "Number of input audio channels"
    54		default 2
    55	

