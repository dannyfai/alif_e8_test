    53	/*
    54	 * Application-local Ethos-U runtime diagnostic.
    55	 * Reads NPU STATUS and NVIC IRQ 55 only; does not alter either.
    56	 */
    57	namespace {
    58	
    59	constexpr std::uintptr_t kHeatstrokeEthosuStatusAddress = 0x400E1004UL;
    60	constexpr IRQn_Type kHeatstrokeEthosuIrq =
    61	    static_cast<IRQn_Type>(55);
    62	
    63	struct k_work g_heatstrokeEthosuMonitorWork;
    64	struct k_timer g_heatstrokeEthosuMonitorTimer;
    65	
    66	void HeatstrokeEthosuMonitorWorkHandler(struct k_work* work)
    67	{
    68	    (void)work;
    69	
    70	    const auto* statusRegister =
    71	        reinterpret_cast<volatile const std::uint32_t*>(
    72	            kHeatstrokeEthosuStatusAddress);
    73	    const std::uint32_t status = *statusRegister;
    74	
    75	    const unsigned int enabled = static_cast<unsigned int>(
    76	        NVIC_GetEnableIRQ(kHeatstrokeEthosuIrq));
    77	    const unsigned int pending = static_cast<unsigned int>(
    78	        NVIC_GetPendingIRQ(kHeatstrokeEthosuIrq));
    79	    const unsigned int active = static_cast<unsigned int>(
    80	        NVIC_GetActive(kHeatstrokeEthosuIrq));
    81	
    82	    LOG_INF(
    83	        "ETHOSU_DIAG: status=0x%08x run=%u irq=%u bus=%u reset=%u "
    84	        "parse=%u end=%u pmu=%u wd=%u ecc=%u "
    85	        "IRQ55[en=%u pend=%u active=%u]",
    86	        static_cast<unsigned int>(status),
    87	        static_cast<unsigned int>((status >> 0U) & 1U),
    88	        static_cast<unsigned int>((status >> 1U) & 1U),
    89	        static_cast<unsigned int>((status >> 2U) & 1U),
    90	        static_cast<unsigned int>((status >> 3U) & 1U),
    91	        static_cast<unsigned int>((status >> 4U) & 1U),
    92	        static_cast<unsigned int>((status >> 5U) & 1U),
    93	        static_cast<unsigned int>((status >> 6U) & 1U),
    94	        static_cast<unsigned int>((status >> 7U) & 1U),
    95	        static_cast<unsigned int>((status >> 8U) & 1U),
    96	        enabled, pending, active);
    97	}
    98	
    99	void HeatstrokeEthosuMonitorTimerHandler(struct k_timer* timer)
   100	{
   101	    (void)timer;
   102	    (void)k_work_submit(&g_heatstrokeEthosuMonitorWork);
   103	}
   104	
   105	void StartHeatstrokeEthosuMonitor()
   106	{
   107	    k_work_init(
   108	        &g_heatstrokeEthosuMonitorWork,
   109	        HeatstrokeEthosuMonitorWorkHandler);
   110	
   111	    k_timer_init(
   112	        &g_heatstrokeEthosuMonitorTimer,
   113	        HeatstrokeEthosuMonitorTimerHandler,
   114	        nullptr);
   115	
   116	    const int initialSubmit =
   117	        k_work_submit(&g_heatstrokeEthosuMonitorWork);
   118	
   119	    if (initialSubmit < 0) {
   120	        LOG_WRN("ETHOSU_DIAG: initial snapshot submission failed: %d",
   121	                initialSubmit);
   122	    }
   123	
   124	    k_timer_start(
   125	        &g_heatstrokeEthosuMonitorTimer,
   126	        K_SECONDS(1),
   127	        K_SECONDS(1));
   128	
   129	    LOG_INF("ETHOSU_DIAG: runtime monitor started; interval=1000ms");
   130	}
   131	
   132	void StopHeatstrokeEthosuMonitor()
   133	{
   134	    k_timer_stop(&g_heatstrokeEthosuMonitorTimer);
   135	    LOG_INF("ETHOSU_DIAG: runtime monitor stopped");
   136	}
