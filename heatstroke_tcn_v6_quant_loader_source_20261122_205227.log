   106	def summarize_initializers(model):
   107	    counts = Counter()
   108	    total_bytes = Counter()
   109	    int8_names = []
   110	    for initializer in model.graph.initializer:
   111	        array = numpy_helper.to_array(initializer)
   112	        dtype = str(array.dtype)
   113	        counts[dtype] += 1
   114	        total_bytes[dtype] += int(array.nbytes)
   115	        if array.dtype == np.int8:
   116	            int8_names.append(initializer.name)
   117	    return {'initializer_count_by_dtype': dict(counts), 'initializer_bytes_by_dtype': dict(total_bytes), 'int8_initializer_count': len(int8_names), 'int8_initializer_bytes': int(total_bytes.get('int8', 0)), 'int8_initializer_examples': int8_names[:20]}
