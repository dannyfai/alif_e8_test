   486	@torch.no_grad()
   487	def evaluate_end_to_end(project_run, tcn_reg, ref_reg, cla_model,
   488	                        val_loader, device) -> Dict[str, object]:
   489	    """Compare fixed original classifier fed by original-vs-TCN imputation."""
   490	    tcn_reg.eval(); ref_reg.eval(); cla_model.eval()
   491	    y_true_rpe, y_true_psi = [], []
   492	    y_ref_rpe, y_ref_psi = [], []
   493	    y_tcn_rpe, y_tcn_psi = [], []
   494	    for corrupted, _target, _artificial, marks, worker, labels in val_loader:
   495	        x = corrupted.to(device)
   496	        marks = marks.to(device)
   497	        worker = worker.to(device)
   498	        labels = labels.numpy()
   499	        missing = (x == -9997) | (x == -9998) | (x == -9999)
   500	        ref_pred = ref_reg(x, x_mark_enc=marks, one_hot_x=worker[:, :18], device=device)
   501	        tcn_pred = tcn_reg(x, x_mark_enc=marks, one_hot_x=worker[:, :18], device=device)
   502	        ref_restored = torch.where(missing, ref_pred, x)
   503	        tcn_restored = torch.where(missing, tcn_pred, x)
   504	        ref_rpe, ref_psi = cla_model(ref_restored, x_mark_enc=marks, one_hot_x=worker[:, :30], device=device)
   505	        tcn_rpe, tcn_psi = cla_model(tcn_restored, x_mark_enc=marks, one_hot_x=worker[:, :30], device=device)
   506	        y_true_rpe.extend(labels[:, 0].tolist())
   507	        y_true_psi.extend(labels[:, 1].tolist())
   508	        y_ref_rpe.extend(ref_rpe.argmax(dim=1).cpu().tolist())
   509	        y_ref_psi.extend(ref_psi.argmax(dim=1).cpu().tolist())
   510	        y_tcn_rpe.extend(tcn_rpe.argmax(dim=1).cpu().tolist())
   511	        y_tcn_psi.extend(tcn_psi.argmax(dim=1).cpu().tolist())
