   119	def summarize_qdq(model):
   120	    ops = Counter((node.op_type for node in model.graph.node))
   121	    initializers = {item.name: numpy_helper.to_array(item) for item in model.graph.initializer}
   122	    scale_sizes = []
   123	    scale_min = []
   124	    scale_max = []
   125	    direct_input_quantizers = {name: [] for name in INPUT_NAMES}
   126	    for node in model.graph.node:
   127	        if node.op_type not in ('QuantizeLinear', 'DequantizeLinear'):
   128	            continue
   129	        if len(node.input) >= 2:
   130	            scale = initializers.get(node.input[1])
   131	            if scale is not None:
   132	                scale = np.asarray(scale, dtype=np.float64)
   133	                if scale.size:
   134	                    scale_sizes.append(int(scale.size))
   135	                    scale_min.append(float(np.min(scale)))
   136	                    scale_max.append(float(np.max(scale)))
   137	        if node.op_type == 'QuantizeLinear' and node.input:
   138	            for name in INPUT_NAMES:
   139	                if node.input[0] == name:
   140	                    direct_input_quantizers[name].append({'node_name': node.name, 'output': list(node.output), 'scale_initializer': node.input[1] if len(node.input) > 1 else None, 'zero_point_initializer': node.input[2] if len(node.input) > 2 else None})
   141	    return {'operator_counts': dict(sorted(ops.items())), 'quantize_linear_nodes': int(ops.get('QuantizeLinear', 0)), 'dequantize_linear_nodes': int(ops.get('DequantizeLinear', 0)), 'qdq_scale_tensor_count': len(scale_sizes), 'qdq_scale_value_count': int(sum(scale_sizes)), 'qdq_scale_min': min(scale_min) if scale_min else None, 'qdq_scale_max': max(scale_max) if scale_max else None, 'direct_graph_input_quantizers': direct_input_quantizers}
