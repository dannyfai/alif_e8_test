    49	class DatasetCalibrationReader(CalibrationDataReader):
    50	    """Feeds deterministic five-input samples to ONNX Runtime calibration."""
    51	
    52	    def __init__(self, samples):
    53	        super().__init__()
    54	        self.samples = samples
    55	        self.index = 0
    56	
    57	    def get_next(self):
    58	        if self.index >= len(self.samples):
    59	            return None
    60	        sample = self.samples[self.index]
    61	        self.index += 1
    62	        return sample
    63	
    64	    def rewind(self):
    65	        self.index = 0
