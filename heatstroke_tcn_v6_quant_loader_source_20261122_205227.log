    32	def import_module(path, name):
    33	    spec = importlib.util.spec_from_file_location(name, str(path))
    34	    if spec is None or spec.loader is None:
    35	        raise RuntimeError(f'Cannot import module: {path}')
    36	    module = importlib.util.module_from_spec(spec)
    37	    spec.loader.exec_module(module)
    38	    return module
