   270	def make_group_split(group_ids: List[str], val_fraction: float, seed: int):
   271	    """Split unique worker IDs, never individual samples, into train/validation."""
   272	    unique_groups = sorted(set(group_ids))
   273	    if len(unique_groups) < 2:
   274	        raise RuntimeError(
   275	            f"Need at least two distinct subject groups for a grouped split; "
   276	            f"found {len(unique_groups)}. Cannot make a leakage-resistant split."
   277	        )
   278	    if not (0.05 <= val_fraction <= 0.5):
   279	        raise ValueError("--val-fraction must be between 0.05 and 0.50")
   280	    rng = random.Random(seed)
   281	    shuffled = unique_groups.copy()
   282	    rng.shuffle(shuffled)
   283	    n_val = max(1, int(round(len(shuffled) * val_fraction)))
   284	    n_val = min(n_val, len(shuffled) - 1)
   285	    val_groups = set(shuffled[:n_val])
   286	    train_indices = [i for i, g in enumerate(group_ids) if g not in val_groups]
   287	    val_indices = [i for i, g in enumerate(group_ids) if g in val_groups]
   288	    if not train_indices or not val_indices:
   289	        raise RuntimeError("Grouped split produced an empty training or validation partition")
   290	    return train_indices, val_indices, sorted(set(group_ids[i] for i in train_indices)), sorted(val_groups)
