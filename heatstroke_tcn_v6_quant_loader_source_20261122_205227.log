   293	class ImputationDataset(Dataset):
   294	    """Build the same 900-second windows as run.py and inject known-value masks.
   295	
   296	    Training targets are only artificially hidden values that were observed in
   297	    the original data. Naturally missing values (-9999) are never used as labels.
   298	    """
   299	    def __init__(self, project_run, split_dir: Path, flag: str, seed: int,
   300	                 requested_group_column: str = "auto"):
   301	        self.run = project_run
   302	        self.split_dir = split_dir
   303	        self.flag = flag
   304	        self.seed = seed
   305	        self.epoch = 0
   306	        seq_path = split_dir / f"{flag}_seq.feather"
   307	        nonseq_path = split_dir / f"{flag}_non_seq.csv"
   308	        if not seq_path.is_file() or not nonseq_path.is_file():
   309	            raise FileNotFoundError(
   310	                f"Missing {flag} split files: expected {seq_path.name} and {nonseq_path.name} in {split_dir}"
   311	            )
   312	        self.df_seq = pd.read_feather(seq_path)
   313	        self.df_non = pd.read_csv(nonseq_path)
   314	        self.df_seq["time"] = pd.to_datetime(self.df_seq["time"])
   315	        self.df_non["time"] = pd.to_datetime(self.df_non["time"])
   316	        self.group_column = resolve_group_column(self.df_non.columns, requested_group_column)
   317	        print(f"Subject-level split column: {self.group_column}")
   318	        for col in SEQ_COLS:
   319	            if col not in self.df_seq:
   320	                raise KeyError(f"Missing sequence column {col} in {seq_path}")
   321	        for col in NON_SEQ_COLS + ["sample_index", "time", "missing_col", "rpe", "psi", self.group_column]:
   322	            if col not in self.df_non:
   323	                raise KeyError(f"Missing metadata column {col} in {nonseq_path}")
   324	
   325	        self.seq_groups = {
   326	            key: group.sort_values("time").reset_index(drop=True)
   327	            for key, group in self.df_seq.groupby("sample_index", sort=False)
   328	        }
   329	        self.meta_groups = {
   330	            key: group.sort_values("time").reset_index(drop=True)
   331	            for key, group in self.df_non.groupby("sample_index", sort=False)
   332	        }
   333	        self.samples: List[Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]] = []
   334	        self.sample_ids: List[str] = []
   335	        self.group_ids: List[str] = []
   336	        skipped = 0
   337	        for sample_id, meta in self.meta_groups.items():
   338	            if sample_id not in self.seq_groups or len(meta) == 0:
   339	                skipped += 1
   340	                continue
   341	            target_time = pd.to_datetime(meta["time"].iloc[0])
   342	            start_time = target_time - pd.Timedelta(seconds=SEQ_LEN)
   343	            end_time = target_time - pd.Timedelta(seconds=1)
   344	            seq = self.seq_groups[sample_id]
   345	            window = seq[(seq["time"] >= start_time) & (seq["time"] <= end_time)].copy()
   346	            window = window.sort_values("time").reset_index(drop=True)
   347	            if len(window) != SEQ_LEN:
   348	                skipped += 1
   349	                continue
   350	
   351	            missing_cols = meta["missing_col"].iloc[0]
   352	            if pd.notna(missing_cols) and str(missing_cols).strip():
   353	                for col in str(missing_cols).split(";"):
   354	                    if col in window.columns:
   355	                        window.loc[:, col] = np.nan
   356	
   357	            clean = window[SEQ_COLS].to_numpy(dtype=np.float32, copy=True)
   358	            marks = project_run.time_features(pd.to_datetime(window["time"].values)).T.astype(np.float32)
   359	            worker = self._worker_vector(meta.iloc[-1], project_run)
   360	            labels = self._labels(meta.iloc[-1], project_run)
   361	            group_values = meta[self.group_column].dropna().astype(str).str.strip().unique()
   362	            if len(group_values) != 1 or not group_values[0]:
   363	                raise ValueError(
   364	                    f"sample_index={sample_id!r} has invalid/inconsistent subject IDs "
   365	                    f"in {self.group_column!r}: {group_values.tolist()}"
   366	                )
   367	            self.samples.append((clean, marks, worker, labels))
   368	            self.sample_ids.append(str(sample_id))
   369	            self.group_ids.append(str(group_values[0]))
   370	
   371	        print(f"[{flag}] loaded samples={len(self.samples)}, skipped_incomplete={skipped}")
   372	        print(f"[{flag}] distinct subject groups={len(set(self.group_ids))}")
   373	        if not self.samples:
   374	            raise RuntimeError(
   375	                f"No complete {flag} samples with exactly {SEQ_LEN} sequence rows. "
   376	                "Check sample_index/time alignment in the available split_byid test files."
   377	            )
   378	
   379	    @staticmethod
   380	    def _worker_vector(row: pd.Series, project_run) -> np.ndarray:
   381	        values: List[float] = []
   382	        for col in NON_SEQ_COLS:
   383	            value = row[col]
   384	            if col in ONE_HOT_COLS:
   385	                key = "prev_rpe_rpt" if col.startswith("prev_rpe_") else col
   386	                if pd.isna(value):
   387	                    raise ValueError(f"NaN one-hot worker feature {col}")
   388	                map_key = float(value)
   389	                try:
   390	                    values.extend(project_run.ONE_HOT_MAP[key][map_key])
   391	                except KeyError as exc:
   392	                    raise ValueError(f"Unexpected {col}={value!r} for one-hot map {key}") from exc
   393	            else:
   394	                values.append(float(value))
   395	        arr = np.asarray(values, dtype=np.float32)
   396	        if arr.shape != (30,) or not np.isfinite(arr).all():
   397	            raise ValueError(f"Invalid worker feature vector: shape={arr.shape}")
   398	        return arr
   399	
   400	    @staticmethod
   401	    def _labels(row: pd.Series, project_run) -> np.ndarray:
   402	        rpe = row["rpe"]
   403	        psi = row["psi"]
   404	        rpe = -1 if pd.isna(rpe) else project_run.RPE_MAP.get(int(rpe), -1)
   405	        psi = -1 if pd.isna(psi) else project_run.PSI_MAP.get(int(psi), -1)
   406	        return np.asarray([rpe, psi], dtype=np.int64)
   407	
   408	    def set_epoch(self, epoch: int) -> None:
   409	        self.epoch = int(epoch)
   410	
   411	    def __len__(self) -> int:
   412	        return len(self.samples)
   413	
   414	    def _corrupt(self, clean: np.ndarray, index: int) -> Tuple[np.ndarray, np.ndarray]:
   415	        rng = np.random.default_rng(self.seed + self.epoch * 100003 + index * 97)
   416	        corrupted = clean.copy()
   417	        original_missing = ~np.isfinite(clean)
   418	        artificial = np.zeros_like(original_missing, dtype=bool)
   419	        # Match run.py: 10% chance of last-300s block masking; otherwise each
   420	        # channel gets 30% random masking or one 270s contiguous patch.
   421	        if rng.random() < 0.1:
   422	            mask = np.zeros(SEQ_LEN, dtype=bool)
   423	            mask[SEQ_LEN - 300:] = True
   424	            for c in range(clean.shape[1]):
   425	                if np.isnan(clean[:, c]).mean() == 0.0:
   426	                    artificial[:, c] = mask & ~original_missing[:, c]
   427	                    corrupted[artificial[:, c], c] = -9998.0
   428	        else:
   429	            for c in range(clean.shape[1]):
   430	                if rng.random() < 0.5:
   431	                    m = rng.choice(np.asarray([True, False]), size=SEQ_LEN, p=[0.3, 0.7])
   432	                    code = -9998.0
   433	                else:
   434	                    m = np.zeros(SEQ_LEN, dtype=bool)
   435	                    start = int(rng.integers(10, SEQ_LEN - 270))
   436	                    m[start:start + 270] = True
   437	                    code = -9997.0
   438	                artificial[:, c] = m & ~original_missing[:, c]
   439	                corrupted[artificial[:, c], c] = code
   440	        corrupted[original_missing] = -9999.0
   441	        # Any unmasked naturally missing values use the original sentinel.
   442	        corrupted[~np.isfinite(corrupted)] = -9999.0
   443	        target = np.nan_to_num(clean, nan=0.0, posinf=0.0, neginf=0.0)
   444	        return corrupted.astype(np.float32), artificial.astype(bool), target.astype(np.float32)
   445	
   446	    def __getitem__(self, index: int):
   447	        clean, marks, worker, labels = self.samples[index]
   448	        corrupted, artificial, target = self._corrupt(clean, index)
   449	        return (
   450	            torch.from_numpy(corrupted),
   451	            torch.from_numpy(target),
   452	            torch.from_numpy(artificial),
   453	            torch.from_numpy(marks),
   454	            torch.from_numpy(worker),
   455	            torch.from_numpy(labels),
   456	        )
   457	
   458	
   459	def masked_reconstruction_loss(pred: torch.Tensor, target: torch.Tensor,
   460	                               mask: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
   461	    # The output is consumed in physical units. Normalize only the loss so the
   462	    # accelerometer channels do not dominate the CBT/WBGT channels.
   463	    normalized_error = (pred - target) / scale.view(1, 1, -1)
   464	    per_element = F.smooth_l1_loss(normalized_error, torch.zeros_like(normalized_error), reduction="none")
   465	    mask_f = mask.to(per_element.dtype)
   466	    denom = mask_f.sum().clamp_min(1.0)
   467	    return (per_element * mask_f).sum() / denom
   468	
   469	
   470	@torch.no_grad()
   471	def evaluate_reconstruction(model, loader, device, scale) -> float:
   472	    model.eval()
   473	    losses = []
   474	    for corrupted, target, artificial, marks, worker, _labels in loader:
   475	        corrupted = corrupted.to(device)
   476	        target = target.to(device)
   477	        artificial = artificial.to(device)
   478	        marks = marks.to(device)
   479	        worker = worker.to(device)
   480	        pred = model(corrupted, x_mark_enc=marks, one_hot_x=worker[:, :18], device=device)
   481	        loss = masked_reconstruction_loss(pred, target, artificial, scale)
   482	        losses.append(float(loss.item()))
   483	    return float(np.mean(losses))
   484	
