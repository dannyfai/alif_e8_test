    25	def sha256(path):
    26	    h = hashlib.sha256()
    27	    with path.open('rb') as f:
    28	        for chunk in iter(lambda: f.read(1024 * 1024), b''):
    29	            h.update(chunk)
    30	    return h.hexdigest()
