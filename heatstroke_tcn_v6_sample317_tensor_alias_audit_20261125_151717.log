  419: bool GreedyMemoryPlanner::DoAnyBuffersOverlap() {
  420:   CalculateOffsetsIfNeeded();
  421:   bool were_overlaps_found = false;
  422:   for (int i = 0; i < buffer_count_; ++i) {
  423:     BufferRequirements* a_requirements = &requirements_[i];
  424:     const int a_start_offset = buffer_offsets_[i];
  425:     const int a_first_time_used = a_requirements->first_time_used;
  426:     const int a_last_time_used = a_requirements->last_time_used;
  427:     const int a_end_offset = a_start_offset + a_requirements->size;
  428:     for (int j = 0; j < buffer_count_; ++j) {
  429:       if (i == j) {
  430:         continue;
  431:       }
  432:       BufferRequirements* b_requirements = &requirements_[j];
  433:       const int b_start_offset = buffer_offsets_[j];
  434:       const int b_first_time_used = b_requirements->first_time_used;
  435:       const int b_last_time_used = b_requirements->last_time_used;
  436:       const int b_end_offset = b_start_offset + b_requirements->size;
  437:       if ((a_first_time_used > b_last_time_used) ||
  438:           (b_first_time_used > a_last_time_used)) {
  439:         // Buffers don't overlap in time.
  440:         continue;
  441:       }
  442:       if ((a_start_offset >= b_end_offset) ||
  443:           (b_start_offset >= a_end_offset)) {
  444:         // No overlap in memory.
  445:         continue;
  446:       }
  447:       were_overlaps_found = true;
  448:       MicroPrintf("Overlap: %d (%d=>%d, %d->%d) vs %d (%d=>%d, %d->%d)", i,
  449:                   a_first_time_used, a_last_time_used, a_start_offset,
  450:                   a_end_offset, j, b_first_time_used, b_last_time_used,
  451:                   b_start_offset, b_end_offset);
  452:     }
  453:   }
  454:   return were_overlaps_found;
  455: }
