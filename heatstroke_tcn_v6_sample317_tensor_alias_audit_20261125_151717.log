   161	  const uint32_t tcn_v6_call_index = ++tcn_v6_npu_invocation_index;
   162	  const int64_t tcn_v6_reserve_start_ms = k_uptime_get();
   163	  struct ethosu_driver *drv = ethosu_reserve_driver();
   164	  const uint32_t tcn_v6_reserve_ms = (uint32_t)(k_uptime_get() - tcn_v6_reserve_start_ms);
   165	  const uint32_t tcn_v6_irq_before = tcn_v6_ethosu_irq_count_get();
   166	  const int64_t tcn_v6_invoke_start_ms = k_uptime_get();
   167	  result = ethosu_invoke_v3(
   168	      drv, cms_data, data->cms_data_size, base_addrs,
   169	      base_addrs_size, num_tensors,
   170	      GetMicroContext(context)->external_context());
   171	  const uint32_t tcn_v6_invoke_ms = (uint32_t)(k_uptime_get() - tcn_v6_invoke_start_ms);
   172	  const uint32_t tcn_v6_irq_after = tcn_v6_ethosu_irq_count_get();
   173	  const uint32_t tcn_v6_irq_delta = tcn_v6_irq_after - tcn_v6_irq_before;
   174	  const int64_t tcn_v6_release_start_ms = k_uptime_get();
   175	  ethosu_release_driver(drv);
   176	  const uint32_t tcn_v6_release_ms = (uint32_t)(k_uptime_get() - tcn_v6_release_start_ms);
   177	  tcn_v6_npu_cumulative_invoke_ms += tcn_v6_invoke_ms;
   178	  tcn_v6_npu_cumulative_irq_delta += tcn_v6_irq_delta;
   179	  printk("TCN_V6_NPU_PROFILE: idx=%u status=%d drv_valid=%u "
   180	         "cmd_tensor_bytes=%d base_regions=%d reserve_ms=%u "
   181	         "invoke_ms=%u release_ms=%u irq_before=%u "
   182	         "irq_after=%u irq_delta=%u cumulative_invoke_ms=%u "
   183	         "cumulative_irq_delta=%u\n",
   184	         tcn_v6_call_index, result, (drv != nullptr) ? 1u : 0u,
