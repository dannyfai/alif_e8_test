   186	         tcn_v6_invoke_ms, tcn_v6_release_ms,
   187	         tcn_v6_irq_before, tcn_v6_irq_after,
   188	         tcn_v6_irq_delta, tcn_v6_npu_cumulative_invoke_ms,
   189	         tcn_v6_npu_cumulative_irq_delta);
