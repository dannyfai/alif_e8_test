   100	  // Get command stream data address.
   101	  tensor = context->GetEvalTensor(context, node->inputs->data[0]);
   102	  cms_data = reinterpret_cast<void*>(tensor->data.uint8);
   103	
   104	  // Get addresses to weights/scratch/input data.
   105	  for (i = 1; i < node->inputs->size; ++i) {
   106	    tensor = context->GetEvalTensor(context, node->inputs->data[i]);
   107	    base_addrs[num_tensors] =
   108	        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(tensor->data.uint8));
   109	    size_t byte_size = 1;
   110	    for (int k = 0; k < tensor->dims->size; k++) {
   111	      byte_size = byte_size * tensor->dims->data[k];
   112	    }
