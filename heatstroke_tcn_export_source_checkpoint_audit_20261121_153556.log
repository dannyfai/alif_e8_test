def import_project(project: Path):
    if str(project) not in sys.path:
        sys.path.insert(0, str(project))
    # torchsummary is used only by run.py's standalone reporting path. It is
    # not needed for this experiment, so tolerate its absence without editing
    # the original project source.
    try:
        import torchsummary  # noqa: F401
    except ModuleNotFoundError as exc:
        if exc.name != "torchsummary":
            raise
        stub = types.ModuleType("torchsummary")
        stub.summary = lambda *args, **kwargs: None
        sys.modules["torchsummary"] = stub
    import run as project_run  # noqa: E402
    return project_run

