def evaluate_reconstruction(model, loader, device, scale) -> float:
    model.eval()
    losses = []
    for corrupted, target, artificial, marks, worker, _labels in loader:
        corrupted = corrupted.to(device)
        target = target.to(device)
        artificial = artificial.to(device)
        marks = marks.to(device)
        worker = worker.to(device)
        pred = model(corrupted, x_mark_enc=marks, one_hot_x=worker[:, :18], device=device)
        loss = masked_reconstruction_loss(pred, target, artificial, scale)
        losses.append(float(loss.item()))
    return float(np.mean(losses))

