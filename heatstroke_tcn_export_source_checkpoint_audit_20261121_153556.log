def __init__(self):
        super(Reg_Model, self).__init__()
        self.seq_len = 900
        # self.target_length = configs.seq_len
        self.non_seq_len = 18
        self.seq_feature_num = 6
        self.time_feature_num = 3
        self.hidden_dim1 = 256
        self.e_layers = 1
        self.dropout = 0.1
        self.batch_first = True
        self.rnn_type = 'BiLSTM'
        bidirectional = True if 'Bi' in self.rnn_type else False
        if self.non_seq_len > 0:
            self.non_seq_enc = torch.nn.Linear(self.non_seq_len, self.seq_len)

        # single variate feature
        self.compact_seq_len = self.seq_len * 2
        svf = []
        for i in range(self.seq_feature_num):
            svf.append(nn.Linear(self.compact_seq_len, self.seq_len, bias=True))
        self.svf = nn.ModuleList(svf)

        # cross-variate features
        self.cvf = nn.Sequential(
            nn.Conv1d(self.seq_feature_num, 16, kernel_size=3, stride=1, padding=1, padding_mode='reflect', bias=True),
            nn.Conv1d(16, 32, kernel_size=5, stride=1, padding=2, padding_mode='reflect', bias=True),
            nn.LayerNorm(self.seq_len),
            nn.GELU(),
            nn.Conv1d(32, 64, kernel_size=7, stride=1, padding=3, padding_mode='reflect', bias=True),
            nn.Conv1d(64, 128, kernel_size=9, stride=1, padding=4, padding_mode='reflect', bias=True),
            nn.LayerNorm(self.seq_len),
            nn.GELU(),
            nn.Conv1d(128, self.seq_feature_num, kernel_size=11, stride=1, padding=5, padding_mode='reflect', bias=True),
        )

        # rnn encoder
        rnn_input_size = self.seq_feature_num * 2 + self.time_feature_num + (1 if self.non_seq_len > 0 else 0)
        if 'GRU' in self.rnn_type:
            RNN = nn.GRU
        else:
            RNN = nn.LSTM
        self.rnn = RNN(rnn_input_size, int(self.hidden_dim1 / 2), self.e_layers, batch_first=self.batch_first, bidirectional=bidirectional, bias=True)

        # projector
        dim_in = self.hidden_dim1 if bidirectional else int(self.hidden_dim1 / 2)
        proj = []
        for i in range(self.seq_feature_num):
            proj.append(
                nn.Sequential(
                    nn.Linear(dim_in, int(self.hidden_dim1 / 2)),
                    nn.LayerNorm(int(self.hidden_dim1 / 2)),
                    nn.GELU(),
                    nn.Dropout(self.dropout),
                    nn.Linear(int(self.hidden_dim1 / 2), 1)
                )
            )
        self.proj = nn.ModuleList(proj)
def forward(self, x, x_mark_enc=None, one_hot_x=None, device='cpu'):
        B, L, N = x.shape
        missing_mask = (x == -9997) | (x == -9998) | (x == -9999)
        if self.non_seq_len > 0:
            non_seq_enc_out = self.non_seq_enc(one_hot_x)
        else:
            non_seq_enc_out = None
        if x_mark_enc is not None and non_seq_enc_out is not None:
            x_mark_enc = torch.cat((x_mark_enc, non_seq_enc_out.view(B, -1, 1)), dim=2)

        # single variate feature
        a = []
        svf_out = []
        for b in range(B):
            aa = []
            for n in range(N):
                bnx = x[b: b + 1, :, n: n + 1]
                non_missing_mask = (bnx != -9997) & (bnx != -9998) & (bnx != -9999)
                bnx = bnx[non_missing_mask]
                if len(bnx) > 0:
                    aa.append(nn.functional.adaptive_avg_pool1d(bnx.reshape(1, 1, -1), self.compact_seq_len).reshape(
                        self.compact_seq_len))
                else:
                    aa.append(torch.zeros((self.compact_seq_len,)).to(device))
            a.append(torch.stack(aa, dim=1))
        a = torch.stack(a, dim=0)
        for i, l in enumerate(self.svf):
            svf_out.append(l(a[:, :, i]))
        svf_enc = torch.stack(svf_out, dim=2)
        svf_enc[~missing_mask] = 0.0

        # cross-variate features
        b = x.clone()
        b[missing_mask] = np.nan
        means = torch.tile(torch.nanmean(b, dim=1).unsqueeze(1), (1, self.seq_len, 1))
        b[missing_mask] = means[missing_mask]
        b = torch.nan_to_num(b, nan=0.0)
        cvf_enc = self.cvf(b.permute(0, 2, 1)).permute(0, 2, 1)
        cvf_enc[~missing_mask] = 0.0

        # rnn features
        c = x.clone()
        c[missing_mask] = 0.0
        emb = torch.cat(((svf_enc + cvf_enc) / 2, c), dim=2)
        if x_mark_enc is not None:
            emb = torch.cat((emb, x_mark_enc), dim=2)
        enc, _ = self.rnn(emb)

        # projector
        out = []
        for i, l in enumerate(self.proj):
            out.append(l(enc).reshape(B, L))
        out = torch.stack(out, dim=2)

        return out

