def __init__(self):
        super(Cla_Model, self).__init__()
        self.seq_len = 900
        self.non_seq_len = 30
        self.seq_feature_num = 6
        self.time_feature_num = 3
        self.hidden_dim1 = 128
        self.e_layers = 1
        self.dropout = 0.1
        self.target = ['rpe', 'psi']
        self.batch_first = True
        self.rnn_type = 'BiLSTM'
        bidirectional = True if 'Bi' in self.rnn_type else False

        # v1
        self.conv_feats = nn.Sequential(
            nn.Conv1d(self.seq_feature_num, 16, kernel_size=3, stride=3, padding=0, dilation=2),

            nn.Conv1d(16, 32, kernel_size=3, stride=3, padding=0, dilation=2),

            nn.Conv1d(32, 64, kernel_size=3, stride=3, padding=0, dilation=2),

            nn.AdaptiveAvgPool1d(32),
        )
        self.ffn1 = nn.Sequential(
            nn.Linear(32 * 64, self.hidden_dim1),
            nn.LayerNorm(self.hidden_dim1),
            nn.GELU()
        )

        if 'GRU' in self.rnn_type:
            rnn = nn.GRU
        else:
            rnn = nn.LSTM
        self.rnn = rnn(self.seq_feature_num, int(self.hidden_dim1 / 2) if bidirectional else self.hidden_dim1,
                       self.e_layers, batch_first=self.batch_first, bidirectional=bidirectional)
        self.ffn2 = nn.Sequential(
            nn.Linear(self.hidden_dim1, self.hidden_dim1),
            nn.LayerNorm(self.hidden_dim1),
            nn.GELU()
        )

        # prediction heads
        dim_in = self.hidden_dim1 * 2
        if self.non_seq_len > 0:
            dim_in += self.non_seq_len
        self.pred_head1 = nn.Sequential(
            nn.Linear(dim_in, self.hidden_dim1 * 4),
            nn.LayerNorm(self.hidden_dim1 * 4),
            nn.GELU(),
            nn.Dropout(self.dropout),
            nn.Linear(self.hidden_dim1 * 4, 4)
        )

        if isinstance(self.target, list) and 'psi' in self.target and 'rpe' in self.target:
            self.pred_head2 = nn.Sequential(
                nn.Linear(dim_in + 4, self.hidden_dim1 * 4),
                nn.LayerNorm(self.hidden_dim1 * 4),
                nn.GELU(),
                nn.Dropout(self.dropout),
                nn.Linear(self.hidden_dim1 * 4, 4)
            )
            self.soft_max = nn.Softmax(dim=1)
        else:
            self.pred_head2 = None
def forward(self, x, x_mark_enc=None, one_hot_x=None, device='cpu'):
        B, L, N = x.shape  # batch, seq_len, feature_num

        # conv features
        conv_feats = self.conv_feats(x.permute(0, 2, 1)).permute(0, 2, 1).reshape(B, -1)
        conv_feats = self.ffn1(conv_feats)

        # rnn features
        if self.seq_len > 60:
            x = torch.adaptive_avg_pool1d(x.permute(0, 2, 1), int(self.seq_len / 60)).permute(0, 2, 1)
        rnn_feats = self.rnn(x)[0][:, -1, :]
        rnn_feats = self.ffn2(rnn_feats)

        # combined features
        if self.non_seq_len > 0 and one_hot_x is not None:
            comb_feats = torch.cat((conv_feats, rnn_feats, one_hot_x), dim=1)
        else:
            comb_feats = torch.cat((conv_feats, rnn_feats), dim=1)

        # classification
        if self.pred_head2 is None:
            cla = self.pred_head1(comb_feats)
            if self.target == 'rpe' or 'psi' not in self.target:
                return cla, None
            else:
                return None, cla
        else:
            psi_out = self.pred_head1(comb_feats)
            psi_cla = self.soft_max(psi_out)
            rpe_out = self.pred_head2(torch.cat((comb_feats, psi_cla), dim=1))
            return rpe_out, psi_out

