extern "C" void tcn_v6_sample317_ethosu_boundary(
    const int8_t* data,
    uint32_t bytes,
    uint32_t invocation_index,
    uint32_t stage) {

    if (stage == 0U) {
        printk("TCN_V6_FIRST_ETHOS_INPUT_BEGIN: idx=%u bytes=%u\n",
               invocation_index, bytes);
        k_sleep(K_MSEC(35));

        Sample317BoundaryReport(
            "INPUT", data, bytes,
            sample317_ethosu_reference::kFirstEthosInput,
            static_cast<uint32_t>(sizeof(sample317_ethosu_reference::kFirstEthosInput)),
            invocation_index);

        printk("TCN_V6_FIRST_ETHOS_INPUT_END\n");
        k_sleep(K_MSEC(35));
    } else if (stage == 1U) {
        printk("TCN_V6_FIRST_ETHOS_OUTPUT_BEGIN: idx=%u bytes=%u\n",
               invocation_index, bytes);

        // Copy immediately before the existing 35ms sleep.
        // Static storage avoids adding 28.8KB to the thread stack.
        static int8_t tcn_v6_first_ethos_output_snapshot[28800U];

        const uint32_t tcn_v6_expected_output_bytes =
            static_cast<uint32_t>(
                sizeof(sample317_ethosu_reference::kFirstEthosOutput));

        if (bytes == tcn_v6_expected_output_bytes) {
            for (uint32_t i = 0U; i < bytes; ++i) {
                tcn_v6_first_ethos_output_snapshot[i] = data[i];
            }

            printk("TCN_V6_FIRST_ETHOS_IMMEDIATE_BEGIN: idx=%u bytes=%u\n",
                   invocation_index, bytes);

            Sample317BoundaryReport(
                "OUTPUT_IMMEDIATE",
                tcn_v6_first_ethos_output_snapshot,
                bytes,
                sample317_ethosu_reference::kFirstEthosOutput,
                tcn_v6_expected_output_bytes,
                invocation_index);

            printk("TCN_V6_FIRST_ETHOS_IMMEDIATE_END\n");
        } else {
            printk("TCN_V6_FIRST_ETHOS_IMMEDIATE_SKIP: bytes=%u expected=%u\n",
                   bytes, tcn_v6_expected_output_bytes);
        }

        k_sleep(K_MSEC(35));

        Sample317BoundaryReport(
            "OUTPUT_AFTER_35MS", data, bytes,
            sample317_ethosu_reference::kFirstEthosOutput,
            static_cast<uint32_t>(sizeof(sample317_ethosu_reference::kFirstEthosOutput)),
            invocation_index);


        // Compare the live output with the snapshot captured at callback entry.
        if (bytes == tcn_v6_expected_output_bytes) {
            uint32_t changed_bytes = 0U;
            uint32_t first_changed = 0xFFFFFFFFU;
            uint32_t max_change = 0U;

            for (uint32_t i = 0U; i < bytes; ++i) {
                const int delta =
                    static_cast<int>(data[i]) -
                    static_cast<int>(
                        tcn_v6_first_ethos_output_snapshot[i]);

                if (delta != 0) {
                    ++changed_bytes;

                    if (first_changed == 0xFFFFFFFFU) {
                        first_changed = i;
                    }

                    const uint32_t abs_delta =
                        static_cast<uint32_t>(
                            delta < 0 ? -delta : delta);

                    if (abs_delta > max_change) {
                        max_change = abs_delta;
                    }
                }
            }

            printk("TCN_V6_FIRST_ETHOS_BUFFER_STABILITY: "
                   "bytes=%u changed_bytes=%u first_changed=%u "
                   "max_change=%u\n",
                   bytes, changed_bytes, first_changed, max_change);
        }

        // Time/channel localization of the first Ethos-U output mismatch.
        // Tensor 54 is [1, 900, 32] INT8.
        if (bytes == static_cast<uint32_t>(
                sizeof(sample317_ethosu_reference::kFirstEthosOutput))) {
            constexpr uint32_t kRows = 900U;
            constexpr uint32_t kChannels = 32U;
            constexpr uint32_t kWindowRows = 60U;
            constexpr uint32_t kWindows = 15U;
            constexpr uint32_t kBitmapBytes = (kRows + 7U) / 8U;
            constexpr uint32_t kFirstSamples = 30U;

