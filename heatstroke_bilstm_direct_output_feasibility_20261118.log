   484	TFLMRegistration RegisterHeatstrokeBidirectionalSequenceLstm() {
   485	  return micro::RegisterOp(
   486	      HeatstrokeBidirectionalLstmInit,
   487	      HeatstrokeBidirectionalLstmPrepare,
   488	      HeatstrokeBidirectionalLstmEval);
   489	}
