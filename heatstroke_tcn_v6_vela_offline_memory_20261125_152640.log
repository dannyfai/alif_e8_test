    34	// Mark the given Allocation info as first created at the specified allocation
    35	// scope count. Only the first creation must be recorded since the allocation
    36	// scope count monotonically increases throughout the lifetime marking process.
    37	void AllocationInfoBuilder::UpdateFirstCreated(AllocationInfo* current,
    38	                                               int allocation_scope_count) {
    39	  TFLITE_DCHECK(current->first_created <= allocation_scope_count);
    40	  if (current->first_created == kUninitializedLifetime) {
    41	    current->first_created = allocation_scope_count;
    42	  }
    43	}
    44	
    45	// Mark the given AllocationInfo as last used at the specified allocation scope
    46	// count. Update the last used marker every time, since the allocation scope
    47	// count monotonically increases through the lifetime marking process.
    48	void AllocationInfoBuilder::UpdateLastUsed(AllocationInfo* current,
    49	                                           int allocation_scope_count) {
    50	  TFLITE_DCHECK(current->last_used <= allocation_scope_count);
    51	  current->last_used = allocation_scope_count;
    52	}
