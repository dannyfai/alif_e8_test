   103	TfLiteStatus AllocationInfoBuilder::CreateAllocationInfo(
   104	    int scratch_buffer_request_count) {
   105	  size_t subgraph_offsets_length = model_->subgraphs()->size() * sizeof(size_t);
   106	  info_.subgraph_offsets =
   107	      reinterpret_cast<size_t*>(non_persistent_allocator_->AllocateTemp(
   108	          subgraph_offsets_length, alignof(size_t)));
   109	  if (info_.subgraph_offsets == nullptr) {
   110	    MicroPrintf(
   111	        "Failed to allocate memory for memory planning, %d bytes required",
   112	        subgraph_offsets_length);
   113	    return kTfLiteError;
   114	  }
   115	  size_t tensor_count = 0;
   116	  for (size_t subgraph_idx = 0; subgraph_idx < model_->subgraphs()->size();
   117	       subgraph_idx++) {
   118	    // Add all tensors in each subgraph to the AllocationInfo array. Even weight
   119	    // tensors are added but marked with needs_allocating = false. Including all
   120	    // tensors in the graph here simplifies logic.
   121	    info_.subgraph_offsets[subgraph_idx] = tensor_count;
   122	    tensor_count += model_->subgraphs()->Get(subgraph_idx)->tensors()->size();
   123	  }
   124	  info_.tensor_count = tensor_count;
   125	
   126	  // Scratch buffer allocations follow tensor allocations, so the scratch offset
   127	  // is equal to the number of tensor allocations.
   128	  info_.scratch_offset = tensor_count;
   129	  info_.allocation_info_count = tensor_count + scratch_buffer_request_count;
   130	  info_.scratch_buffer_count = scratch_buffer_request_count;
   131	  size_t bytes = sizeof(AllocationInfo) * info_.allocation_info_count;
   132	
   133	  // Allocate an array of AllocationInfo structs from the temp section. This
   134	  // struct will be used by AllocationInfoBuilder to find buffer usage.
   135	  info_.allocation_info = reinterpret_cast<AllocationInfo*>(
   136	      non_persistent_allocator_->AllocateTemp(bytes, alignof(AllocationInfo)));
   137	  if (info_.allocation_info == nullptr) {
   138	    MicroPrintf(
   139	        "Failed to allocate memory for memory planning, %d bytes required",
   140	        bytes);
   141	    return kTfLiteError;
   142	  }
   143	  return kTfLiteOk;
   144	}
   145	
   146	TfLiteStatus AllocationInfoBuilder::FreeAllocationInfo() {
   147	  non_persistent_allocator_->DeallocateTemp(
   148	      reinterpret_cast<uint8_t*>(info_.allocation_info));
   149	  non_persistent_allocator_->DeallocateTemp(
   150	      reinterpret_cast<uint8_t*>(info_.subgraph_offsets));
   151	  return kTfLiteOk;
   152	}
