   154	TfLiteStatus AllocationInfoBuilder::ValidateSubgraph(
   155	    const SubGraph* subgraph, TfLiteEvalTensor* eval_tensors) {
   156	  uint32_t operators_size = NumSubgraphOperators(subgraph);
   157	
   158	  for (uint32_t i = 0; i < operators_size; i++) {
   159	    const auto op = subgraph->operators()->Get(i);
   160	    for (size_t n = 0;
   161	         op->intermediates() != nullptr && n < op->intermediates()->size();
   162	         n++) {
   163	      const int tensor_index = op->intermediates()->Get(n);
   164	      size_t tensor_size = -1;
   165	      TF_LITE_ENSURE_STATUS(TfLiteEvalTensorByteLength(
   166	          &eval_tensors[tensor_index], &tensor_size));
   167	      if (tensor_size != 0) {
   168	        MicroPrintf(
   169	            "Does not support intermediate tensor with non-zero size: %d",
   170	            tensor_size);
   171	        return kTfLiteError;
   172	      }
   173	    }
   174	  }
   175	  return kTfLiteOk;
   176	}
