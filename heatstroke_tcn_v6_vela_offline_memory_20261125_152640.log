  1112	TfLiteStatus MicroAllocator::CommitStaticMemoryPlan(
  1113	    const Model* model, SubgraphAllocations* allocations,
  1114	    ScratchBufferHandle* scratch_buffer_handles) {
  1115	  size_t head_usage = 0;
  1116	  // Create static memory plan
  1117	  // 1. Calculate AllocationInfo to know the lifetime of each tensor/buffer.
  1118	  // 2. Add them into the planner (such as the GreedyMemoryPlanner).
  1119	  // 3. Static memory planning using the planner.
  1120	  // 4. Set tensor/buffer pointers based on the offsets from the previous step.
  1121	  //
  1122	  // Note that AllocationInfo is only needed for creating the plan. It will be
  1123	  // allocated from the temp section and cleaned up at the bottom of this
  1124	  // function.
  1125	
  1126	  // Use the AllocationInfoBuilder class to help determine where buffers are
  1127	  // used in the subgraph.
  1128	  AllocationInfoBuilder builder(model, non_persistent_buffer_allocator_);
  1129	  TF_LITE_ENSURE_STATUS(
  1130	      builder.CreateAllocationInfo(scratch_buffer_request_count_));
  1131	
  1132	  const int32_t* offline_planner_offsets = nullptr;
  1133	  TF_LITE_ENSURE_STATUS(
  1134	      builder.GetOfflinePlannedOffsets(&offline_planner_offsets));
  1135	
  1136	  // We allocate buffers for variable tensors here since the offline planner
  1137	  // offsets are conviently available here.
  1138	  for (size_t subgraph_idx = 0; subgraph_idx < model->subgraphs()->size();
  1139	       subgraph_idx++) {
  1140	    const SubGraph* subgraph = model->subgraphs()->Get(subgraph_idx);
  1141	    TFLITE_DCHECK(subgraph != nullptr);
  1142	    TF_LITE_ENSURE_STATUS(AllocateVariables(
  1143	        subgraph, allocations[subgraph_idx].tensors, offline_planner_offsets));
  1144	  }
  1145	
  1146	  TF_LITE_ENSURE_STATUS(
  1147	      builder.InitializeAllocationInfo(offline_planner_offsets, allocations));
  1148	
  1149	  internal::ScratchBufferRequest* scratch_buffer_requests =
  1150	      GetScratchBufferRequests();
  1151	  TF_LITE_ENSURE_STATUS(builder.MarkAllocationLifetimes(
  1152	      0, scratch_buffer_requests, scratch_buffer_handles, allocations));
  1153	  int allocation_info_count = builder.AllocationCount();
  1154	  AllocationInfo* allocation_info = builder.Finish();
  1155	
  1156	  // Remaining arena size that memory planner can use for calculating offsets.
  1157	  size_t remaining_arena_size =
  1158	      non_persistent_buffer_allocator_->GetAvailableMemory(
  1159	          MicroArenaBufferAlignment());
  1160	  uint8_t* planner_arena = non_persistent_buffer_allocator_->AllocateTemp(
  1161	      remaining_arena_size, MicroArenaBufferAlignment());
  1162	
  1163	  if (planner_arena == nullptr) {
  1164	    return kTfLiteError;
  1165	  }
  1166	
  1167	  memory_planner_->Init(planner_arena, remaining_arena_size);
  1168	  TF_LITE_ENSURE_STATUS(
  1169	      CreatePlan(memory_planner_, allocation_info, allocation_info_count));
  1170	
  1171	  // Commit the plan.
  1172	  TF_LITE_ENSURE_STATUS(
  1173	      CommitPlan(memory_planner_,
  1174	                 non_persistent_buffer_allocator_->GetOverlayMemoryAddress(),
  1175	                 allocation_info, allocation_info_count));
  1176	
  1177	  // Reset all temp allocations used above:
