   233	TfLiteStatus AllocationInfoBuilder::MarkAllocationLifetimes(
   234	    int subgraph_idx, internal::ScratchBufferRequest* scratch_buffer_requests,
   235	    ScratchBufferHandle* scratch_buffer_handles,
   236	    SubgraphAllocations* allocations) {
   237	  const SubGraph* subgraph = model_->subgraphs()->Get(subgraph_idx);
   238	
   239	  AllocationInfo* allocation_info = info_.allocation_info;
   240	  // Each subgraph's tensor allocations are in a contiguous block starting at
   241	  // subgraph_offsets_[subgraph index] with one entry per tensor.
   242	  AllocationInfo* subgraph_allocation_info =
   243	      &allocation_info[info_.subgraph_offsets[subgraph_idx]];
   244	
   245	  uint32_t operators_size = NumSubgraphOperators(subgraph);
   246	  // Mark all inputs as created at the start of the subgraph invocation.
   247	  for (size_t i = 0;
   248	       subgraph->inputs() != nullptr && i < subgraph->inputs()->size(); ++i) {
   249	    const int tensor_index = subgraph->inputs()->Get(i);
   250	    AllocationInfo* current = &subgraph_allocation_info[tensor_index];
   251	    UpdateFirstCreated(current, allocation_scope_count_);
   252	    // This will ensure that the tensors that are inputs to the subgraphs
   253	    // but not used in any ops also have a reasonable lifetime.
   254	    UpdateLastUsed(current, allocation_scope_count_);
   255	  }
   256	
   257	  for (uint32_t i = 0; i < operators_size; i++) {
   258	    // Each operator has a new allocation scope.
   259	    allocation_scope_count_++;
   260	    const auto* op = subgraph->operators()->Get(i);
   261	    // Figure out when the first creation and use of each tensor is.
   262	    for (size_t n = 0; op->outputs() != nullptr && n < op->outputs()->size();
   263	         ++n) {
   264	      const int tensor_index = op->outputs()->Get(n);
   265	      AllocationInfo* current = &subgraph_allocation_info[tensor_index];
   266	      UpdateFirstCreated(current, allocation_scope_count_);
   267	    }
   268	
   269	    // Keep track of scope count before any subgraphs, so that scratch buffers'
   270	    // lifetime within a control flow op properly overlaps with all subgraphs.
   271	    int start_allocation_scope_count = allocation_scope_count_;
   272	
   273	    // Control flow operators can invoke subgraphs. Plan these subgraphs
   274	    // before continuing on to the rest of the graph.
   275	    MarkSubgraphLifetimesIfNecessary(op, scratch_buffer_requests,
   276	                                     scratch_buffer_handles, allocations);
   277	
   278	    // Figure out when the last use of each tensor is.
   279	    for (size_t n = 0; op->inputs() != nullptr && n < op->inputs()->size();
   280	         ++n) {
   281	      const int tensor_index = op->inputs()->Get(n);
   282	      // Optional bias tensors can have an index of -1 when they are omitted.
   283	      if (tensor_index >= 0) {
   284	        AllocationInfo* current = &subgraph_allocation_info[tensor_index];
   285	        // No need to update creation since it is either marked by the subgraph
   286	        // or producer op, or it is not part of the memory plan (weight, bias
   287	        // tensor).
   288	        UpdateLastUsed(current, allocation_scope_count_);
   289	      }
   290	    }
   291	    for (size_t n = 0; op->outputs() != nullptr && n < op->outputs()->size();
   292	         ++n) {
   293	      const int tensor_index = op->outputs()->Get(n);
   294	      AllocationInfo* current = &subgraph_allocation_info[tensor_index];
   295	      UpdateLastUsed(current, allocation_scope_count_);
   296	    }
   297	
   298	    // Mark thse lifetime of scratch buffers belonging to the current node. This
   299	    // operation is O(N * M) where N is the total number of visited nodes and M
   300	    // is the total number of scratch buffers.
   301	    // TODO(b/217794030): Optimize this memory planning code.
   302	    AllocationInfo* scratch_allocation_info =
   303	        &allocation_info[info_.scratch_offset];
   304	    for (size_t scratch_idx = 0; scratch_idx < info_.scratch_buffer_count;
   305	         scratch_idx++) {
   306	      internal::ScratchBufferRequest request =
   307	          scratch_buffer_requests[scratch_idx];
   308	      AllocationInfo* current = &scratch_allocation_info[scratch_idx];
   309	      if (request.node_idx == static_cast<int>(i) &&
   310	          request.subgraph_idx == static_cast<int>(subgraph_idx)) {
   311	        ScratchBufferHandle* current_handle =
   312	            &(scratch_buffer_handles[scratch_idx]);
   313	        current->output_ptr = reinterpret_cast<void**>(&current_handle->data);
   314	        current->bytes = request.bytes;
   315	        UpdateFirstCreated(current, start_allocation_scope_count);
   316	        UpdateLastUsed(current, allocation_scope_count_);
   317	      }
   318	    }
   319	  }
   320	
   321	  // Mark all outputs as persistent to the end of the subgraph invocation.
   322	  for (size_t i = 0;
   323	       subgraph->outputs() != nullptr && i < subgraph->outputs()->size(); ++i) {
   324	    const int tensor_index = subgraph->outputs()->Get(i);
   325	    AllocationInfo* current = &subgraph_allocation_info[tensor_index];
   326	    // Make sure to assign the First created value of the subgraph output
   327	    // This will handle the case where the subgraph is empty. This helps
   328	    // ensure all tensors have valid lifetimes before those are used by the
   329	    // memory planner.
   330	    UpdateFirstCreated(current, allocation_scope_count_);
   331	    UpdateLastUsed(current, allocation_scope_count_);
   332	  }
   333	  return kTfLiteOk;
   334	}
