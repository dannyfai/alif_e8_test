    54	TfLiteStatus AllocationInfoBuilder::MarkSubgraphLifetimesIfNecessary(
    55	    const Operator* op, internal::ScratchBufferRequest* scratch_buffer_requests,
    56	    ScratchBufferHandle* scratch_buffer_handles,
    57	    SubgraphAllocations* allocations) {
    58	  int first_subgraph_index = -1;
    59	  int second_subgraph_index = -1;
    60	  const OperatorCode* opcode =
    61	      model_->operator_codes()->Get(op->opcode_index());
    62	  switch (opcode->builtin_code()) {
    63	    case BuiltinOperator_IF: {
    64	      first_subgraph_index =
    65	          op->builtin_options_as_IfOptions()->then_subgraph_index();
    66	      second_subgraph_index =
    67	          op->builtin_options_as_IfOptions()->else_subgraph_index();
    68	      break;
    69	    }
    70	    case BuiltinOperator_CALL_ONCE: {
    71	      first_subgraph_index =
    72	          op->builtin_options_as_CallOnceOptions()->init_subgraph_index();
    73	      break;
    74	    }
    75	    case BuiltinOperator_WHILE: {
    76	      first_subgraph_index =
    77	          op->builtin_options_as_WhileOptions()->cond_subgraph_index();
    78	      second_subgraph_index =
    79	          op->builtin_options_as_WhileOptions()->body_subgraph_index();
    80	      break;
    81	    }
    82	    default: {
    83	      break;
    84	    }
    85	  }
    86	  if (first_subgraph_index != -1) {
    87	    // Enter a new allocation scope for each subgraph.
    88	    allocation_scope_count_++;
    89	    TF_LITE_ENSURE_STATUS(
    90	        MarkAllocationLifetimes(first_subgraph_index, scratch_buffer_requests,
    91	                                scratch_buffer_handles, allocations));
    92	  }
    93	  if (second_subgraph_index != -1) {
    94	    // Enter a new allocation scope for each subgraph.
    95	    allocation_scope_count_++;
    96	    TF_LITE_ENSURE_STATUS(
    97	        MarkAllocationLifetimes(second_subgraph_index, scratch_buffer_requests,
    98	                                scratch_buffer_handles, allocations));
    99	  }
   100	  return kTfLiteOk;
   101	}
