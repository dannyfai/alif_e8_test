   183	static void button_callback(const struct device *dev, struct gpio_callback *cb, uint32_t pins)
   184	{
   185		ARG_UNUSED(dev);
   186		ARG_UNUSED(cb);
   187		ARG_UNUSED(pins);
   188	
   189		if (por_boot) {
   190			/* Ignore button press event if it's from POR boot, as the button state may be unstable during POR. */
   191			return;
   192		}
   193	
   194		int val = gpio_pin_get_dt(&lpgpio_config);  // 1 = pressed, 0 = released
   195	    if (val < 0) {
   196	        LOG_ERR("Failed to read pin: %d", val);
   197	        return;
   198	    }
   199	
   200	    button_pressed = (val == 1);
   201	    LOG_INF("Button %s", button_pressed ? "pressed" : "released");
   202	
   203		if (!k_sem_count_get(&button_wait_sem) && button_pressed) {
   204			k_sem_give(&button_wait_sem);
   205		}
   206	}
