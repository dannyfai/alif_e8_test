    35	    CACHE STRING "E8 OSPI and external model flash overlay" FORCE)
    36	
    37	find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
    38	
    39	project(heatstroke_tcn_v6_e8)
    40	
    41	set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wno-psabi")
    42	set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-psabi")
    43	
    44	set(ML_FRAMEWORK TensorFlowLiteMicro)
    45	set(MLEK_SCRIPTS_DIR "${MLEK_ROOT}/scripts")
    46	set(RESOURCES_PATH "${MLEK_ROOT}/resources_downloaded" CACHE PATH
    47	    "MLEK resources")
    48	
    49	setup_source_generator()
    50	
    51	set(SRC_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated/src")
    52	set(INC_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated/include")
    53	file(MAKE_DIRECTORY "${SRC_GEN_DIR}" "${INC_GEN_DIR}")
