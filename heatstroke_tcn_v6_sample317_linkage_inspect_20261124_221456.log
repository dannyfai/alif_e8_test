    57	
    58	set(POLYU_MODEL_SHA256_EXPECTED
    59	    "0cd9abb79a559017dfebaf75b11c597f9af10fc97cf8f41385d60dbcf6c1cf1d")
    60	
    61	if(NOT EXISTS "${POLYU_MODEL_PATH}")
    62	    message(FATAL_ERROR "V6 Vela model not found: ${POLYU_MODEL_PATH}")
    63	endif()
    64	
    65	file(SHA256 "${POLYU_MODEL_PATH}" POLYU_MODEL_SHA256_ACTUAL)
    66	if(NOT POLYU_MODEL_SHA256_ACTUAL STREQUAL POLYU_MODEL_SHA256_EXPECTED)
    67	    message(FATAL_ERROR
