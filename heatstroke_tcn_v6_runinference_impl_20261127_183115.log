=== TCN V6 MODEL HEADER ===
#ifndef TCN_V6_MODEL_HPP
#define TCN_V6_MODEL_HPP

#include "mlek/fwk/tflm/TflmModel.hpp"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"

namespace heatstroke_tcn_v6 {

class TcnV6Model final : public arm::app::fwk::tflm::TflmModel {
public:
    bool PrepareResolver();

protected:
    const tflite::MicroOpResolver& GetOpResolver() override;
    bool EnlistOperations() override;

private:
    tflite::MicroMutableOpResolver<29> m_resolver;
    bool m_resolverAttempted{false};
    bool m_resolverOk{false};
};

} // namespace heatstroke_tcn_v6

#endif

=== TCN V6 MODEL IMPLEMENTATION ===
#include "TcnV6Model.hpp"

#include <zephyr/sys/printk.h>

#include "tensorflow/lite/micro/kernels/ethosu.h"

namespace heatstroke_tcn_v6 {

const tflite::MicroOpResolver& TcnV6Model::GetOpResolver()
{
    return m_resolver;
}

bool TcnV6Model::PrepareResolver()
{
    return EnlistOperations();
}

bool TcnV6Model::EnlistOperations()
{
    // TflmModel::Init() calls this again. Cache the result so that the
    // resolver is not populated twice.
    if (m_resolverAttempted) {
        return m_resolverOk;
    }

    m_resolverAttempted = true;
    bool ok = true;

#define TCN6_ADD_OP(label, expression)                                  \
    do {                                                                \
        const TfLiteStatus status = (expression);                       \
        if (status != kTfLiteOk) {                                      \
            printk("TCN_V6_RESOLVER: Add%s failed: %d\n",               \
                   label, static_cast<int>(status));                    \
            ok = false;                                                 \
        }                                                               \
    } while (0)

    // Exactly the 25 built-in operators in the INT8-mask Vela model.
    TCN6_ADD_OP("Abs",             m_resolver.AddAbs());
    TCN6_ADD_OP("Add",             m_resolver.AddAdd());
    TCN6_ADD_OP("BroadcastArgs",   m_resolver.AddBroadcastArgs());
    TCN6_ADD_OP("BroadcastTo",     m_resolver.AddBroadcastTo());
    TCN6_ADD_OP("Cast",            m_resolver.AddCast());
    TCN6_ADD_OP("Concatenation",   m_resolver.AddConcatenation());
TCN6_ADD_OP("Dequantize",      m_resolver.AddDequantize());
    TCN6_ADD_OP("Div",             m_resolver.AddDiv());
    TCN6_ADD_OP("Exp",             m_resolver.AddExp());
    TCN6_ADD_OP("FullyConnected", m_resolver.AddFullyConnected());
    TCN6_ADD_OP("Gather",          m_resolver.AddGather());
    TCN6_ADD_OP("GreaterEqual",    m_resolver.AddGreaterEqual());
TCN6_ADD_OP("Maximum",         m_resolver.AddMaximum());
    TCN6_ADD_OP("Mean",            m_resolver.AddMean());
    TCN6_ADD_OP("MirrorPad",       m_resolver.AddMirrorPad());
    TCN6_ADD_OP("Mul",             m_resolver.AddMul());
    TCN6_ADD_OP("Neg",             m_resolver.AddNeg());
    TCN6_ADD_OP("Quantize",        m_resolver.AddQuantize());
    TCN6_ADD_OP("Relu",            m_resolver.AddRelu());
    TCN6_ADD_OP("Reshape",         m_resolver.AddReshape());
    TCN6_ADD_OP("SelectV2",        m_resolver.AddSelectV2());
    TCN6_ADD_OP("Sqrt",            m_resolver.AddSqrt());
    TCN6_ADD_OP("Sub",             m_resolver.AddSub());
    TCN6_ADD_OP("Sum",             m_resolver.AddSum());
    TCN6_ADD_OP("Transpose",       m_resolver.AddTranspose());

#undef TCN6_ADD_OP

    // AddEthosU() in this SDK can return kTfLiteOk even when the
    // underlying Register_ETHOSU() returns nullptr. Check it explicitly.
    TFLMRegistration* native_ethos_registration =
        tflite::Register_ETHOSU();

    if (native_ethos_registration == nullptr ||
        native_ethos_registration->invoke == nullptr) {
        printk("TCN_V6_RESOLVER: native Ethos-U registration/invoke missing\n");
        ok = false;
    } else {
        const TfLiteStatus status = m_resolver.AddEthosU();
        if (status != kTfLiteOk) {
            printk("TCN_V6_RESOLVER: AddEthosU failed: %d\n",
                   static_cast<int>(status));
            ok = false;
        }
    }

    // Verify that every built-in registration exists and has an invoke.
    const tflite::BuiltinOperator expected_ops[] = {
        tflite::BuiltinOperator_ABS,
        tflite::BuiltinOperator_ADD,
        tflite::BuiltinOperator_BROADCAST_ARGS,
        tflite::BuiltinOperator_BROADCAST_TO,
        tflite::BuiltinOperator_CAST,
        tflite::BuiltinOperator_CONCATENATION,
        tflite::BuiltinOperator_DEQUANTIZE,
        tflite::BuiltinOperator_DIV,
        tflite::BuiltinOperator_EXP,
        tflite::BuiltinOperator_FULLY_CONNECTED,
        tflite::BuiltinOperator_GATHER,
        tflite::BuiltinOperator_GREATER_EQUAL,
        tflite::BuiltinOperator_MAXIMUM,
        tflite::BuiltinOperator_MEAN,
        tflite::BuiltinOperator_MIRROR_PAD,
        tflite::BuiltinOperator_MUL,
        tflite::BuiltinOperator_NEG,
        tflite::BuiltinOperator_QUANTIZE,
        tflite::BuiltinOperator_RELU,
        tflite::BuiltinOperator_RESHAPE,
        tflite::BuiltinOperator_SELECT_V2,
        tflite::BuiltinOperator_SQRT,
        tflite::BuiltinOperator_SUB,
        tflite::BuiltinOperator_SUM,
        tflite::BuiltinOperator_TRANSPOSE
    };

    for (const auto op : expected_ops) {
        const TFLMRegistration* registration = m_resolver.FindOp(op);
        if (registration == nullptr || registration->invoke == nullptr) {
            printk("TCN_V6_RESOLVER: missing builtin registration %d\n",
                   static_cast<int>(op));
            ok = false;
        }
    }

    const char* ethos_name = tflite::GetString_ETHOSU();
    const TFLMRegistration* ethos =
        (ethos_name != nullptr) ? m_resolver.FindOp(ethos_name) : nullptr;

    if (ethos == nullptr || ethos->invoke == nullptr) {
        printk("TCN_V6_RESOLVER: custom ethos-u registration not found\n");
        ok = false;
    }

    m_resolverOk = ok;

    printk("TCN_V6_RESOLVER: builtin_expected=25 custom=ethos-u status=%s\n",
           m_resolverOk ? "PASS" : "FAIL");

    return m_resolverOk;
}

} // namespace heatstroke_tcn_v6

