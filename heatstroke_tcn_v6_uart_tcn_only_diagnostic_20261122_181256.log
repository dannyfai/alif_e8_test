    19	bool TcnV6Model::EnlistOperations()
    20	{
    21	    // TflmModel::Init() calls this again. Cache the result so that the
    22	    // resolver is not populated twice.
    23	    if (m_resolverAttempted) {
    24	        return m_resolverOk;
    25	    }
    26	
    27	    m_resolverAttempted = true;
    28	    bool ok = true;
    29	
    30	#define TCN6_ADD_OP(label, expression)                                  \
    31	    do {                                                                \
    32	        const TfLiteStatus status = (expression);                       \
    33	        if (status != kTfLiteOk) {                                      \
    34	            printk("TCN_V6_RESOLVER: Add%s failed: %d\n",               \
    35	                   label, static_cast<int>(status));                    \
    36	            ok = false;                                                 \
    37	        }                                                               \
    38	    } while (0)
    39	
    40	    // Exactly the 28 distinct built-in operators from the V6 audit.
    41	    TCN6_ADD_OP("Abs",             m_resolver.AddAbs());
    42	    TCN6_ADD_OP("Add",             m_resolver.AddAdd());
    43	    TCN6_ADD_OP("BroadcastArgs",   m_resolver.AddBroadcastArgs());
    44	    TCN6_ADD_OP("BroadcastTo",     m_resolver.AddBroadcastTo());
    45	    TCN6_ADD_OP("Cast",            m_resolver.AddCast());
    46	    TCN6_ADD_OP("Concatenation",   m_resolver.AddConcatenation());
    47	    TCN6_ADD_OP("Conv2D",          m_resolver.AddConv2D());
    48	    TCN6_ADD_OP("DepthwiseConv2D", m_resolver.AddDepthwiseConv2D());
    49	    TCN6_ADD_OP("Dequantize",      m_resolver.AddDequantize());
    50	    TCN6_ADD_OP("Div",             m_resolver.AddDiv());
    51	    TCN6_ADD_OP("Exp",             m_resolver.AddExp());
    52	    TCN6_ADD_OP("Gather",          m_resolver.AddGather());
    53	    TCN6_ADD_OP("GreaterEqual",    m_resolver.AddGreaterEqual());
    54	    TCN6_ADD_OP("LogicalNot",      m_resolver.AddLogicalNot());
    55	    TCN6_ADD_OP("LogicalOr",       m_resolver.AddLogicalOr());
    56	    TCN6_ADD_OP("Maximum",         m_resolver.AddMaximum());
    57	    TCN6_ADD_OP("Mean",            m_resolver.AddMean());
    58	    TCN6_ADD_OP("MirrorPad",       m_resolver.AddMirrorPad());
    59	    TCN6_ADD_OP("Mul",             m_resolver.AddMul());
    60	    TCN6_ADD_OP("Neg",             m_resolver.AddNeg());
    61	    TCN6_ADD_OP("Quantize",        m_resolver.AddQuantize());
    62	    TCN6_ADD_OP("Relu",            m_resolver.AddRelu());
    63	    TCN6_ADD_OP("Reshape",         m_resolver.AddReshape());
    64	    TCN6_ADD_OP("SelectV2",        m_resolver.AddSelectV2());
    65	    TCN6_ADD_OP("Sqrt",            m_resolver.AddSqrt());
    66	    TCN6_ADD_OP("Sub",             m_resolver.AddSub());
    67	    TCN6_ADD_OP("Sum",             m_resolver.AddSum());
    68	    TCN6_ADD_OP("Transpose",       m_resolver.AddTranspose());
    69	
    70	#undef TCN6_ADD_OP
    71	
    72	    // AddEthosU() in this SDK can return kTfLiteOk even when the
    73	    // underlying Register_ETHOSU() returns nullptr. Check it explicitly.
    74	    TFLMRegistration* native_ethos_registration =
    75	        tflite::Register_ETHOSU();
    76	
    77	    if (native_ethos_registration == nullptr ||
    78	        native_ethos_registration->invoke == nullptr) {
    79	        printk("TCN_V6_RESOLVER: native Ethos-U registration/invoke missing\n");
    80	        ok = false;
    81	    } else {
    82	        const TfLiteStatus status = m_resolver.AddEthosU();
    83	        if (status != kTfLiteOk) {
    84	            printk("TCN_V6_RESOLVER: AddEthosU failed: %d\n",
    85	                   static_cast<int>(status));
    86	            ok = false;
    87	        }
    88	    }
    89	
    90	    // Verify that every built-in registration exists and has an invoke.
    91	    const tflite::BuiltinOperator expected_ops[] = {
    92	        tflite::BuiltinOperator_ABS,
    93	        tflite::BuiltinOperator_ADD,
    94	        tflite::BuiltinOperator_BROADCAST_ARGS,
    95	        tflite::BuiltinOperator_BROADCAST_TO,
    96	        tflite::BuiltinOperator_CAST,
    97	        tflite::BuiltinOperator_CONCATENATION,
    98	        tflite::BuiltinOperator_CONV_2D,
    99	        tflite::BuiltinOperator_DEPTHWISE_CONV_2D,
   100	        tflite::BuiltinOperator_DEQUANTIZE,
   101	        tflite::BuiltinOperator_DIV,
   102	        tflite::BuiltinOperator_EXP,
   103	        tflite::BuiltinOperator_GATHER,
   104	        tflite::BuiltinOperator_GREATER_EQUAL,
   105	        tflite::BuiltinOperator_LOGICAL_NOT,
   106	        tflite::BuiltinOperator_LOGICAL_OR,
   107	        tflite::BuiltinOperator_MAXIMUM,
   108	        tflite::BuiltinOperator_MEAN,
   109	        tflite::BuiltinOperator_MIRROR_PAD,
   110	        tflite::BuiltinOperator_MUL,
   111	        tflite::BuiltinOperator_NEG,
   112	        tflite::BuiltinOperator_QUANTIZE,
   113	        tflite::BuiltinOperator_RELU,
   114	        tflite::BuiltinOperator_RESHAPE,
   115	        tflite::BuiltinOperator_SELECT_V2,
   116	        tflite::BuiltinOperator_SQRT,
   117	        tflite::BuiltinOperator_SUB,
   118	        tflite::BuiltinOperator_SUM,
   119	        tflite::BuiltinOperator_TRANSPOSE
   120	    };
   121	
   122	    for (const auto op : expected_ops) {
   123	        const TFLMRegistration* registration = m_resolver.FindOp(op);
   124	        if (registration == nullptr || registration->invoke == nullptr) {
   125	            printk("TCN_V6_RESOLVER: missing builtin registration %d\n",
   126	                   static_cast<int>(op));
   127	            ok = false;
   128	        }
   129	    }
   130	
   131	    const char* ethos_name = tflite::GetString_ETHOSU();
   132	    const TFLMRegistration* ethos =
   133	        (ethos_name != nullptr) ? m_resolver.FindOp(ethos_name) : nullptr;
   134	
   135	    if (ethos == nullptr || ethos->invoke == nullptr) {
   136	        printk("TCN_V6_RESOLVER: custom ethos-u registration not found\n");
   137	        ok = false;
   138	    }
   139	
   140	    m_resolverOk = ok;
   141	
   142	    printk("TCN_V6_RESOLVER: builtin_expected=28 custom=ethos-u status=%s\n",
   143	           m_resolverOk ? "PASS" : "FAIL");
   144	
   145	    return m_resolverOk;
