   182	TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
   183	                                                TfLiteNode* node) {
   184	  if (node == nullptr || node->builtin_data == nullptr ||
   185	      node->inputs == nullptr || node->outputs == nullptr ||
   186	      node->inputs->size != 29 || node->outputs->size != 1 ||
   187	      node->user_data == nullptr) {
   188	    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
   189	    return kTfLiteError;
   190	  }
   191	
   192	  auto* op_data =
   193	      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   194	
   195	  const auto* params =
   196	      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
   197	          node->builtin_data);
   198	
   199	  if (!params->time_major || !params->merge_outputs ||
   200	      params->activation != kTfLiteActTanh) {
   201	    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
   202	    return kTfLiteError;
   203	  }
   204	
   205	  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
   206	  TfLiteEvalTensor* output =
   207	      context->GetEvalTensor(context, node->outputs->data[0]);
   208	
   209	  const int input_type = input != nullptr ? static_cast<int>(input->type) : -1;
   210	  const int output_type = output != nullptr ? static_cast<int>(output->type) : -1;
   211	  const int input_rank = (input != nullptr && input->dims != nullptr)
   212	                             ? input->dims->size : -1;
   213	  const int output_rank = (output != nullptr && output->dims != nullptr)
   214	                              ? output->dims->size : -1;
   215	
   216	  MicroPrintf(
   217	      "Heatstroke BiLSTM input: index=%d type=%d rank=%d dims=%d,%d,%d,%d",
   218	      node->inputs->data[0], input_type, input_rank,
   219	      input_rank > 0 ? input->dims->data[0] : -1,
   220	      input_rank > 1 ? input->dims->data[1] : -1,
   221	      input_rank > 2 ? input->dims->data[2] : -1,
   222	      input_rank > 3 ? input->dims->data[3] : -1);
   223	
   224	  MicroPrintf(
   225	      "Heatstroke BiLSTM output: index=%d type=%d rank=%d dims=%d,%d,%d,%d",
   226	      node->outputs->data[0], output_type, output_rank,
   227	      output_rank > 0 ? output->dims->data[0] : -1,
   228	      output_rank > 1 ? output->dims->data[1] : -1,
   229	      output_rank > 2 ? output->dims->data[2] : -1,
   230	      output_rank > 3 ? output->dims->data[3] : -1);
   231	
   232	  if (!IsFloatTensorType(input) || !IsFloatTensorType(output) ||
   233	      input->dims == nullptr || output->dims == nullptr ||
   234	      input->dims->size != 3 || output->dims->size != 3) {
   235	    MicroPrintf("Heatstroke BiLSTM: expected rank-3 FP32 tensors");
   236	    return kTfLiteError;
   237	  }
   238	
   239	  const int time_steps = input->dims->data[0];
   240	  const int batch_size = input->dims->data[1];
   241	  const int input_dimension = input->dims->data[2];
   242	
   243	  // The supplied heat-stress model uses time-major, single-batch sequences.
   244	  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
   245	    MicroPrintf("Heatstroke BiLSTM: unsupported input dimensions");
   246	    return kTfLiteError;
   247	  }
   248	
   249	  int forward_hidden = 0;
   250	  int backward_hidden = 0;
   251	
   252	  if (!ValidateDirection(context, node, 1, 5, 9, 25, 26, input_dimension, batch_size, &forward_hidden) ||
   253	      !ValidateDirection(context, node, 13, 17, 21, 27, 28, input_dimension, batch_size, &backward_hidden) ||
   254	      forward_hidden != backward_hidden) {
   255	    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
   256	    return kTfLiteError;
   257	  }
   258	
   259	  const int hidden = forward_hidden;
   260	
   261	  if (output->dims->data[0] != time_steps ||
   262	      output->dims->data[1] != batch_size ||
   263	      output->dims->data[2] != 2 * hidden) {
   264	    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
   265	    return kTfLiteError;
   266	  }
   267	
   268	  // The directional evaluator must see [time_steps, batch_size, hidden],
   269	  // not the merged output shape [time_steps, batch_size, 2 * hidden].
   270	  const size_t staged_dims_bytes =
   271	      sizeof(TfLiteIntArray) + 2 * sizeof(int);
   272	  op_data->staged_output_dims =
   273	      static_cast<TfLiteIntArray*>(
   274	          context->AllocatePersistentBuffer(context, staged_dims_bytes));
   275	
   276	  if (op_data->staged_output_dims == nullptr) {
   277	    MicroPrintf("Heatstroke BiLSTM: output dimensions allocation failed");
   278	    return kTfLiteError;
   279	  }
   280	
   281	  op_data->staged_output_dims->size = 3;
   282	  op_data->staged_output_dims->data[0] = time_steps;
   283	  op_data->staged_output_dims->data[1] = batch_size;
   284	  op_data->staged_output_dims->data[2] = hidden;
   285	
   286	  // Compact 29-slot model: no separate auxiliary input slots exist.
   287	
   288	  InitializeFloatLstmParameters(
   289	      &op_data->forward, true, batch_size, time_steps,
   290	      input_dimension, hidden, params->activation, params->cell_clip);
   291	
   292	  InitializeFloatLstmParameters(
   293	      &op_data->backward, true, batch_size, time_steps,
   294	      input_dimension, hidden, params->activation, params->cell_clip);
   295	
   296	  const size_t reverse_bytes =
   297	      static_cast<size_t>(time_steps) * batch_size *
   298	      input_dimension * sizeof(float);
   299	
   300	  const size_t stage_bytes =
   301	      static_cast<size_t>(time_steps) * batch_size *
   302	      hidden * sizeof(float);
   303	
   304	  const size_t internal_bytes =
   305	      static_cast<size_t>(batch_size) * hidden * sizeof(float);
   306	
   307	  if (context->RequestScratchBufferInArena(
   308	          context, reverse_bytes, &op_data->reverse_input_buffer) !=
   309	          kTfLiteOk ||
   310	      context->RequestScratchBufferInArena(
   311	          context, stage_bytes, &op_data->stage_output_buffer) !=
   312	          kTfLiteOk) {
   313	    MicroPrintf("Heatstroke BiLSTM: scratch allocation failed");
   314	    return kTfLiteError;
   315	  }
   316	
   317	  // Match the four scratch buffers requested by TFLM's existing
   318	  // unidirectional FP32 LSTM implementation.
   319	  for (int i = 0; i < 4; ++i) {
   320	    if (context->RequestScratchBufferInArena(
   321	            context, internal_bytes,
   322	            &op_data->forward.buffer_indices[i]) != kTfLiteOk) {
   323	      MicroPrintf("Heatstroke BiLSTM: LSTM scratch allocation failed");
   324	      return kTfLiteError;
   325	    }
   326	
   327	    // Forward and backward passes execute sequentially, so they can
   328	    // safely reuse the same four evaluator scratch buffers.
   329	    op_data->backward.buffer_indices[i] =
   330	        op_data->forward.buffer_indices[i];
   331	  }
   332	
   333	  return kTfLiteOk;
   334	}
