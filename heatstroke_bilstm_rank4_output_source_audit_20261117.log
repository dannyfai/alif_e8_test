   376	TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
   377	                                             TfLiteNode* node) {
   378	  if (node == nullptr || node->user_data == nullptr) {
   379	    return kTfLiteError;
   380	  }
   381	
   382	  const auto* op_data =
   383	      static_cast<const HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   384	
   385	  const TfLiteEvalTensor* input =
   386	      GetInputEvalTensor(context, node, 0);
   387	
   388	  TfLiteEvalTensor* output =
   389	      context->GetEvalTensor(context, node->outputs->data[0]);
   390	
   391	  if (!IsFloatTensor(input) || !IsFloatTensor(output)) {
   392	    return kTfLiteError;
   393	  }
   394	
   395	  const int time_steps = op_data->forward.size_info.time_steps;
   396	  const int input_dimension = op_data->forward.size_info.input_dimension;
   397	  const int hidden = op_data->forward.size_info.state_dimension;
   398	
   399	  auto* reversed_input = static_cast<float*>(
   400	      context->GetScratchBuffer(
   401	          context, op_data->reverse_input_buffer));
   402	
   403	  auto* staged_output = static_cast<float*>(
   404	      context->GetScratchBuffer(
   405	          context, op_data->stage_output_buffer));
   406	
   407	  if (reversed_input == nullptr || staged_output == nullptr) {
   408	    MicroPrintf("Heatstroke BiLSTM: scratch buffer unavailable");
   409	    return kTfLiteError;
   410	  }
   411	
   412	  const float* input_data = input->data.f;
   413	  float* output_data = output->data.f;
   414	
   415	  // Reverse the time dimension for the backward direction.
   416	  for (int t = 0; t < time_steps; ++t) {
   417	    std::memcpy(
   418	        reversed_input + t * input_dimension,
   419	        input_data + (time_steps - 1 - t) * input_dimension,
   420	        input_dimension * sizeof(float));
   421	  }
   422	
   423	  TfLiteEvalTensor reversed_input_tensor = *input;
   424	  reversed_input_tensor.data.f = reversed_input;
   425	
   426	  TfLiteEvalTensor staged_output_tensor = *output;
   427	  staged_output_tensor.data.f = staged_output;
   428	  staged_output_tensor.dims = op_data->staged_output_dims;
   429	
   430	  LSTMKernelContents forward_contents{};
   431	  PopulateDirectionContents(context, node, 1, 5, 9, 25, 26, input, &staged_output_tensor, &forward_contents);
   432	
   433	  LSTMBuffers<float> buffers =
   434	      CreateLSTMBuffers<float>(context, op_data->forward.buffer_indices);
   435	
   436	  TfLiteStatus forward_status =
   437	      EvalLstm<float, float, float, float>(
   438	          op_data->forward, forward_contents, buffers);
   439	  if (forward_status != kTfLiteOk) {
   440	    return forward_status;
   441	  }
   442	
   443	  // Copy forward outputs into the first half of the merged output.
   444	  for (int t = 0; t < time_steps; ++t) {
   445	    std::memcpy(
   446	        output_data + t * (2 * hidden),
   447	        staged_output + t * hidden,
   448	        hidden * sizeof(float));
   449	  }
   450	
   451	  LSTMKernelContents backward_contents{};
   452	  PopulateDirectionContents(context, node, 13, 17, 21, 27, 28, &reversed_input_tensor, &staged_output_tensor, &backward_contents);
   453	
   454	  TfLiteStatus backward_status =
   455	      EvalLstm<float, float, float, float>(
   456	          op_data->backward, backward_contents, buffers);
   457	  if (backward_status != kTfLiteOk) {
   458	    return backward_status;
   459	  }
   460	
   461	  // Restore backward outputs to original time order and copy them
   462	  // into the second half of the merged output.
   463	  for (int t = 0; t < time_steps; ++t) {
   464	    std::memcpy(
   465	        output_data + t * (2 * hidden) + hidden,
   466	        staged_output + (time_steps - 1 - t) * hidden,
   467	        hidden * sizeof(float));
   468	  }
   469	
   470	  return kTfLiteOk;
   471	}
