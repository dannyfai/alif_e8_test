   336	void PopulateDirectionContents(TfLiteContext* context,
   337	                               TfLiteNode* node,
   338	                               int input_weight_base,
   339	                               int recurrent_weight_base,
   340	                               int bias_base,
   341	                               int hidden_state_position,
   342	                               int cell_state_position,
   343	                               const TfLiteEvalTensor* input,
   344	                               TfLiteEvalTensor* staged_output,
   345	                               LSTMKernelContents* contents) {
   346	  for (int i = 0; i < 24; ++i) {
   347	    contents->internal_tensors[i] = nullptr;
   348	  }
   349	
   350	  contents->internal_tensors[0] =
   351	      const_cast<TfLiteEvalTensor*>(input);
   352	
   353	  for (int gate = 0; gate < 4; ++gate) {
   354	    contents->internal_tensors[1 + gate] =
   355	        GetInputEvalTensor(context, node, input_weight_base + gate);
   356	
   357	    contents->internal_tensors[5 + gate] =
   358	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   359	
   360	    contents->internal_tensors[12 + gate] =
   361	        GetInputEvalTensor(context, node, bias_base + gate);
   362	  }
   363	
   364	  // Optional peephole, projection, and layer-normalization tensors
   365	  // are not present in this model and remain nullptr.
   366	
   367	  contents->internal_tensors[18] =
   368	      GetInputEvalTensor(context, node, hidden_state_position);
   369	
   370	  contents->internal_tensors[19] =
   371	      GetInputEvalTensor(context, node, cell_state_position);
   372	
   373	  contents->output_tensor = staged_output;
   374	}
