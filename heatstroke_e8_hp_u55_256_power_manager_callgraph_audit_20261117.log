    98	void power_mgr_log_flush(void)
    99	{
   100	#if CONFIG_LOG_MODE_DEFERRED
   101		log_flush();
   102	#else
   103		while (log_process()) {
   104			k_sleep(K_MSEC(1));
   105		}
   106	#endif
