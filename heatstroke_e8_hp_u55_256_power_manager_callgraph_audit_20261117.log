   110	static int set_off_profile(enum off_state const mode)
   111	{
   112		uint32_t ewic = EWIC_RTC_A;
   113		uint32_t wakeup = WE_LPRTC;
   114	
   115	#if DT_NODE_HAS_STATUS_OKAY(DT_NODELABEL(lpgpio))
   116		ewic |= EWIC_VBAT_GPIO;
   117		wakeup |= WE_LPGPIO;
   118	#endif
   119	
   120		int ret;
   121		off_profile_t offp = {
   122			.power_domains = 0,
   123			.memory_blocks = MEMORY_RETENTION_CONFIG,
   124			.dcdc_voltage = DEFAULT_DCDC_VOLTAGE,
   125			.dcdc_mode = DCDC_MODE_OFF,
   126			.stby_clk_freq = SCALED_FREQ_RC_STDBY_0_075_MHZ,
   127			.aon_clk_src = CLK_SRC_LFXO,
   128			.stby_clk_src = CLK_SRC_HFRC,
   129			.ip_clock_gating = 0,
   130			.phy_pwr_gating = 0,
   131			.ewic_cfg = ewic,
   132			.wakeup_events = wakeup,
   133			.vtor_address = SCB->VTOR,
   134			.vtor_address_ns = SCB->VTOR,
   135		};
   136	
   137		switch (mode) {
   138		case OFF_STATE_IDLE:
   139			return 0;
   140		case OFF_STATE_STANDBY:
   141			offp.power_domains = PD_SSE700_AON_MASK;
   142			offp.stby_clk_freq = SCALED_FREQ_RC_STDBY_76_8_MHZ;
   143			break;
   144		case OFF_STATE_STOP:
   145			break;
   146		case OFF_STATE_OFF:
   147			break;
   148		}
   149	
   150		ret = se_service_set_off_cfg(&offp);
   151		if (ret) {
   152			LOG_ERR("SE: set_off_cfg failed = %d", ret);
   153		}
   154	
   155		return ret;
   156	}
   157	
   158	static int set_run_params(void)
   159	{
   160		run_profile_t runp = {
   161			.power_domains =
   162				(PD_VBAT_AON_MASK | PD_SYST_MASK | PD_SSE700_AON_MASK | PD_SESS_MASK
   163	#if CONFIG_DEBUG || 1
   164				 | PD_DBSS_MASK
   165	#endif
   166				 ),
   167			.aon_clk_src = CLK_SRC_LFXO,
   168			.run_clk_src = CLK_SRC_PLL,
   169			.cpu_clk_freq = CLOCK_FREQUENCY_160MHZ,
   170			.phy_pwr_gating = LDO_PHY_MASK,
   171			.ip_clock_gating = LP_PERIPH_MASK,
   172			.vdd_ioflex_3V3 = IOFLEX_LEVEL_1V8,
   173			.scaled_clk_freq = SCALED_FREQ_RC_ACTIVE_76_8_MHZ,
   174			.dcdc_voltage = DEFAULT_DCDC_VOLTAGE,
   175	#if (IS_ENABLED(CONFIG_SOC_SERIES_E1C) || IS_ENABLED(CONFIG_SOC_SERIES_B1))
   176			.dcdc_mode = DCDC_MODE_PFM_FORCED,
   177			.memory_blocks = MEMORY_RETENTION_CONFIG,
   178	#else
   179			.dcdc_mode = DCDC_MODE_PWM,
   180			.memory_blocks = MEMORY_RETENTION_CONFIG | SRAM0_MASK | SRAM1_MASK,
   181	#endif
   182		};
   183	
   184		se_service_status = se_service_set_run_cfg(&runp);
   185	
   186		if (se_service_status) {
   187			return -ENOEXEC;
   188		}
   189	
   190		/* Default value is 0 so ignore it */
   191	#if CONFIG_ALIF_BLUETOOTH_COMMON_ACLK_DIVIDER_VALUE
   192		se_service_status = se_service_clock_set_divider(
   193			DIVIDER_ACLK, CONFIG_ALIF_BLUETOOTH_COMMON_ACLK_DIVIDER_VALUE);
   194	
   195		if (se_service_status) {
   196			return -ENOEXEC;
   197		}
   198	#endif
   199	
   200		return 0;
   201	}
   202	
   203	static int pre_configure_profiles(void)
   204	{
   205		return set_run_params();
   206	}
   207	
   208	SYS_INIT(pre_configure_profiles, PRE_KERNEL_1, 3);
   209	
   210	/**
   211	 * PM Notifier callback called BEFORE devices are resumed
   212	 *
   213	 * This restores SE run configuration when resuming from S2RAM states.
   214	 * Note: For SOFT_OFF, the system resets completely and set_run_params()
   215	 * runs during normal PRE_KERNEL_1 initialization, so this callback is not needed.
   216	 */
   217	static void pm_notify_pre_device_resume(const enum pm_state state)
   218	{
   219		switch (state) {
   220		case PM_STATE_SUSPEND_TO_IDLE:
   221			/* No action needed */
   222			break;
   223		case PM_STATE_SOFT_OFF:
   224		case PM_STATE_SUSPEND_TO_RAM: {
   225			set_run_params();
   226			break;
   227		}
   228		default: {
   229			__ASSERT(false, "Pre-resume for unknown power state %d", state);
   230			LOG_ERR("Pre-resume for unknown power state %d", state);
   231			break;
   232		}
   233		}
   234	}
   235	
   236	static struct pm_notifier notifier = {
   237		.pre_device_resume = pm_notify_pre_device_resume,
   238	};
   239	
   240	/*
   241	 * This function will be invoked in the PRE_KERNEL_1 phase of the init
   242	 * routine to prevent sleep during startup.
   243	 */
   244	static int app_pre_kernel_init(void)
   245	{
   246		pm_notifier_register(&notifier);
   247	
   248	#if PREKERNEL_DISABLE_SLEEP
   249		power_mgr_disable_sleep();
   250		pm_policy_state_lock_get(PM_STATE_SUSPEND_TO_IDLE, PM_ALL_SUBSTATES);
   251	#endif
   252	
   253		return 0;
   254	}
   255	SYS_INIT(app_pre_kernel_init, PRE_KERNEL_1, 39);
   256	
   257	void print_se_err()
   258	{
   259		if (se_service_status) {
   260			LOG_ERR("SE service failed to initialize earlier. Error: %d", se_service_status);
   261		}
   262	}
   263	
   264	/*
   265	 * Prepare configuration at application initialization
   266	 */
   267	static int prepare_application_config(void)
   268	{
   269		if (se_service_status) {
   270			LOG_ERR("SE service failed to initialize earlier. Error: %d", se_service_status);
   271			return se_service_status;
   272		}
   273	
   274		const struct device *const wakeup_dev = DEVICE_DT_GET(DT_NODELABEL(rtc0));
   275	
   276		if (!device_is_ready(wakeup_dev)) {
   277			LOG_ERR("device '%s' not ready", wakeup_dev->name);
   278			return -1;
   279		}
   280	
   281		int ret = counter_start(wakeup_dev);
   282	
   283		if (ret && ret != -EALREADY) {
   284			LOG_ERR("Counter '%s' start failed!", wakeup_dev->name);
   285			return -1;
   286		}
   287	
   288		ret = set_off_profile(OFF_STATE_STOP);
   289	
   290	#if PREKERNEL_DISABLE_SLEEP
   291		pm_policy_state_lock_put(PM_STATE_SUSPEND_TO_IDLE, PM_ALL_SUBSTATES);
   292	#endif
   293	
   294		return ret;
   295	}
   296	SYS_INIT(prepare_application_config, APPLICATION, 0);

