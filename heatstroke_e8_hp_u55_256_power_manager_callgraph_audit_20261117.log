    32	/**
    33	 * SRAM4 == SRAM0
    34	 * SRAM5 == SRAM1
    35	 *
    36	 * See HWRM Figure 9-1 M55-HE TCM Retention
    37	 *
    38	 * MB_SRAM4_1 : M55-HE ITCM RET1 itcm 64kb
    39	 * MB_SRAM4_2 : M55-HE ITCM RET2 itcm 64kb
    40	 * MB_SRAM4_3 : M55-HE ITCM RET3 itcm 128kb
    41	 * MB_SRAM4_4 : M55-HE ITCM RET4 itcm 256kb
    42	 * MB_SRAM5_1 : M55-HE DTCM RET1 dtcm 64kb
    43	 * MB_SRAM5_2 : M55-HE DTCM RET2 dtcm 64kb
    44	 * MB_SRAM5_3 : M55-HE DTCM RET3 dtcm 128kb
    45	 * MB_SRAM5_4 : M55-HE DTCM RET4 dtcm 256kb
    46	 * MB_SRAM5_5 : M55-HE DTCM RET5 dtcm 1024kb
    47	 */
    48	
    49	#define RET_A1 SRAM4_1_MASK
    50	#define RET_A2 SRAM5_1_MASK
    51	#define RET_B  (SRAM4_2_MASK | SRAM5_2_MASK)
    52	#if (IS_ENABLED(CONFIG_SOC_SERIES_E1C) || IS_ENABLED(CONFIG_SOC_SERIES_B1))
    53	#define RET_C (SRAM4_3_MASK | SRAM5_3_MASK)
    54	#define RET_D (SRAM4_4_MASK | SRAM5_4_MASK)
    55	#define RET_E (SRAM5_5_MASK)
    56	
    57	#define MEMORY_RETENTION_CONFIG                                                                    \
    58		(((CONFIG_FLASH_BASE_ADDRESS == 0) ? 0 : MRAM_MASK) | RET_A1 | RET_A2 | RET_B | RET_C |    \
    59		 RET_D | RET_E | SERAM_MASK)
    60	
    61	#elif defined(CONFIG_ENSEMBLE_GEN2)
    62	#define MEMORY_RETENTION_CONFIG                                                                    \
    63		(((CONFIG_FLASH_BASE_ADDRESS == 0) ? 0 : MRAM_MASK) | RET_A1 | RET_A2 | RET_B |            \
    64		 SERAM_MASK | SRAM0_1_RET_MASK | SRAM0_2_RET_MASK | SRAM0_3_RET_MASK | SRAM0_4_RET_MASK)
    65	#else
    66	#define MEMORY_RETENTION_CONFIG                                                                    \
    67		(((CONFIG_FLASH_BASE_ADDRESS == 0) ? 0 : MRAM_MASK) | RET_A1 | RET_A2 | RET_B | SERAM_MASK)
    68	#endif
