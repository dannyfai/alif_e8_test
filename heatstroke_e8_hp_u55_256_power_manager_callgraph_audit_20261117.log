		rtc0: lprtc@42000000 {
			compatible = "snps,dw-apb-rtc";
			reg = < 0x42000000 0x1000 >;
			interrupts = < 0x3a 0x0 >;
			clock-frequency = < 0x8000 >;
			prescaler = < 0x0 >;
			load-value = < 0x0 >;
			status = "disabled";
		};
		sdhc: sdhc@48102000 {
			compatible = "snps,dwc-sdhc";
			reg = < 0x48102000 0xf70 >;
			interrupt-parent = < &nvic >;
			interrupts = < 0x66 0x0 >, < 0x67 0x0 >;
			interrupt-names = "sdmmc", "sdmmc_wakeup";
			max-bus-freq = < 0x2faf080 >;
			min-bus-freq = < 0x61a80 >;
			power-delay-ms = < 0x1f4 >;
			pinctrl-0 = < &pinctrl_sdmmc >;
			pinctrl-names = "default";
			cd-gpios = < &gpio3 0x3 0x1 >;
			status = "disabled";
			vmmc-supply = < &sd_pwr >;
			vqmmc-supply = < &sd_vsel >;
			mmc {
				compatible = "zephyr,sdmmc-disk";
				bus-width = < 0x4 >;
				status = "disabled";
			};
		};
