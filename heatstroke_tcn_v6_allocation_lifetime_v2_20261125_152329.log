  106: TfLiteStatus CreatePlan(MicroMemoryPlanner* planner,
  107:                         const AllocationInfo* allocation_info,
  108:                         size_t allocation_info_size) {
  109:   // Add the tensors to our allocation plan.
  110:   for (size_t i = 0; i < allocation_info_size; ++i) {
  111:     const AllocationInfo* current = &allocation_info[i];
  112:     if (current->needs_allocating) {
  113:       size_t aligned_bytes_required =
  114:           AlignSizeUp(current->bytes, MicroArenaBufferAlignment());
  115:       if (current->offline_offset == kOnlinePlannedBuffer) {
  116:         TF_LITE_ENSURE_STATUS(planner->AddBuffer(aligned_bytes_required,
  117:                                                  current->first_created,
  118:                                                  current->last_used));
  119:       } else {
  120:         TF_LITE_ENSURE_STATUS(
  121:             planner->AddBuffer(aligned_bytes_required, current->first_created,
  122:                                current->last_used, current->offline_offset));
  123:       }
  124:     }
  125:   }
  126:   return kTfLiteOk;
  127: }
  128: 
  129: TfLiteStatus CommitPlan(MicroMemoryPlanner* planner, uint8_t* starting_point,
  130:                         const AllocationInfo* allocation_info,
  131:                         size_t allocation_info_size) {
  132:   // Figure out the actual memory addresses for each buffer, based on the plan.
  133:   int planner_index = 0;
  134:   for (size_t i = 0; i < allocation_info_size; ++i) {
  135:     const AllocationInfo* current = &allocation_info[i];
  136:     if (current->needs_allocating) {
  137:       int offset = -1;
  138:       TF_LITE_ENSURE_STATUS(
  139:           planner->GetOffsetForBuffer(planner_index, &offset));
  140:       *current->output_ptr = reinterpret_cast<void*>(starting_point + offset);
  141:       ++planner_index;
  142:     }
  143:   }
  144:   return kTfLiteOk;
