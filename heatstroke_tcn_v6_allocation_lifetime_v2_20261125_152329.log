   166	  need_to_calculate_offsets_ = false;
   167	
   168	  // Start off by ordering the buffers in descending order of size.
   169	  // This helps find a more compact layout. Intuitively, you can think
   170	  // about putting the large buffers in place first, and then the
   171	  // smaller buffers can fit in the gaps, rather than fragmenting the
   172	  // gaps with small buffers at the beginning. Add offline planned offsets
   173	  // first in the list, since they have a predetermined offset.
   174	  int idx_from_tail = buffer_count_;
   175	  int idx_from_head = 0;
   176	  for (int i = 0; i < buffer_count_; ++i) {
   177	    if (requirements_[i].offline_offset == kOnlinePlannedBuffer) {
   178	      idx_from_tail--;
   179	      buffer_sizes_sorted_[idx_from_tail] = requirements_[i].size;
   180	      buffer_ids_sorted_[idx_from_tail] = i;
   181	      buffer_offsets_[i] = -1;
   182	    } else {
   183	      buffer_sizes_sorted_[idx_from_head] = requirements_[i].size;
   184	      buffer_ids_sorted_[idx_from_head] = i;
   185	      buffer_offsets_[i] = requirements_[i].offline_offset;
   186	      idx_from_head++;
   187	    }
   188	  }
   189	
   190	  // This sorting algorithm is naive, and may end up taking a very long time
   191	  // with hundreds of buffers. Do not sort the offline planned offsets.
   192	  ReverseSortInPlace(&buffer_sizes_sorted_[idx_from_head],
   193	                     &buffer_ids_sorted_[idx_from_head],
   194	                     buffer_count_ - idx_from_head);
   195	
   196	  // Initialize the first entry to the first buffer in
   197	  // buffer_ids_sorted_.
   198	  //   - If there are no offline planned offsets, the largest buffer will be
   199	  //     first, and the buffers will be handled in size order.
   200	  //   - If offline offsets are present, these will be handled first in order
   201	  //     for the greedy algorithm to utilized gaps in the offline plan.
   202	  first_entry_index_ = 0;
   203	  next_free_entry_ = 1;
   204	  ListEntry* first_entry = &buffers_sorted_by_offset_[first_entry_index_];
   205	  first_entry->next_entry_index = -1;  // to mark the entry as end of list
   206	  int buffer_id = buffer_ids_sorted_[0];
   207	  first_entry->requirements_index = buffer_id;
   208	  if (requirements_[buffer_id].offline_offset == kOnlinePlannedBuffer) {
   209	    buffer_offsets_[buffer_id] = 0;
   210	  }
   211	  first_entry->offset = buffer_offsets_[buffer_id];
   212	
   213	  // Work through the rest of the buffers to find a good gap to place each one.
   214	  for (int i = 1; i < buffer_count_; ++i) {
   215	    // The id is the order the buffer was originally added by the client.
   216	    buffer_id = buffer_ids_sorted_[i];
   217	    // Look at what size and time range the buffer needs to be active.
   218	    BufferRequirements* wanted_requirements = &requirements_[buffer_id];
   219	    const int wanted_size = wanted_requirements->size;
   220	    const int wanted_first_time_used = wanted_requirements->first_time_used;
   221	    const int wanted_last_time_used = wanted_requirements->last_time_used;
   222	
   223	    // Find the first buffer that's active in our time range. All placed
   224	    // buffers are stored in the order of their starting position in the arena
   225	    // so that it's easy to find the next buffer in memory, and so the gap.
   226	    // The candidate_entry variable holds the buffer that we're considering
   227	    // placing the current buffer after.
   228	
   229	    int candidate_offset = 0;
   230	    // Loop through the offset-ordered list of buffers, looking for gaps.
   231	    if (wanted_requirements->offline_offset == kOnlinePlannedBuffer) {
   232	      ListEntry* prior_entry = nullptr;
   233	      while (true) {
   234	        // Find out what the next active buffer is.
   235	        ListEntry* next_entry = NextSimultaneouslyActiveBuffer(
   236	            prior_entry, wanted_first_time_used, wanted_last_time_used);
   237	
   238	        if (prior_entry) {
   239	          BufferRequirements* candidate_requirements =
   240	              &requirements_[prior_entry->requirements_index];
   241	          const int prior_entry_offset =
   242	              prior_entry->offset + candidate_requirements->size;
   243	          if (prior_entry_offset > candidate_offset) {
   244	            candidate_offset = prior_entry_offset;
   245	          }
   246	        }
   247	        if (next_entry == nullptr) {
   248	          // We're at the end of the list, so we can always append the buffer
   249	          // here.
   250	          break;
   251	        }
   252	        // Find out how much space there is between us and the next buffer.
   253	        const int gap = next_entry->offset - candidate_offset;
   254	        if (gap >= wanted_size) {
   255	          // This entry has a big enough gap between it and the next, so
   256	          // use it!
   257	          break;
   258	        }
   259	        // The gap wasn't big enough, so move on to another candidate.
   260	        prior_entry = next_entry;
   261	      }
   262	    } else {
   263	      // Offline planned offset are to be considered constant
   264	      candidate_offset = wanted_requirements->offline_offset;
   265	    }
   266	    // At this point, we've either found a gap (possibly at the end of the
   267	    // list) and want to place the buffer there, or there are no other active
   268	    // buffers in this time range and so we can put it at offset zero.
   269	    // Record the buffer's offset in our plan.
   270	    buffer_offsets_[buffer_id] = candidate_offset;
   271	    // Add the newly-placed buffer to our offset-ordered list, so that
   272	    // subsequent passes can fit in their buffers around it.
   273	    ListEntry* new_entry = &buffers_sorted_by_offset_[next_free_entry_];
   274	    new_entry->offset = candidate_offset;
   275	    new_entry->requirements_index = buffer_id;
   276	    const int new_entry_index = next_free_entry_;
   277	    ++next_free_entry_;
   278	
   279	    if (first_entry->offset > candidate_offset) {
   280	      // The new entry offset is smaller than the first entry offset =>
   281	      // replace the first entry
   282	      first_entry = new_entry;
   283	      first_entry->next_entry_index = first_entry_index_;
   284	      first_entry_index_ = new_entry_index;
   285	    } else {
   286	      ListEntry* current_entry = first_entry;
   287	      // Make sure that we insert the buffer at the correct place in the
   288	      // buffer-offset-ordered list
   289	      while (true) {
   290	        const int next_entry_index = current_entry->next_entry_index;
   291	        if (next_entry_index == -1) {
   292	          // We're at the end of the list, so just add the new entry here.
   293	          current_entry->next_entry_index = new_entry_index;
   294	          new_entry->next_entry_index = -1;
   295	          break;
   296	        }
   297	        // not at the end of the list -> take a look at next entry
   298	        ListEntry* next_entry = &buffers_sorted_by_offset_[next_entry_index];
   299	        if (next_entry->offset > candidate_offset) {
   300	          // We're at the right spot to do an insertion and retain the sorting
   301	          // order, so place the new entry here.
   302	          new_entry->next_entry_index = current_entry->next_entry_index;
   303	          current_entry->next_entry_index = new_entry_index;
   304	          break;
   305	        }
   306	        current_entry = next_entry;
   307	      }
   308	    }
   309	  }
   310	}

