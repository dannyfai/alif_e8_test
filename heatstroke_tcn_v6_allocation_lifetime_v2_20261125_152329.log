    88	GreedyMemoryPlanner::~GreedyMemoryPlanner() {
    89	  // We don't own the scratch buffer, so don't deallocate anything.
    90	}
    91	
    92	TfLiteStatus GreedyMemoryPlanner::AddBuffer(int size, int first_time_used,
    93	                                            int last_time_used) {
    94	  if (buffer_count_ >= max_buffer_count_) {
    95	    MicroPrintf("Too many buffers (max is %d)", max_buffer_count_);
    96	    return kTfLiteError;
    97	  }
    98	  BufferRequirements* current = &requirements_[buffer_count_];
    99	  current->size = size;
   100	  current->first_time_used = first_time_used;
   101	  current->last_time_used = last_time_used;
   102	  current->offline_offset = kOnlinePlannedBuffer;
   103	  ++buffer_count_;
   104	  need_to_calculate_offsets_ = true;
   105	  return kTfLiteOk;
   106	}
   107	
   108	TfLiteStatus GreedyMemoryPlanner::AddBuffer(int size, int first_time_used,
   109	                                            int last_time_used,
   110	                                            int offline_offset) {
   111	  BufferRequirements* current = &requirements_[buffer_count_];
   112	  if (AddBuffer(size, first_time_used, last_time_used) != kTfLiteOk) {
   113	    return kTfLiteError;
   114	  }
   115	  current->offline_offset = offline_offset;
   116	  return kTfLiteOk;
   117	}
   118	
   119	bool GreedyMemoryPlanner::DoesEntryOverlapInTime(
   120	    const GreedyMemoryPlanner::ListEntry* entry, const int first_time_used,
   121	    const int last_time_used) const {
   122	  const BufferRequirements* entry_requirements =
   123	      &requirements_[entry->requirements_index];
   124	  if (entry_requirements->first_time_used > last_time_used) {
   125	    return false;
   126	  }
   127	  if (first_time_used > entry_requirements->last_time_used) {
   128	    return false;
   129	  }
   130	  return true;
   131	}
   132	
   133	GreedyMemoryPlanner::ListEntry*
   134	GreedyMemoryPlanner::NextSimultaneouslyActiveBuffer(
   135	    const GreedyMemoryPlanner::ListEntry* start, const int first_time_used,
   136	    const int last_time_used) {
   137	  ListEntry* result = nullptr;
   138	  ListEntry* candidate_next_entry;
   139	  if (start == nullptr) {
   140	    candidate_next_entry = &buffers_sorted_by_offset_[first_entry_index_];
   141	  } else {
   142	    if (start->next_entry_index == -1) {
   143	      return nullptr;
   144	    }
   145	    candidate_next_entry = &buffers_sorted_by_offset_[start->next_entry_index];
   146	  }
   147	  do {
   148	    if (DoesEntryOverlapInTime(candidate_next_entry, first_time_used,
   149	                               last_time_used)) {
   150	      result = candidate_next_entry;
   151	      break;
   152	    }
   153	    if (candidate_next_entry->next_entry_index == -1) {
   154	      break;
   155	    }
   156	    candidate_next_entry =
   157	        &buffers_sorted_by_offset_[candidate_next_entry->next_entry_index];
   158	  } while (true);
   159	  return result;
   160	}
