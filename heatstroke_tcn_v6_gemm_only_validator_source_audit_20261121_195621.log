    56	def compare(reference, candidate, atol, rtol):
    57	    delta = np.abs(reference - candidate)
    58	    return {
    59	        "max_abs_error": float(delta.max()),
    60	        "mean_abs_error": float(delta.mean()),
    61	        "rmse": float(np.sqrt(np.mean(np.square(reference - candidate)))),
    62	        "allclose": bool(
    63	            np.allclose(reference, candidate, atol=atol, rtol=rtol)
    64	        ),
    65	        "finite": bool(np.isfinite(candidate).all()),
    66	    }
