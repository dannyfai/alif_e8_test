    25	def sha256(path):
    26	    h = hashlib.sha256()
    27	    with open(path, "rb") as f:
    28	        for chunk in iter(lambda: f.read(1024 * 1024), b""):
    29	            h.update(chunk)
    30	    return h.hexdigest()
    31	
    32	
    33	def import_module(path, name):
    34	    spec = importlib.util.spec_from_file_location(name, str(path))
    35	    if spec is None or spec.loader is None:
    36	        raise RuntimeError(f"Cannot import {path}")
    37	    module = importlib.util.module_from_spec(spec)
    38	    spec.loader.exec_module(module)
    39	    return module
