    42	def resolve_input(details, key):
    43	    matches = [
    44	        d for d in details
    45	        if key.lower() in d["name"].lower()
    46	    ]
    47	    if len(matches) != 1:
    48	        raise RuntimeError(
    49	            f"Cannot uniquely identify TFLite input '{key}'. "
    50	            f"Matches={[x['name'] for x in matches]}; "
    51	            f"all_inputs={[x['name'] for x in details]}"
    52	        )
    53	    return matches[0]
    54	
