   166	void* HeatstrokeBidirectionalLstmInit(TfLiteContext* context,
   167	                                      const char* buffer,
   168	                                      size_t length) {
   169	  (void)buffer;
   170	  (void)length;
   171	
   172	  auto* data = static_cast<HeatstrokeBidirectionalLstmOpData*>(
   173	      context->AllocatePersistentBuffer(
   174	          context, sizeof(HeatstrokeBidirectionalLstmOpData)));
   175	
   176	  if (data != nullptr) {
   177	    std::memset(data, 0, sizeof(*data));
   178	  }
   179	  return data;
   180	}
   181	
   182	TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
   183	                                                TfLiteNode* node) {
   184	  if (node == nullptr || node->builtin_data == nullptr ||
   185	      node->inputs == nullptr || node->outputs == nullptr ||
   186	      node->inputs->size != 29 || node->outputs->size != 1 ||
   187	      node->user_data == nullptr) {
   188	    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
   189	    return kTfLiteError;
   190	  }
   191	
   192	  auto* op_data =
   193	      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   194	
   195	  const auto* params =
   196	      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
   197	          node->builtin_data);
   198	
   199	  if (!params->time_major || !params->merge_outputs ||
   200	      params->activation != kTfLiteActTanh) {
   201	    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
   202	    return kTfLiteError;
   203	  }
   204	
   205	  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
   206	  TfLiteEvalTensor* output =
   207	      context->GetEvalTensor(context, node->outputs->data[0]);
   208	
   209	  const int input_type = input != nullptr ? static_cast<int>(input->type) : -1;
   210	  const int output_type = output != nullptr ? static_cast<int>(output->type) : -1;
   211	  const int input_rank = (input != nullptr && input->dims != nullptr)
   212	                             ? input->dims->size : -1;
   213	  const int output_rank = (output != nullptr && output->dims != nullptr)
   214	                              ? output->dims->size : -1;
   215	
   216	  MicroPrintf(
   217	      "Heatstroke BiLSTM input: index=%d type=%d rank=%d dims=%d,%d,%d,%d",
   218	      node->inputs->data[0], input_type, input_rank,
   219	      input_rank > 0 ? input->dims->data[0] : -1,
   220	      input_rank > 1 ? input->dims->data[1] : -1,
   221	      input_rank > 2 ? input->dims->data[2] : -1,
   222	      input_rank > 3 ? input->dims->data[3] : -1);
   223	
   224	  MicroPrintf(
   225	      "Heatstroke BiLSTM output: index=%d type=%d rank=%d dims=%d,%d,%d,%d",
   226	      node->outputs->data[0], output_type, output_rank,
   227	      output_rank > 0 ? output->dims->data[0] : -1,
   228	      output_rank > 1 ? output->dims->data[1] : -1,
   229	      output_rank > 2 ? output->dims->data[2] : -1,
   230	      output_rank > 3 ? output->dims->data[3] : -1);
   231	
   232	  if (!IsFloatTensorType(input) || !IsFloatTensorType(output) ||
   233	      input->dims == nullptr || output->dims == nullptr ||
   234	      input->dims->size != 3 ||
   235	      (output->dims->size != 3 && output->dims->size != 4)) {
   236	    MicroPrintf(
   237	        "Heatstroke BiLSTM: expected FP32 input rank 3 and output rank 3 or 4");
   238	    return kTfLiteError;
   239	  }
   240	
   241	  const int time_steps = input->dims->data[0];
   242	  const int batch_size = input->dims->data[1];
   243	  const int input_dimension = input->dims->data[2];
   244	
   245	  // The supplied heat-stress model uses time-major, single-batch sequences.
   246	  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
   247	    MicroPrintf("Heatstroke BiLSTM: unsupported input dimensions");
   248	    return kTfLiteError;
   249	  }
   250	
   251	  int forward_hidden = 0;
   252	  int backward_hidden = 0;
   253	
   254	  if (!ValidateDirection(context, node, 1, 5, 9, 25, 26, input_dimension, batch_size, &forward_hidden) ||
   255	      !ValidateDirection(context, node, 13, 17, 21, 27, 28, input_dimension, batch_size, &backward_hidden) ||
   256	      forward_hidden != backward_hidden) {
   257	    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
   258	    return kTfLiteError;
   259	  }
   260	
   261	  const int hidden = forward_hidden;
   262	
   263	  const bool output_shape_valid =
   264	      output->dims->data[0] == time_steps &&
   265	      output->dims->data[1] == batch_size &&
   266	      ((output->dims->size == 3 &&
   267	        output->dims->data[2] == 2 * hidden) ||
   268	       (output->dims->size == 4 &&
   269	        output->dims->data[2] == 2 &&
   270	        output->dims->data[3] == hidden));
   271	
   272	  if (!output_shape_valid) {
   273	    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
   274	    return kTfLiteError;
   275	  }
   276	
   277	  // The directional evaluator must see [time_steps, batch_size, hidden],
   278	  // not the merged output shape [time_steps, batch_size, 2 * hidden].
   279	  const size_t staged_dims_bytes =
   280	      sizeof(TfLiteIntArray) + 2 * sizeof(int);
   281	  op_data->staged_output_dims =
   282	      static_cast<TfLiteIntArray*>(
   283	          context->AllocatePersistentBuffer(context, staged_dims_bytes));
   284	
   285	  if (op_data->staged_output_dims == nullptr) {
   286	    MicroPrintf("Heatstroke BiLSTM: output dimensions allocation failed");
   287	    return kTfLiteError;
   288	  }
   289	
   290	  op_data->staged_output_dims->size = 3;
   291	  op_data->staged_output_dims->data[0] = time_steps;
   292	  op_data->staged_output_dims->data[1] = batch_size;
   293	  op_data->staged_output_dims->data[2] = hidden;
   294	
   295	  // Compact 29-slot model: no separate auxiliary input slots exist.
   296	
   297	  InitializeFloatLstmParameters(
   298	      &op_data->forward, true, batch_size, time_steps,
   299	      input_dimension, hidden, params->activation, params->cell_clip);
   300	
   301	  InitializeFloatLstmParameters(
   302	      &op_data->backward, true, batch_size, time_steps,
   303	      input_dimension, hidden, params->activation, params->cell_clip);
   304	
   305	  const size_t reverse_bytes =
   306	      static_cast<size_t>(time_steps) * batch_size *
   307	      input_dimension * sizeof(float);
   308	
   309	  const size_t stage_bytes =
   310	      static_cast<size_t>(time_steps) * batch_size *
   311	      hidden * sizeof(float);
   312	
   313	  const size_t internal_bytes =
   314	      static_cast<size_t>(batch_size) * hidden * sizeof(float);
   315	
   316	  if (context->RequestScratchBufferInArena(
   317	          context, reverse_bytes, &op_data->reverse_input_buffer) !=
   318	          kTfLiteOk ||
   319	      context->RequestScratchBufferInArena(
   320	          context, stage_bytes, &op_data->stage_output_buffer) !=
   321	          kTfLiteOk) {
   322	    MicroPrintf("Heatstroke BiLSTM: scratch allocation failed");
   323	    return kTfLiteError;
   324	  }
   325	
   326	  // Match the four scratch buffers requested by TFLM's existing
   327	  // unidirectional FP32 LSTM implementation.
   328	  for (int i = 0; i < 4; ++i) {
   329	    if (context->RequestScratchBufferInArena(
   330	            context, internal_bytes,
   331	            &op_data->forward.buffer_indices[i]) != kTfLiteOk) {
   332	      MicroPrintf("Heatstroke BiLSTM: LSTM scratch allocation failed");
   333	      return kTfLiteError;
   334	    }
   335	
   336	    // Forward and backward passes execute sequentially, so they can
   337	    // safely reuse the same four evaluator scratch buffers.
   338	    op_data->backward.buffer_indices[i] =
   339	        op_data->forward.buffer_indices[i];
   340	  }
   341	
   342	  return kTfLiteOk;
   343	}
   344	
   345	void PopulateDirectionContents(TfLiteContext* context,
   346	                               TfLiteNode* node,
   347	                               int input_weight_base,
   348	                               int recurrent_weight_base,
   349	                               int bias_base,
   350	                               int hidden_state_position,
   351	                               int cell_state_position,
   352	                               const TfLiteEvalTensor* input,
   353	                               TfLiteEvalTensor* staged_output,
   354	                               LSTMKernelContents* contents) {
   355	  for (int i = 0; i < 24; ++i) {
   356	    contents->internal_tensors[i] = nullptr;
   357	  }
   358	
   359	  contents->internal_tensors[0] =
   360	      const_cast<TfLiteEvalTensor*>(input);
   361	
   362	  for (int gate = 0; gate < 4; ++gate) {
   363	    contents->internal_tensors[1 + gate] =
   364	        GetInputEvalTensor(context, node, input_weight_base + gate);
   365	
   366	    contents->internal_tensors[5 + gate] =
   367	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   368	
   369	    contents->internal_tensors[12 + gate] =
   370	        GetInputEvalTensor(context, node, bias_base + gate);
   371	  }
   372	
   373	  // Optional peephole, projection, and layer-normalization tensors
   374	  // are not present in this model and remain nullptr.
   375	
   376	  contents->internal_tensors[18] =
   377	      GetInputEvalTensor(context, node, hidden_state_position);
   378	
   379	  contents->internal_tensors[19] =
   380	      GetInputEvalTensor(context, node, cell_state_position);
   381	
   382	  contents->output_tensor = staged_output;
   383	}
   384	
   385	TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
