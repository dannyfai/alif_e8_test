    25	##############################################################################
    26	function(generate_images_code input_dir gen_dir img_size)
    27	
    28	    # Absolute paths for passing into python script
    29	    get_filename_component(input_dir_abs ${input_dir} ABSOLUTE)
    30	    get_filename_component(gen_out_abs ${gen_dir} ABSOLUTE)
    31	
