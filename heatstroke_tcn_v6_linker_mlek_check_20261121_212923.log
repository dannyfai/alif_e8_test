    18	if (NOT CONFIG_MLEK_EXAMPLES_LIB)
    19	    return()
    20	endif()
    21	
    22	project(MLEK_API_ZEPHYR_PORT
    23	    DESCRIPTION "MLEK platform agnostic API port for Zephyr"
    24	    LANGUAGES   CXX
    25	    VERSION     0.1.0)
    26	
    27	macro(mlek_config_err dependency)
    28	    message(FATAL_ERROR "To use MLEK examples, ${dependency} must be enabled"
    29	                        "in Zephyr configuration")
    30	endmacro()
    31	
    32	if (NOT CONFIG_CMSIS_DSP)
    33	    mlek_config_err(CONFIG_CMSIS_DSP)
    34	endif()
    35	
    36	if (TARGET modules__cmsis-dsp)
    37	    add_library(arm::cmsis-dsp ALIAS modules__cmsis-dsp)
    38	else()
    39	    message(FATAL_ERROR "Target modules__cmsis-dsp not found.")
    40	endif()
    41	
    42	if (CONFIG_MLEK_EXAMPLES_FWK_EXECUTORCH)
    43	    set(ML_FRAMEWORK "ExecuTorch")
    44	    if (NOT CONFIG_EXECUTORCH)
    45	        mlek_config_err(CONFIG_EXECUTORCH)
    46	    endif()
    47	
    48	    # The Zephyr ExecuTorch module names its library target explicitly with
    49	    # zephyr_library_named(libexecutorch), so the default "modules__executorch"
    50	    # target does not exist. Support both names for robustness.
    51	    if (TARGET libexecutorch)
    52	        add_library(meta::executorch ALIAS libexecutorch)
    53	    elseif (TARGET modules__executorch)
    54	        add_library(meta::executorch ALIAS modules__executorch)
    55	    else()
    56	        message(FATAL_ERROR "Neither target 'libexecutorch' nor 'modules__executorch' found.")
    57	    endif()
    58	elseif (CONFIG_MLEK_EXAMPLES_FWK_TFLM)
    59	    set(ML_FRAMEWORK "TensorFlowLiteMicro")
    60	    if (NOT CONFIG_TENSORFLOW_LITE_MICRO)
    61	        mlek_config_err(CONFIG_TENSORFLOW_LITE_MICRO)
    62	    endif()
    63	
    64	    if (TARGET modules__tflite-micro)
    65	        add_library(google::tensorflow-lite-micro ALIAS modules__tflite-micro)
    66	    else()
    67	        message(FATAL_ERROR "Target modules__tflite-micro not found.")
    68	    endif()
    69	else()
    70	    message(FATAL_ERROR "No ML framework enabled for MLEK to use in the config.")
    71	endif()
    72	
    73	set(MLEK_LOG_ENABLE ${CONFIG_MLEK_EXAMPLES_LOG_ENABLE} CACHE BOOL "Enable MLEK log")
    74	
    75	# If logging has been enabled.
    76	if (CONFIG_MLEK_EXAMPLES_LOG_ENABLE)
    77	    if (CONFIG_MLEK_EXAMPLES_LOG_LEVEL_TRACE)
    78	        set(_MLEK_LOG_LEVEL MLEK_LOG_LEVEL_TRACE)
    79	    elseif (CONFIG_MLEK_EXAMPLES_LOG_LEVEL_DEBUG)
    80	        set(_MLEK_LOG_LEVEL MLEK_LOG_LEVEL_DEBUG)
    81	    elseif (CONFIG_MLEK_EXAMPLES_LOG_LEVEL_INFO)
    82	        set(_MLEK_LOG_LEVEL MLEK_LOG_LEVEL_INFO)
    83	    elseif (CONFIG_MLEK_EXAMPLES_LOG_LEVEL_WARN)
    84	        set(_MLEK_LOG_LEVEL MLEK_LOG_LEVEL_WARN)
    85	    elseif (CONFIG_MLEK_EXAMPLES_LOG_LEVEL_ERROR)
    86	        set(_MLEK_LOG_LEVEL MLEK_LOG_LEVEL_ERROR)
    87	    else()
    88	        message(FATAL_ERROR "Unknown MLEK log level configuration.")
    89	    endif()
    90	    set(MLEK_LOG_LEVEL ${_MLEK_LOG_LEVEL} CACHE STRING "MLEK log level")
    91	endif()
    92	
    93	add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../../ ${CMAKE_CURRENT_BINARY_DIR}/mlek)

