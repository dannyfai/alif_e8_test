   140	##############################################################################
   141	# This function generates C++ file for a given labels' text file.
   142	# @param[in]    INPUT          Path to the label text file
   143	# @param[in]    DESTINATION_SRC directory in which the output cc must be
   144	#                               placed
   145	# @param[in]    DESTINATION_HDR directory in which the output h file must be
   146	#                               placed
   147	# @param[in]    OUTPUT_FILENAME    Path to required output file
   148	# @param[in]    NAMESPACE       data name space
   149	# NOTE: Uses python
   150	##############################################################################
   151	function(generate_labels_code)
   152	
   153	    set(multiValueArgs NAMESPACE)
   154	    set(oneValueArgs INPUT DESTINATION_SRC DESTINATION_HDR OUTPUT_FILENAME)
   155	    cmake_parse_arguments(PARSED "" "${oneValueArgs}" "${multiValueArgs}" ${ARGN} )
   156	
   157	    # Absolute paths for passing into python script
   158	    get_filename_component(input_abs ${PARSED_INPUT} ABSOLUTE)
   159	    get_filename_component(src_out_abs ${PARSED_DESTINATION_SRC} ABSOLUTE)
   160	    get_filename_component(hdr_out_abs ${PARSED_DESTINATION_HDR} ABSOLUTE)
   161	
   162	    message(STATUS "Generating labels file from ${PARSED_INPUT}")
   163	    file(REMOVE "${hdr_out_abs}/${PARSED_OUTPUT_FILENAME}.hpp")
   164	    file(REMOVE "${src_out_abs}/${PARSED_OUTPUT_FILENAME}.cc")
   165	
   166	    foreach(name ${PARSED_NAMESPACE})
   167	        set(py_arg_exp ${py_arg_exp} --namespaces=${name})
   168	    endforeach()
   169	
   170	    message(STATUS "writing to ${hdr_out_abs}/${PARSED_OUTPUT_FILENAME}.hpp and ${src_out_abs}/${PARSED_OUTPUT_FILENAME}.cc")
   171	    execute_process(
   172	        COMMAND ${CMAKE_COMMAND} -E env
   173	            PYTHONPATH=${MLEK_SCRIPTS_DIR}/py:$ENV{PYTHONPATH}
   174	            ${PYTHON} -m mlek_tools.gen.gen_labels_cpp
   175	            --labels_file ${input_abs}
   176	            --source_folder_path ${src_out_abs}
   177	            --header_folder_path ${hdr_out_abs}
   178	            --output_file_name ${PARSED_OUTPUT_FILENAME} ${py_arg_exp}
   179	        RESULT_VARIABLE return_code
   180	    )
   181	    if (NOT return_code EQUAL "0")
   182	        message(FATAL_ERROR "Failed to generate label files.")
   183	    endif ()
   184	endfunction()
